local function activateFirstTab()
	if #tabDefinitions > 0 then
		local first = tabDefinitions[1]
		local tab = Tabs[first.id]
		if tab then
			tab.btn.BackgroundColor3 = CONFIG.Theme.Card
			tab.indicator.Size = UDim2.new(0, 3, 0, 18)
			tab.label.TextColor3 = CONFIG.Theme.TextPrimary
			tab.container.Visible = true
			tab.container.GroupTransparency = 0
			State.ActiveTab = first.id
		end
	end
end

