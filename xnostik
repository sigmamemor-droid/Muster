-- ===== Вспомогательные функции =====

local function new(className, properties)
\tlocal object = Instance.new(className)

\tfor property, value in pairs(properties or {}) do
\t\tobject[property] = value
\tend

\treturn object
end

local function addCorner(parent, radius)
\treturn new("UICorner", {
\t\tCornerRadius = UDim.new(0, radius),
\t\tParent = parent,
\t})
end

local function addStroke(parent, color, transparency, thickness)
\treturn new("UIStroke", {
\t\tColor = color or COLORS.Stroke,
\t\tTransparency = transparency or 0,
\t\tThickness = thickness or 1,
\t\tParent = parent,
\t})
end

local function addPadding(parent, left, right, top, bottom)
\treturn new("UIPadding", {
\t\tPaddingLeft = UDim.new(0, left or 0),
\t\tPaddingRight = UDim.new(0, right or 0),
\t\tPaddingTop = UDim.new(0, top or 0),
\t\tPaddingBottom = UDim.new(0, bottom or 0),
\t\tParent = parent,
\t})
end

local function tween(object, properties, duration, style, direction)
\tlocal info = TweenInfo.new(
\t\tduration or SETTINGS.AnimationDuration,
\t\tstyle or Enum.EasingStyle.Quart,
\t\tdirection or Enum.EasingDirection.Out
\t)

\tlocal animation = TweenService:Create(object, info, properties)
\tanimation:Play()

\treturn animation
end

local function makeResponsive(frame, minSize)
\tlocal constraint = new("UISizeConstraint", {
\t\tMinSize = minSize or Vector2.new(360, 260),
\t\tMaxSize = Vector2.new(SETTINGS.MenuWidth, SETTINGS.MenuHeight),
\t\tParent = frame,
\t})

\treturn constraint
end

