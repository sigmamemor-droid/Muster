local function createToggle(page, key, title, description, defaultValue, callback)
\tlocal card = createCard(page, title, description)
\tlocal enabled = state[key]

\tif enabled == nil then
\t\tenabled = defaultValue == true
\t\tstate[key] = enabled
\tend

\tlocal toggle = new("TextButton", {
\t\tName = "Toggle",
\t\tAnchorPoint = Vector2.new(1, 0.5),
\t\tPosition = UDim2.new(1, -16, 0.5, 0),
\t\tSize = UDim2.fromOffset(44, 25),
\t\tBackgroundColor3 = enabled and COLORS.Accent or COLORS.ToggleOff,
\t\tBorderSizePixel = 0,
\t\tText = "",
\t\tAutoButtonColor = false,
\t\tZIndex = 10,
\t\tParent = card,
\t})
\taddCorner(toggle, 13)

\tlocal knob = new("Frame", {
\t\tName = "Knob",
\t\tAnchorPoint = Vector2.new(0.5, 0.5),
\t\tPosition = enabled and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 12, 0.5, 0),
\t\tSize = UDim2.fromOffset(19, 19),
\t\tBackgroundColor3 = Color3.new(1, 1, 1),
\t\tBorderSizePixel = 0,
\t\tZIndex = 11,
\t\tParent = toggle,
\t})
\taddCorner(knob, 10)

\tlocal function set(value, silent)
\t\tenabled = value
\t\tstate[key] = value

\t\ttween(toggle, {
\t\t\tBackgroundColor3 = enabled and COLORS.Accent or COLORS.ToggleOff,
\t\t})

\t\ttween(knob, {
\t\t\tPosition = enabled
\t\t\t\tand UDim2.new(1, -12, 0.5, 0)
\t\t\t\tor UDim2.new(0, 12, 0.5, 0),
\t\t})

\t\tif callback and not silent then
\t\t\tcallback(enabled)
\t\tend
\tend

\ttoggle.MouseEnter:Connect(function()
\t\ttween(toggle, {
\t\t\tBackgroundColor3 = enabled and COLORS.AccentHover or Color3.fromRGB(65, 71, 88),
\t\t}, 0.1)
\tend)

\ttoggle.MouseLeave:Connect(function()
\t\ttween(toggle, {
\t\t\tBackgroundColor3 = enabled and COLORS.Accent or COLORS.ToggleOff,
\t\t}, 0.1)
\tend)

\ttoggle.MouseButton1Click:Connect(function()
\t\tset(not enabled)
\tend)

\treturn set
end

