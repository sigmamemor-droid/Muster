local function SetToggleVisual(isOpen)
    ToggleText.Text = isOpen and "CLOSE HUB" or "OPEN HUB"
    TweenService:Create(ToggleFill, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        BackgroundTransparency = isOpen and 0.62 or 0.88
    }):Play()
    TweenService:Create(ToggleText, TweenInfo.new(0.2), {TextColor3 = isOpen and C.white or C.text}):Play()
end

ToggleBtn.MouseEnter:Connect(function()
    if not hubOpen then
        TweenService:Create(ToggleFill, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0.72}):Play()
        TweenService:Create(ToggleText, TweenInfo.new(0.2), {TextColor3 = C.white}):Play()
    end
end)
ToggleBtn.MouseLeave:Connect(function()
    if not hubOpen then SetToggleVisual(false) end
end)

do
    local dragging, dragStart, startPos
    ToggleBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, ToggleBtn.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

