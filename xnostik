local connections = {}
local runningTweens = {}

local function Connect(signal, callback)
\tlocal connection = signal:Connect(callback)
\ttable.insert(connections, connection)
\treturn connection
end

local function Tween(instance, info, properties)
\tif runningTweens[instance] then
\t\trunningTweens[instance]:Cancel()
\tend

\tlocal tween = TweenService:Create(instance, info, properties)
\trunningTweens[instance] = tween

\ttween.Completed:Connect(function()
\t\tif runningTweens[instance] == tween then
\t\t\trunningTweens[instance] = nil
\t\tend
\tend)

\ttween:Play()
\treturn tween
end

local function AddCorner(parent, radius)
\tlocal object = Instance.new("UICorner")
\tobject.CornerRadius = UDim.new(0, radius)
\tobject.Parent = parent
\treturn object
end

local function AddStroke(parent, color, thickness, transparency)
\tlocal object = Instance.new("UIStroke")
\tobject.Color = color
\tobject.Thickness = thickness or 1
\tobject.Transparency = transparency or 0
\tobject.Parent = parent
\treturn object
end

local function CreateLabel(parent, properties)
\tlocal label = Instance.new("TextLabel")

\tfor property, value in pairs(properties) do
\t\tlabel[property] = value
\tend

\tlabel.Parent = parent
\treturn label
end

