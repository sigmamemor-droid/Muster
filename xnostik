local function SetToggleVisual(isOpen)
\tlocal color = isOpen and C.red or C.accent

\tToggleText.Text = isOpen and "CLOSE HUB" or "SACRACIA"
\tToggleIcon.TextColor3 = color

\tTween(ToggleStroke, TweenInfo.new(0.18), {
