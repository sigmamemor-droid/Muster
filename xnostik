    end
    
    setup()
    
    player.CharacterAdded:Connect(function()
        task.wait(1)
        setup()
    end)
end

-- Tracer rendering
local function updateTracers()
    for player, data in pairs(ESPObjects) do
        if data and data.billboard then
            local char = player.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            
            -- Update distance
            local localChar = LocalPlayer.Character
            if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((hrp.Position - localChar.HumanoidRootPart.Position).Magnitude)
                if data.distLabel then
                    data.distLabel.Text = dist .. " studs"
                end
            end
            
            -- Update role color
            local role = getRole(player)
            if role ~= data.role then
                data.role = role
                local espColor = Color3.fromRGB(100, 255, 100)
                if role == "Murderer" then espColor = Color3.fromRGB(255, 50, 50)
                elseif role == "Sheriff" then espColor = Color3.fromRGB(50, 150, 255) end
                data.color = espColor
                if data.nameLabel then data.nameLabel.TextColor3 = espColor end
                if data.highlight then
                    data.highlight.FillColor = espColor
                    data.highlight.OutlineColor = espColor
                end
            end
        end
    end
end

