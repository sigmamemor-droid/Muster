        TextSize = 12,
        TextColor3 = Config.Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = order,
        AutoButtonColor = false,
        Parent = Sidebar
    })
    padding(TabButton, 0, 0, 8, 0)
    
    local Indicator = create("Frame", {
        Name = "Indicator",
        Size = UDim2.new(0, 3, 0, 18),
        Position = UDim2.new(0, 0, 0.5, -9),
        BackgroundColor3 = Config.Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = TabButton
    })
    round(Indicator, 2)
    
    -- Page for this tab
    local Page = create("Frame", {
        Name = name .. "_Page",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = ContentScroller
    })
    
    local PageLayout = create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = Page
    })
    
    TabButton.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.button.TextColor3 = Config.Theme.TextDim
            t.indicator.BackgroundTransparency = 1
            t.page.Visible = false
        end
        TabButton.TextColor3 = Config.Theme.Text
        TweenService:Create(Indicator, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {BackgroundTransparency = 0}):Play()
        Page.Visible = true
        ActiveTab = name
    end)
    
    Tabs[name] = {button = TabButton, indicator = Indicator, page = Page, layout = PageLayout}
    return Page
end

