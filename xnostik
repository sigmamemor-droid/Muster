    local stroke = Instance.new("UIStroke")
    stroke.Color = C.border
    stroke.Thickness = 1
    stroke.Parent = card

    prefix = prefix or "x"

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0.7, 0, 0, 18)
    title.Position = UDim2.new(0, 12, 0, 10)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = C.text
    title.TextSize = 10
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 14
    title.Parent = card

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.3, -12, 0, 18)
    valLabel.Position = UDim2.new(0.7, 0, 0, 10)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = prefix .. tostring(defaultVal)
    valLabel.TextColor3 = C.accent
    valLabel.TextSize = 10
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.ZIndex = 14
    valLabel.Parent = card

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 42)
    track.BackgroundColor3 = C.switchOff
    track.Text = ""
    track.AutoButtonColor = false
    track.ZIndex = 15
    track.Parent = card
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local pct = (defaultVal - minVal) / (maxVal - minVal)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = C.accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 16
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function update(input)
        local delta = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * delta)
        fill.Size = UDim2.new(delta, 0, 1, 0)
        valLabel.Text = prefix .. tostring(val)
        SafeCallback(callback, val)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

---------------------------------------------------------
-- COSMETICS LOGIC (MIDNIGHT WINGS & AURA)
---------------------------------------------------------
local betaState = {
    wings = false,
    aura = false,
    wingSpeed = 3,
    wingFolder = nil,
    auraHighlight = nil,
    auraParticles = nil,
    auraLight = nil,
    conn = nil
}

local function RemoveWings()
    if betaState.wingFolder then betaState.wingFolder:Destroy() betaState.wingFolder = nil end
end

local function RemoveAura()
    if betaState.auraHighlight then betaState.auraHighlight:Destroy() betaState.auraHighlight = nil end
    if betaState.auraParticles then betaState.auraParticles:Destroy() betaState.auraParticles = nil end
    if betaState.auraLight then betaState.auraLight:Destroy() betaState.auraLight = nil end
end

local function CreateWingPart(parent, size)
    local p = Instance.new("Part")
    p.Size = size
    p.Color = C.accent
    p.Material = Enum.Material.Neon
    p.CanCollide = false
    p.Massless = true
    p.Parent = parent
    return p
end

local function ApplyWings()
    RemoveWings()
    if not betaState.wings then return end

    local char = LocalPlayer.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if not torso then return end

    local folder = Instance.new("Folder")
    folder.Name = "MidnightWings"
    folder.Parent = char
    betaState.wingFolder = folder

    local leftRoot = Instance.new("Part")
    leftRoot.Size = Vector3.new(0.1,0.1,0.1)
    leftRoot.Transparency = 1
    leftRoot.CanCollide = false
    leftRoot.Parent = folder

    local rightRoot = Instance.new("Part")
    rightRoot.Size = Vector3.new(0.1,0.1,0.1)
    rightRoot.Transparency = 1
    rightRoot.CanCollide = false
    rightRoot.Parent = folder

    local wL = Instance.new("Weld")
    wL.Part0 = torso; wL.Part1 = leftRoot
    wL.C0 = CFrame.new(-0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(-15), 0)
    wL.Parent = leftRoot

    local wR = Instance.new("Weld")
    wR.Part0 = torso; wR.Part1 = rightRoot
    wR.C0 = CFrame.new(0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(15), 0)
    wR.Parent = rightRoot

    for i = 1, 4 do
        local scale = 1 - (i * 0.15)
        local lBlade = CreateWingPart(folder, Vector3.new(0.1, 1.8 * scale, 0.4 * scale))
        local rBlade = CreateWingPart(folder, Vector3.new(0.1, 1.8 * scale, 0.4 * scale))

        local w1 = Instance.new("Weld")
        w1.Part0 = leftRoot; w1.Part1 = lBlade
        w1.C0 = CFrame.new(-i * 0.35, i * 0.1, -i * 0.1) * CFrame.Angles(0, 0, math.rad(25 + i * 12))
        w1.Parent = lBlade

        local w2 = Instance.new("Weld")
        w2.Part0 = rightRoot; w2.Part1 = rBlade
        w2.C0 = CFrame.new(i * 0.35, i * 0.1, -i * 0.1) * CFrame.Angles(0, 0, math.rad(-(25 + i * 12)))
        w2.Parent = rBlade
    end

    betaState.leftWeld = wL
    betaState.rightWeld = wR
end

local function ApplyAura()
    RemoveAura()
    if not betaState.aura then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = C.accent
    hl.OutlineColor = C.white
    hl.FillTransparency = 0.65
    hl.Adornee = char
    hl.Parent = char
    betaState.auraHighlight = hl

    local pe = Instance.new("ParticleEmitter")
    pe.Color = ColorSequence.new(C.accent, C.white)
    pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0)})
    pe.Texture = "rbxassetid://242200285"
    pe.Lifetime = NumberRange.new(0.8, 1.4)
    pe.Rate = 20
    pe.Speed = NumberRange.new(1.5, 3.5)
    pe.Parent = hrp
    betaState.auraParticles = pe
end

if not betaState.conn then
    betaState.conn = RunService.RenderStepped:Connect(function()
        if betaState.wings and betaState.leftWeld and betaState.rightWeld and betaState.leftWeld.Parent then
            local flap = math.sin(tick() * betaState.wingSpeed) * 0.25
            betaState.leftWeld.C0 = CFrame.new(-0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(-15) - flap, flap * 0.5)
            betaState.rightWeld.C0 = CFrame.new(0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(15) + flap, -flap * 0.5)
        end
    end)
end

