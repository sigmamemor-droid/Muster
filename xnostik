function UI.AddSlider(page, titleText, minVal, maxVal, defaultVal, prefix, callback)
    local frame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        ZIndex = 13,
        Parent = page,
    }, {
        Corner(12),
        Stroke(C.border, 1),
    })

    prefix = prefix or ""

    Create("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 18),
        Position = UDim2.new(0, 12, 0, 7),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = C.text,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 14,
        Parent = frame,
    })

    local valLabel = Create("TextLabel", {
        Size = UDim2.new(0.3, -12, 0, 18),
        Position = UDim2.new(0.7, 0, 0, 7),
        BackgroundTransparency = 1,
        Text = prefix .. tostring(defaultVal),
        TextColor3 = C.accent,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 14,
        Parent = frame,
    })

    local track = Create("TextButton", {
        Size = UDim2.new(1, -24, 0, 4),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = C.switchOff,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 14,
        Parent = frame,
    }, { Corner(2) })

    local pct = (defaultVal - minVal) / (maxVal - minVal)
    local fill = Create("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = 15,
        Parent = track,
    }, { Corner(2) })

    local thumb = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(pct, 0, 0.5, 0),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0,
        ZIndex = 16,
        Parent = track,
    }, { Corner(6) })

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, 0, 0.5, 0)
        valLabel.Text = prefix .. tostring(val)
        Safe(callback, val)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    maid:Give(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

