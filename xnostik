function Components.createToggle(parent, label, initialState, onChanged)
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = CONFIG.Theme.Card,
		BorderSizePixel = 0,
		Parent = parent,
	})
	addCorner(row)
	
	create("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.new(0, 14, 0, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = CONFIG.Theme.TextPrimary,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	
	local toggle = create("TextButton", {
		Size = UDim2.new(0, 42, 0, 22),
		Position = UDim2.new(1, -54, 0.5, -11),
		BackgroundColor3 = initialState and CONFIG.Theme.Accent or CONFIG.Theme.Border,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	addCorner(toggle, 11)
	
	local knob = create("Frame", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = initialState and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = toggle,
	})
	addCorner(knob, 9)
	
	local state = initialState
	
	local function updateVisual(newState)
		tween(toggle, { BackgroundColor3 = newState and CONFIG.Theme.Accent or CONFIG.Theme.Border }, 0.18)
		tween(knob, { Position = newState and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9) }, 0.18)
	end
	
	toggle.MouseButton1Click:Connect(function()
		state = not state
		updateVisual(state)
		if onChanged then onChanged(state) end
	end)
	
	-- Hover effects
	toggle.MouseEnter:Connect(function()
		if not state then
			tween(toggle, { BackgroundColor3 = CONFIG.Theme.CardHover }, 0.1):Play()
		end
	end)
	toggle.MouseLeave:Connect(function()
		if not state then
			tween(toggle, { BackgroundColor3 = CONFIG.Theme.Border }, 0.1):Play()
		end
	end)
	
	return {
		Row = row,
		Toggle = toggle,
		Set = function(newState)
			state = newState
			updateVisual(state)
		end,
		Get = function() return state end
	}
end

