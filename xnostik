-- CONNECTION MANAGER & GLOBAL CLEANUP
---------------------------------------------------------
local connections = {}

local function Track(conn)
    table.insert(connections, conn)
    return conn
end

local function Cleanup()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    connections = {}
end

-- Disconnect previous instance's connections + destroy old GUI
if _G.MM2HubMobileCleanup then
    pcall(_G.MM2HubMobileCleanup)
end

_G.MM2HubMobileCleanup = function()
    Cleanup()
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        local old = pg:FindFirstChild("MM2HubMobile")
        if old then old:Destroy() end
    end
    -- Clean up character cosmetics that live under Character, not PlayerGui
    local char = player:FindFirstChild("Character")
    if char then
        local wings = char:FindFirstChild("MidnightWings")
        if wings then wings:Destroy() end
        local hl = char:FindFirstChild("MidnightAuraHL")
