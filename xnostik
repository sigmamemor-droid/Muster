local Tabs = {}
local firstTabActivated = false

local function applyTheme(themeName)
    local t = Themes[themeName]
    if not t then return end
    Theme.Accent = t.accent
    Theme.AccentDim = t.dim
    for _, elem in ipairs(accentElements) do
        if elem:IsA("UIStroke") then
            TweenService:Create(elem, TweenInfo.new(0.4), {Color = t.accent}):Play()
        elseif elem:IsA("TextLabel") or elem:IsA("TextButton") then
            TweenService:Create(elem, TweenInfo.new(0.4), {TextColor3 = t.accent}):Play()
        elseif elem:IsA("Frame") then
            TweenService:Create(elem, TweenInfo.new(0.4), {BackgroundColor3 = t.accent}):Play()
        elseif elem:IsA("ScrollingFrame") then
            TweenService:Create(elem, TweenInfo.new(0.4), {ScrollBarImageColor3 = t.accent}):Play()
        elseif elem:IsA("ImageLabel") then
            TweenService:Create(elem, TweenInfo.new(0.4), {ImageColor3 = t.accent}):Play()
        end
    end
end

local function switchTab(name)
    for tname, tdata in pairs(Tabs) do
        tdata.page.Visible = false
        TweenService:Create(tdata.button, TweenInfo.new(0.2), {
            BackgroundColor3 = Theme.Sidebar
        }):Play()
        TweenService:Create(tdata.indicator, TweenInfo.new(0.2), {
            BackgroundTransparency = 1
        }):Play()
        TweenService:Create(tdata.button, TweenInfo.new(0.2), {
            TextColor3 = Theme.TextDim
        }):Play()
    end
    local tdata = Tabs[name]
    if tdata then
        tdata.page.Visible = true
        TweenService:Create(tdata.button, TweenInfo.new(0.2), {
            BackgroundColor3 = Theme.Element
        }):Play()
        TweenService:Create(tdata.indicator, TweenInfo.new(0.2), {
            BackgroundTransparency = 0
        }):Play()
        TweenService:Create(tdata.button, TweenInfo.new(0.2), {
            TextColor3 = Theme.Text
        }):Play()
    end
end

