local function selectTab(name)
\tif activeTab == name then
\t\treturn
\tend

\tactiveTab = name

\tfor tabName, page in pairs(pages) do
\t\tlocal selected = tabName == name
\t\tpage.Visible = selected

\t\tif selected then
\t\t\tpage.CanvasPosition = Vector2.new(0, 0)
\t\tend
\tend

\tfor tabName, elements in pairs(tabButtons) do
\t\tlocal selected = tabName == name

\t\ttween(elements.Button, {
\t\t\tBackgroundColor3 = selected and COLORS.AccentSoft or COLORS.Sidebar,
\t\t\tBackgroundTransparency = selected and 0 or 1,
\t\t})

\t\ttween(elements.Icon, {
\t\t\tImageColor3 = selected and Color3.new(1, 1, 1) or COLORS.Muted,
\t\t})

\t\ttween(elements.Indicator, {
\t\t\tBackgroundTransparency = selected and 0 or 1,
\t\t\tSize = selected and UDim2.fromOffset(3, 24) or UDim2.fromOffset(3, 8),
\t\t})
\tend

\tfor _, data in ipairs(TAB_DATA) do
\t\tif data.Name == name then
\t\t\tpageTitle.Text = data.Title
\t\t\tpageSubtitle.Text = data.Subtitle
\t\t\tbreak
\t\tend
\tend
end

