floatingButton.InputBegan:Connect(function(input)
\tif input.UserInputType ~= Enum.UserInputType.MouseButton1
\t\tand input.UserInputType ~= Enum.UserInputType.Touch then
\t\treturn
\tend

\tfloatDragging = true
\tfloatMoved = false
\tfloatStartInput = input
\tfloatStartPoint = input.Position
\tfloatStartPosition = floatingButton.Position
end)

UserInputService.InputChanged:Connect(function(input)
\tif not floatDragging then
\t\treturn
\tend

\tif input.UserInputType ~= Enum.UserInputType.MouseMovement
\t\tand input.UserInputType ~= Enum.UserInputType.Touch then
\t\treturn
\tend

\tlocal offset = input.Position - floatStartPoint
\tif offset.Magnitude > 7 then
\t\tfloatMoved = true
\tend

\tfloatingButton.Position = UDim2.new(
\t\tfloatStartPosition.X.Scale,
\t\tfloatStartPosition.X.Offset + offset.X,
\t\tfloatStartPosition.Y.Scale,
\t\tfloatStartPosition.Y.Offset + offset.Y
\t)
end)

