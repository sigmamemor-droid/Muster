---------------------------------------------------------
-- ASCII-маркеры отображаются одинаково на ПК и мобильных устройствах.
local tabDefs = {
    {name = "Home",     title = "Главная",           icon = "[H]"},
    {name = "Combat",   title = "Сражение",          icon = "[C]"},
    {name = "ESP",      title = "ЕСП / ВХ",          icon = "[E]"},
    {name = "Fun",      title = "Фан и троллинг",    icon = "[F]"},
    {name = "Boombox",  title = "Музыка",            icon = "[M]"},
    {name = "Nexus",    title = "Nexus",             icon = "[N]"},
    {name = "Settings", title = "Настройки",         icon = "[S]"},
    {name = "Info",     title = "Информация",        icon = "[I]"},
}

local CX, CY = SIDEBAR_W + 1, TOPBAR_H
local CW, CH = HUB_W - SIDEBAR_W - 1, HUB_H - TOPBAR_H
local tabPages, tabButtons, currentTab = {}, {}, nil

local function ShowTab(name, index)
    if currentTab == name then return end

    for tabName, page in pairs(tabPages) do page.Visible = (tabName == name) end
    for tabName, btn in pairs(tabButtons) do
        btn.TextColor3 = (tabName == name) and C.accentLight or C.textDim
    end

    currentTab = name
    for _, def in ipairs(tabDefs) do
        if def.name == name then
            PageTitle.Text = def.icon .. " " .. def.title
            break
        end
    end

    TweenService:Create(TabGlider, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 6, 0, 40 + (index - 1) * 30) -- 28px + 2px gap
    }):Play()
end

for idx, def in ipairs(tabDefs) do
    local Page = Instance.new("Frame")
    Page.Name = "Page_" .. def.name
    Page.Size = UDim2.new(0, CW, 0, CH)
    Page.Position = UDim2.new(0, CX, 0, CY)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.Visible = false
    Page.ZIndex = 11
    Page.Parent = Hub
    BuildPlaceholder(Page)
    tabPages[def.name] = Page

    local Btn = Instance.new("TextButton")
    Btn.Name = "Tab_" .. def.name
    Btn.Size = UDim2.new(1, 0, 0, 28)
    Btn.BackgroundTransparency = 1
    Btn.Text = def.icon .. "  " .. def.title
    Btn.TextColor3 = C.textDim
    Btn.TextSize = 10
    Btn.Font = Enum.Font.GothamBold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.AutoButtonColor = false
    Btn.ZIndex = 14
    Btn.Parent = TabList
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    tabButtons[def.name] = Btn

    Btn.MouseButton1Click:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.92, 0, 0, 26)}):Play()
        task.delay(0.06, function()
            if Btn.Parent then
                TweenService:Create(Btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 28)}):Play()
            end
        end)
        ShowTab(def.name, idx)
    end)
end

