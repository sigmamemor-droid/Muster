local function createToggle(parent, text, stateKey, callback)
    local Container = create("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Config.Theme.Element,
        BorderSizePixel = 0,
        Parent = parent
    })
    round(Container, 6)
    stroke(Container, Config.Theme.Stroke, 1)
    padding(Container, 0, 0, 10, 10)
    
    local Label = create("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Config.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Container
    })
    
    local ToggleTrack = create("TextButton", {
        Size = UDim2.new(0, 36, 0, 18),
        Position = UDim2.new(1, -36, 0.5, -9),
        BackgroundColor3 = Config.Theme.ToggleOff,
        Text = "",
        AutoButtonColor = false,
        Parent = Container
    })
    round(ToggleTrack, 9)
    
    local ToggleKnob = create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Config.Theme.Text,
        BorderSizePixel = 0,
        Parent = ToggleTrack
    })
    round(ToggleKnob, 7)
    
    local state = false
    
    local function setToggle(v)
        state = v
        Features[stateKey] = v
        if v then
            TweenService:Create(ToggleTrack, TweenInfo.new(0.2), {BackgroundColor3 = Config.Theme.ToggleOn}):Play()
            TweenService:Create(ToggleKnob, TweenInfo.new(0.2), {Position = UDim2.new(1, -16, 0.5, -7)}):Play()
        else
            TweenService:Create(ToggleTrack, TweenInfo.new(0.2), {BackgroundColor3 = Config.Theme.ToggleOff}):Play()
            TweenService:Create(ToggleKnob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
        end
        if callback then callback(v) end
    end
    
    ToggleTrack.MouseButton1Click:Connect(function()
        setToggle(not state)
    end)
    
    Config.Toggles[stateKey] = setToggle
    return Container
end

local function createSlider(parent, text, min, max, default, stateKey, callback)
    local Container = create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Config.Theme.Element,
        BorderSizePixel = 0,
        Parent = parent
    })
    round(Container, 6)
    stroke(Container, Config.Theme.Stroke, 1)
    padding(Container, 4, 4, 10, 10)
    
    local Label = create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 16),
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Config.Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Container
    })
    
    local ValueLabel = create("TextLabel", {
        Size = UDim2.new(0, 40, 0, 16),
        Position = UDim2.new(1, -40, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(default),
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Config.Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = Container
    })
    
    local Track = create("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0, 24),
        BackgroundColor3 = Config.Theme.ToggleOff,
        BorderSizePixel = 0,
        Parent = Container
    })
    round(Track, 2)
    
    local Fill = create("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Config.Theme.Accent,
        BorderSizePixel = 0,
        Parent = Track
    })
    round(Fill, 2)
    
    local Knob = create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6),
        BackgroundColor3 = Config.Theme.Text,
        BorderSizePixel = 0,
        Parent = Track
    })
    round(Knob, 6)
    
    local dragging = false
    
    local function update(input)
        local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pct)
        ValueLabel.Text = tostring(val)
        Features[stateKey] = val
        TweenService:Create(Fill, TweenInfo.new(0.05), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
        TweenService:Create(Knob, TweenInfo.new(0.05), {Position = UDim2.new(pct, -6, 0.5, -6)}):Play()
        if callback then callback(val) end
    end
    
    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return Container
end

