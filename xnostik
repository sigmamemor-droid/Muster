-- FPS engine
local frameCount = 0
local lastTick = tick()
RunService.RenderStepped:Connect(function()
	frameCount += 1
	local now = tick()
	if now - lastTick >= 1 then
		fpsNum.Text = tostring(frameCount)
		frameCount = 0
		lastTick = now
	end
end)

-- Ping engine
task.spawn(function()
	while true do
		local net = Stats:FindFirstChild("Network")
		if net then
			local p = net:FindFirstChild("Ping")
			if p then
				local v = math.floor(p.Value)
				pingNum.Text = tostring(v) .. "ms"
				if v < 50 then
					pingNum.TextColor3 = Color3.fromRGB(80, 255, 120)
				elseif v < 120 then
					pingNum.TextColor3 = Color3.fromRGB(255, 200, 60)
				else
					pingNum.TextColor3 = Color3.fromRGB(255, 70, 70)
				end
			end
		end
		task.wait(1)
	end
end)

-- Toggle logic
local active = false
local function setToggle(state)
	active = state
	if state then
		tween(switchBg, {BackgroundColor3 = Color3.fromRGB(255, 60, 60)}, 0.2)
		tween(knob, {Position = UDim2.new(0, 23, 0.5, -9)}, 0.2)
		tween(stroke, {Color = Color3.fromRGB(80, 255, 120), Transparency = 0.2}, 0.3)
		title.TextColor3 = Color3.fromRGB(80, 255, 120)
		
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.Material = Enum.Material.SmoothPlastic
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj:Destroy()
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
				obj.Enabled = false
			elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
				obj.Enabled = false
			end
		end
	else
		tween(switchBg, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}, 0.2)
		tween(knob, {Position = UDim2.new(0, 3, 0.5, -9)}, 0.2)
		tween(stroke, {Color = Color3.fromRGB(255, 60, 60), Transparency = 0.4}, 0.3)
		title.TextColor3 = Color3.fromRGB(255, 70, 70)
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level07
	end
end

switchBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		setToggle(not active)
	end
end)