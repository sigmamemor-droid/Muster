		foundUserId = nil
		avatar.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
		nameLabel.Text, statusLabel.Text, locationLabel.Text = "Игрок не найден", data.message or "Проверь никнейм.", ""
		statusDot.TextColor3 = Color3.fromRGB(245, 90, 95)
