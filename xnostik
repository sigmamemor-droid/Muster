applyResponsiveLayout = function()
    local viewport = getViewport()
    compactMode = viewport.X < 520 or windowSize.X < 500
    local sideWidth = compactMode and 58 or SIDEBAR_W
    Sidebar.Size = UDim2.new(0, sideWidth, 1, 0)
    TopB.Size = UDim2.new(1, -sideWidth, 0, TOPBAR_H)
    TopB.Position = UDim2.new(0, sideWidth, 0, 0)
    for _, page in pairs(tabPages) do
        page.Size = UDim2.new(1, -sideWidth - 1, 1, -TOPBAR_H)
        page.Position = UDim2.new(0, sideWidth + 1, 0, TOPBAR_H)
    end
    SLogo.Visible = not compactMode
    TabHolder.Position = UDim2.new(0, 0, 0, compactMode and 12 or 66)
    TabHolder.Size = UDim2.new(1, 0, 1, compactMode and -12 or -66)
    TabList.Size = UDim2.new(1, compactMode and -10 or -16, 1, -16)
    TabList.Position = UDim2.new(0, compactMode and 5 or 8, 0, 8)
    for _, def in ipairs(tabDefs) do
        local btn = tabButtons[def.name]
        if btn then
            btn.Text = compactMode and def.icon or ("   " .. def.icon .. "    " .. def.title)
            btn.TextXAlignment = compactMode and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
            btn.TextSize = compactMode and 12 or 11
        end
    end
    TabGlider.Size = UDim2.new(1, compactMode and -10 or -16, 0, 32)
    local selectedIndex = 1
    for index, def in ipairs(tabDefs) do
        if def.name == currentTab then selectedIndex = index break end
    end
    TabGlider.Position = UDim2.new(0, compactMode and 5 or 8, 0, (compactMode and 20 or 74) + (selectedIndex - 1) * 36)
    GliderLine.Visible = not compactMode
end
