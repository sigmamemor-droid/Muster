    title.ZIndex = 14
    title.Parent = frame

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.3, 0, 0, 14)
    valLabel.Position = UDim2.new(0.7, 0, 0, 0)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = prefix .. tostring(defaultVal)
    valLabel.TextColor3 = AppC.text
    valLabel.TextSize = 10
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.ZIndex = 14
    valLabel.Parent = frame

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, 0, 0, 4)
    track.Position = UDim2.new(0, 0, 0, 20)
    track.BackgroundColor3 = AppC.switchOff
    track.Text = ""
    track.AutoButtonColor = false
    track.ZIndex = 14
    track.Parent = frame
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local pct = math.clamp((defaultVal - minVal) / range, 0, 1)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = AppC.accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 15
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 10, 0, 10)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.new(pct, 0, 0.5, 0)
    thumb.BackgroundColor3 = AppC.white
    thumb.BorderSizePixel = 0
    thumb.ZIndex = 16
    thumb.Parent = track
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    -- Make the thumb invisible-frame larger for easier touch targeting
    local touchArea = Instance.new("TextButton")
    touchArea.Size = UDim2.new(1, 0, 0, 24)
    touchArea.Position = UDim2.new(0, 0, 0.5, -12)
    touchArea.BackgroundTransparency = 1
    touchArea.Text = ""
    touchArea.AutoButtonColor = false
    touchArea.ZIndex = 17  -- above track(14), fill(15), thumb(16)
    touchArea.Parent = frame

    local dragging = false
    local activeInput = nil

    local function update(input)
        local trackAbsPos = track.AbsolutePosition.X
        local trackAbsSize = track.AbsoluteSize.X
        if trackAbsSize < 1 then return end  -- not laid out yet
        local delta = math.clamp((input.Position.X - trackAbsPos) / trackAbsSize, 0, 1)
        local val = math.round(minVal + range * delta)
        fill.Size = UDim2.new(delta, 0, 1, 0)
        thumb.Position = UDim2.new(delta, 0, 0.5, 0)
        valLabel.Text = prefix .. tostring(val)
        if callback then pcall(callback, val) end
    end

    touchArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            activeInput = input
            update(input)
        end
    end)

    -- Per-slider InputChanged: only act on our active input
    Track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if not IsDragInput(input, activeInput) then return end
        update(input)
    end))

    Track(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == activeInput
         or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
             and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging = false
            activeInput = nil
        end
    end))

    return frame
end

