-- Star creation function
local function CreateStarLayer(starCount, size, speed, maxOpacity)
    local stars = {}
    for i = 1, starCount do
        local Star = Instance.new("Frame")
        Star.Size = UDim2.new(0, size, 0, size)
        Star.Position = UDim2.new(math.random(), 0, math.random(), 0)
        Star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Star.BackgroundTransparency = 1 - (math.random() * maxOpacity + 0.1)
        Star.BorderSizePixel = 0
        Star.ZIndex = 101
        Star.Parent = LoadingScreen
        Instance.new("UICorner", Star).CornerRadius = UDim.new(1, 0)
        table.insert(stars, {frame = Star, speed = speed * (0.5 + math.random() * 0.5)})
    end
    
    task.spawn(function()
        while LoadingScreen.Parent do
            for _, star in pairs(stars) do
                if star.frame and star.frame.Parent then
                    local newY = star.frame.Position.Y.Scale + (0.001 * star.speed / 100)
                    if newY > 1 then
                        newY = -0.05
                        star.frame.Position = UDim2.new(math.random(), 0, newY, 0)
                    else
                        star.frame.Position = UDim2.new(star.frame.Position.X.Scale, 0, newY, 0)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

