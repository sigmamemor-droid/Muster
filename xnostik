	if show then
		main.Visible = true
		backdrop.Active = true
		tween(main, { Size = UDim2.new(0, CONFIG.WindowSize.X, 0, CONFIG.WindowSize.Y), Position = UDim2.new(0.5, -CONFIG.WindowSize.X/2, 0.5, -CONFIG.WindowSize.Y/2) }, 0.3):Play()
	else
		backdrop.Active = false
		tween(main, { Size = UDim2.new(0,0,0,0), Position = UDim2.new(0.5,0,0.5,0) }, 0.3):Play()
		task.delay(0.3, function() if not uiVisible then main.Visible = false end end)
	end
end
closeBtn.MouseButton1Click:Connect(function() setVisible(false) end)
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.RightControl then setVisible(not uiVisible) end
end)

-- ═══════════════════════════════════════════════
--  LOADING SEQUENCE → reveal main UI
-- ═══════════════════════════════════════════════
task.spawn(function()
	tween(barFill, { Size = UDim2.new(1, 0, 1, 0) }, 1.6, Enum.EasingStyle.Quad):Play()
	task.wait(1.8)

	-- fade out loading screen
	tween(loadingScreen, { BackgroundTransparency = 1 }, 0.4):Play()
	tween(loadTitle, { TextTransparency = 1 }, 0.3):Play()
	tween(loadLabel, { TextTransparency = 1 }, 0.3):Play()
	tween(glow, { ImageTransparency = 1 }, 0.4):Play()
	tween(ringStroke, { Transparency = 1 }, 0.3):Play()
	tween(barTrack, { BackgroundTransparency = 1 }, 0.3):Play()
	tween(barFill, { BackgroundTransparency = 1 }, 0.3):Play()

	task.wait(0.4)
	loadingScreen.Visible = false
	loadingScreen:Destroy()

	-- reveal main window
	main.Size = UDim2.new(0, 0, 0, 0)
	main.Position = UDim2.new(0.5, 0, 0.5, 0)
	main.Visible = true
	tween(main, { Size = UDim2.new(0, CONFIG.WindowSize.X, 0, CONFIG.WindowSize.Y), Position = UDim2.new(0.5, -CONFIG.WindowSize.X/2, 0.5, -CONFIG.WindowSize.Y/2) }, 0.4):Play()
end)

