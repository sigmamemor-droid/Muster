do
    local dragging, activeInput, dragStart, startPos
    local function isInside(object, point)
        local p, s = object.AbsolutePosition, object.AbsoluteSize
        return point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y
    end
    TopB.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not windowInteraction then
            -- InputObject has no Target property; use the close button's bounds instead.
            if isInside(ClB, input.Position) then return end
            ensureWindowRect()
            windowInteraction = "drag"
            dragging, activeInput, dragStart, startPos = true, input, input.Position, windowPos
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == activeInput) then
            applyWindowRect(startPos + (input.Position - dragStart), windowSize)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == activeInput or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging, activeInput, windowInteraction = false, nil, nil
        end
    end)
end

-- Невидимые, но широкие зоны дают растяжение со всех сторон и углов.
local function addResizeHandle(name, position, size, left, right, top, bottom)
    local handle = Instance.new("TextButton")
    handle.Name = "Resize_" .. name
    handle.Position, handle.Size = position, size
    handle.BackgroundTransparency, handle.TextTransparency = 1, 1
    handle.AutoButtonColor, handle.Active = false, true
    handle.ZIndex = 30
    handle.Parent = Hub

    local resizing, activeInput, startPointer, startPosition, startSize
    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if windowInteraction then return end
        ensureWindowRect()
        windowInteraction = "resize"
        resizing, activeInput = true, input
        startPointer, startPosition, startSize = input.Position, windowPos, windowSize
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not resizing or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= activeInput) then return end
        local delta = input.Position - startPointer
        local x, y, w, h = startPosition.X, startPosition.Y, startSize.X, startSize.Y
        if left then x, w = x + delta.X, w - delta.X end
        if right then w = w + delta.X end
        if top then y, h = y + delta.Y, h - delta.Y end
        if bottom then h = h + delta.Y end
        -- При упоре в минимальный размер сохраняем противоположную грань на месте.
        local viewport = getViewport()
        local effectiveMinW = math.max(1, math.min(MIN_SIZE.X, viewport.X - 16))
        local effectiveMinH = math.max(1, math.min(MIN_SIZE.Y, viewport.Y - 16))
        if left and w < effectiveMinW then x = startPosition.X + startSize.X - effectiveMinW end
        if top and h < effectiveMinH then y = startPosition.Y + startSize.Y - effectiveMinH end
        applyWindowRect(Vector2.new(x, y), Vector2.new(w, h))
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input == activeInput or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
            resizing, activeInput, windowInteraction = false, nil, nil
        end
    end)
end
