local tabsFrame = Instance.new("Frame")
tabsFrame.Name = "Tabs"
tabsFrame.Size = UDim2.new(0, 168, 1, -88)
tabsFrame.Position = UDim2.new(1, -188, 0, 76)
tabsFrame.BackgroundTransparency = 1
tabsFrame.Parent = mainFrame

local tabsLayout = Instance.new("UIListLayout")
tabsLayout.Padding = UDim.new(0, 8)
tabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
tabsLayout.Parent = tabsFrame

local tabData = {
    {name = "Главная", soon = false},
    {name = "Игрок", soon = true},
    {name = "Мир", soon = true},
    {name = "Визуал", soon = true},
    {name = "Аудио", soon = true},
    {name = "Настройки", soon = true},
    {name = "О проекте", soon = true},
}

local accentColor = Color3.fromRGB(130, 105, 255)

for i, data in ipairs(tabData) do
    local tab = Instance.new("Frame")
    tab.Name = "Tab" .. i
    tab.Size = UDim2.new(1, 0, 0, 40)
    tab.BackgroundColor3 = data.soon and Color3.fromRGB(30, 30, 40) or accentColor
    tab.BackgroundTransparency = data.soon and 0 or 0.1
    tab.LayoutOrder = i
    tab.Parent = tabsFrame

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 10)
    tabCorner.Parent = tab

    local tabStroke = Instance.new("UIStroke")
    tabStroke.Color = data.soon and Color3.fromRGB(255, 255, 255) or accentColor
    tabStroke.Transparency = data.soon and 0.92 or 0.5
    tabStroke.Thickness = 1
    tabStroke.Parent = tab

    local tabLabel = Instance.new("TextLabel")
    tabLabel.Size = UDim2.new(1, -60, 1, 0)
    tabLabel.Position = UDim2.new(0, 14, 0, 0)
    tabLabel.BackgroundTransparency = 1
    tabLabel.Text = data.name
    tabLabel.Font = Enum.Font.GothamSemibold
    tabLabel.TextSize = 13
    tabLabel.TextColor3 = data.soon and Color3.fromRGB(150, 150, 162) or Color3.fromRGB(255, 255, 255)
    tabLabel.TextXAlignment = Enum.TextXAlignment.Left
    tabLabel.TextTruncate = Enum.TextTruncate.AtEnd
    tabLabel.Parent = tab

    if data.soon then
        local badge = Instance.new("Frame")
        badge.Size = UDim2.new(0, 42, 0, 18)
        badge.Position = UDim2.new(1, -52, 0.5, -9)
        badge.BackgroundColor3 = Color3.fromRGB(255, 175, 70)
        badge.BackgroundTransparency = 0.85
        badge.Parent = tab

        local badgeCorner = Instance.new("UICorner")
        badgeCorner.CornerRadius = UDim.new(1, 0)
        badgeCorner.Parent = badge

        local badgeStroke = Instance.new("UIStroke")
        badgeStroke.Color = Color3.fromRGB(255, 175, 70)
        badgeStroke.Transparency = 0.4
        badgeStroke.Thickness = 1
        badgeStroke.Parent = badge

        local badgeLabel = Instance.new("TextLabel")
        badgeLabel.Size = UDim2.new(1, 0, 1, 0)
        badgeLabel.BackgroundTransparency = 1
        badgeLabel.Text = "SOON"
        badgeLabel.Font = Enum.Font.GothamBold
        badgeLabel.TextSize = 10
        badgeLabel.TextColor3 = Color3.fromRGB(255, 195, 110)
        badgeLabel.Parent = badge
    else
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 6, 0, 6)
        dot.Position = UDim2.new(1, -20, 0.5, -3)
        dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        dot.Parent = tab

        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = dot
    end
end

