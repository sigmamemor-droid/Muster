        state = not state
        TweenService:Create(switchTrack, TweenInfo.new(0.18), {
            BackgroundColor3 = state and AppC.accent or AppC.switchOff
        }):Play()
        TweenService:Create(switchThumb, TweenInfo.new(0.18), {
