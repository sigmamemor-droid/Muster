    {name = "Combat",      title = "Сражение",         icon = "⚔️"},
    {name = "ESP",         title = "ЕСП/ВХ",           icon = "👁️"},
    {name = "Fun",         title = "Фан и Троллинг",   icon = "🎭"},
    {name = "Boombox",     title = "Музыка",           icon = "🎵"},
    {name = "Nexus",       title = "Nexus",            icon = "💎"},
    {name = "Settings",    title = "Настройки",        icon = "⚙️"},
    {name = "Info",        title = "Информация",       icon = "📝"},
}

local CX, CY = SIDEBAR_W + 1, TOPBAR_H
local CW, CH = HUB_W - SIDEBAR_W - 1, HUB_H - TOPBAR_H

local tabPages = {}   -- [name] = Frame
local tabButtons = {} -- [name] = TextButton
local currentTab = nil

-- Центральная функция переключения вкладок.
-- Гарантированно скрывает ВСЕ страницы и показывает только нужную —
-- это устраняет баг, при котором "невидимая" вкладка оставалась поверх других.
local function ShowTab(name, index)
    if currentTab == name then return end

    for tabName, page in pairs(tabPages) do
        page.Visible = (tabName == name)
    end

    for tabName, btn in pairs(tabButtons) do
        btn.TextColor3 = (tabName == name) and C.accentLight or C.textDim
    end

    currentTab = name
    local def
    for _, d in ipairs(tabDefs) do if d.name == name then def = d break end end
    if def then
        PageTitle.Text = def.icon .. " " .. def.title
    end

    local targetY = 4 + (index - 1) * 28
    TweenService:Create(TabGlider, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, targetY)
    }):Play()
end

for idx, def in ipairs(tabDefs) do
    -- Страница контента
    local Page = Instance.new("Frame")
    Page.Name = "Page_" .. def.name
    Page.Size = UDim2.new(0, CW, 0, CH)
    Page.Position = UDim2.new(0, CX, 0, CY)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.Visible = false
    Page.ZIndex = 11
    Page.Parent = Hub

    BuildPlaceholder(Page)
    tabPages[def.name] = Page

    -- Кнопка вкладки в сайдбаре
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 26)
    Btn.BackgroundTransparency = 1
    Btn.Text = def.icon .. " " .. def.title
    Btn.TextColor3 = C.textDim
    Btn.TextSize = 10
    Btn.Font = Enum.Font.GothamBold
    Btn.AutoButtonColor = false
    Btn.ZIndex = 14
    Btn.Parent = TabHolder
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
    tabButtons[def.name] = Btn

    Btn.MouseButton1Click:Connect(function()
        -- Небольшая анимация нажатия
        TweenService:Create(Btn, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.92, 0, 0, 24)
        }):Play()
        task.delay(0.06, function()
            TweenService:Create(Btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 26)
            }):Play()
        end)
        ShowTab(def.name, idx)
    end)
end

