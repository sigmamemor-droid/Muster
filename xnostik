-- ==================== UTILS ====================
local function create(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then obj[k] = v end
	end
	if props and props.Parent then obj.Parent = props.Parent end
	return obj
end

local function tween(obj, goal, duration, style)
	return TweenService:Create(obj, TweenInfo.new(duration or CONFIG.AnimSpeed, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goal)
end

local function addCorner(parent, radius)
	create("UICorner", {CornerRadius = UDim.new(0, radius or 14), Parent = parent})
end

local function addStroke(parent, color, thickness)
	create("UIStroke", {
		Color = color or CONFIG.Theme.Border,
		Thickness = thickness or 1.2,
		Transparency = 0.6,
		Parent = parent
	})
end

