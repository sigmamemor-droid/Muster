local function updateESP()
    local anyESP = Features.PlayerESP or Features.MurdererESP or Features.SheriffESP
    
    for player, data in pairs(ESPObjects) do
        if not player or not player.Parent then
            if data.billboard then data.billboard:Destroy() end
            if data.highlight then data.highlight:Destroy() end
            ESPObjects[player] = nil
            continue
        end
        
        local char = player.Character
        if not char then continue end
        
        local role = getRole(player)
        local color = getRoleColor(role)
        
        -- Update role if changed
        if data.role ~= role then
            data.role = role
        end
        
        local show = false
        if Features.PlayerESP then show = true
        elseif Features.MurdererESP and role == "Murderer" then show = true
        elseif Features.SheriffESP and role == "Sheriff" then show = true end
        
        -- Billboard
        if data.billboard then
            data.billboard.Enabled = show and (Features.NameTags or Features.DistanceESP)
            if data.nameLabel then
                data.nameLabel.Visible = Features.NameTags
                data.nameLabel.Text = player.Name
            end
            if data.roleLabel then
                data.roleLabel.Visible = Features.NameTags
                data.roleLabel.Text = "[" .. role .. "]"
                data.roleLabel.TextColor3 = color
            end
            if data.distLabel then
                data.distLabel.Visible = Features.DistanceESP
                local localChar = LocalPlayer.Character
                if localChar and localChar:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                    local dist = math.floor((char.HumanoidRootPart.Position - localChar.HumanoidRootPart.Position).Magnitude)
                    data.distLabel.Text = dist .. " studs"
                end
            end
        end
        
        -- Highlight
        if data.highlight then
            data.highlight.Enabled = show and Features.Chamms
            data.highlight.FillColor = color
            data.highlight.OutlineColor = color
        end
    end
end

