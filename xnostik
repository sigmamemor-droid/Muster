AddToggle(farm, "Auto Farm Nearest", false, function(state)
    getgenv().AutoFarm = state
    if state then
        task.spawn(function()
            while getgenv().AutoFarm do
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        -- ищем ближайшего противника (NPC с Humanoid)
                        local nearest, dist = nil, math.huge
                        for _, v in ipairs(workspace:GetDescendants()) do
                            if v:IsA("Model") and v ~= char then
                                local hum = v:FindFirstChild("Humanoid")
                                local root = v:FindFirstChild("HumanoidRootPart")
                                if hum and root and hum.Health > 0 and v.Name ~= LocalPlayer.Name then
                                    local d = (root.Position - hrp.Position).Magnitude
                                    if d < dist then
                                        dist = d
                                        nearest = v
                                    end
                                end
                            end
                        end
                        if nearest then
                            local targetRoot = nearest:FindFirstChild("HumanoidRootPart")
                            if targetRoot then
                                char.Humanoid:MoveTo(targetRoot.Position)
                                -- атака (универсальный инструмент)
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool and tool:FindFirstChild("Handle") then
                                    tool:Activate()
                                else
                                    -- клик атака
                                    VirtualInputManager:SendMouseButtonEvent(100, 100, 0, true, game, 0)
                                    task.wait(0.1)
                                    VirtualInputManager:SendMouseButtonEvent(100, 100, 0, false, game, 0)
                                end
                            end
                        end
                    end
                end
                task.wait(0.2)
            end
        end)
    end
end)

