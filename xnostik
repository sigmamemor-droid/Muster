-- АНИМАЦИЯ (КАК В CSS)
---------------------------------------------------------

local startTime = tick()
local animationPhase = 0
local isComplete = false

local function AnimateCubes()
    local elapsed = tick() - startTime
    local t = elapsed * 0.6
    animationPhase = t
    
    -- Обновляем прогресс
    local progress = math.min(1, elapsed / 4.5)
    ProgFill.Size = UDim2.new(progress, 0, 1, 0)
    
    local steps = {
        {0.05, "Initializing..."},
        {0.20, "Loading 3D Engine..."},
        {0.40, "Connecting to Nexus..."},
        {0.60, "Optimizing Mobile..."},
        {0.80, "Almost Ready..."},
        {1.0, "Done!"}
    }
    for _, step in ipairs(steps) do
        if progress >= step[1] then ProgText.Text = step[2] end
    end
    
    -- Каждый куб имеет свою фазу анимации
    for i, data in ipairs(cubes) do
        local part = data.part
        local startPos = data.startPos
        local phase = data.phase
        
        -- Цикл анимации как в CSS:
        -- 0-25%: движется из стартовой позиции в центр
        -- 25-52%: стоит в центре
        -- 52-80%: подпрыгивает вверх
        -- 80-100%: улетает вниз
        
        local cyclePos = (t + phase * 0.8) % 1.0
        local targetX, targetY, targetZ
        
        if cyclePos < 0.25 then
            -- Движение к центру (0-25%)
            local p = cyclePos / 0.25
            local ease = p * p * (3 - 2 * p) -- smoothstep
            targetX = startPos.X * (1 - ease)
            targetY = startPos.Y * (1 - ease)
            targetZ = startPos.Z * (1 - ease)
        elseif cyclePos < 0.52 then
            -- В центре (25-52%)
            targetX = 0
            targetY = 0
            targetZ = 0
        elseif cyclePos < 0.80 then
            -- Подскок вверх (52-80%)
            local p = (cyclePos - 0.52) / 0.28
            local bounce = -math.sin(p * math.pi) * 12 * (1 - p * 0.3)
            targetX = 0
            targetY = bounce
            targetZ = 0
        else
            -- Улетает вниз (80-100%)
            local p = (cyclePos - 0.80) / 0.20
            targetX = startPos.X * p * 1.2
            targetY = startPos.Y * p * 1.2 - 20 * p
            targetZ = startPos.Z * p * 1.2
        end
        
        part.Position = Vector3.new(targetX, targetY, targetZ)
        
        -- Вращение куба
        local rot = elapsed * data.rotSpeed * 0.5
        part.CFrame = CFrame.new(part.Position) *
            CFrame.Angles(rot, rot * 0.7, rot * 0.3)
        
        -- Свечение пульсирует
        local glow = part:FindFirstChildOfClass("PointLight")
        if glow then
            glow.Brightness = 1.5 + math.sin(elapsed * 1.2 + phase * 3) * 0.8
        end
        
        -- Прозрачность меняется при движении
        local distFromCenter = (part.Position - Vector3.zero).Magnitude
        part.Transparency = 0.1 + math.min(distFromCenter / 40, 0.5) * 0.4
    end
    
    -- Вращение камеры вокруг сцены
    local camAngle = elapsed * 0.04
    local camRadius = 55 + math.sin(elapsed * 0.1) * 5
    vpCam.CFrame = CFrame.new(
        math.sin(camAngle) * camRadius,
        3 + math.sin(elapsed * 0.08) * 2,
        math.cos(camAngle) * camRadius
    ) * CFrame.lookAt(Vector3.new(0, 0, 0))
    
    -- Анимация земли (появление/исчезновение)
    local groundProgress = math.min(1, (elapsed % 3) / 2)
    ground.Transparency = 0.8 - groundProgress * 0.6
    ground.Size = Vector3.new(30 + groundProgress * 10, 1, 30 + groundProgress * 10)
    
    if progress >= 1 and not isComplete then
        isComplete = true
        task.spawn(function()
            TweenService:Create(LS, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 1
            }):Play()
            TweenService:Create(Viewport, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 1
            }):Play()
            task.wait(0.6)
            LS:Destroy()
            BuildUI() -- Запускаем UI после загрузки
        end)
    end
end

-- Запускаем рендер-цикл
task.spawn(function()
    while LS.Parent and not isComplete do
        AnimateCubes()
        RunService.RenderStepped:Wait()
    end
end)

