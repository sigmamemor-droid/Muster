\t})
end

local function SetHubOpen(open)
\tif hubOpen == open then
\t\treturn
\tend

\thubOpen = open
\tSetToggleVisual(open)

\tif open then
\t\tEnsureHubPosition()
\t\tUpdateLayout()

\t\tHub.Visible = true
\t\tHubShadow.Visible = true

\t\tHub.Size = UDim2.fromOffset(hubSize.X, 0)
\t\tHubShadow.Size = UDim2.fromOffset(hubSize.X, 0)

\t\tTween(Hub, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
\t\t\tSize = UDim2.fromOffset(hubSize.X, hubSize.Y),
\t\t})

\t\tTween(HubShadow, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
\t\t\tSize = UDim2.fromOffset(hubSize.X, hubSize.Y),
\t\t})
\telse
\t\tlocal closingTween = Tween(Hub, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
\t\t\tSize = UDim2.fromOffset(hubSize.X, 0),
\t\t})

\t\tTween(HubShadow, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
\t\t\tSize = UDim2.fromOffset(hubSize.X, 0),
\t\t})

\t\tclosingTween.Completed:Connect(function()
\t\t\tif not hubOpen and Hub.Parent then
\t\t\t\tHub.Visible = false
\t\t\t\tHubShadow.Visible = false
\t\t\t\tHub.Size = UDim2.fromOffset(hubSize.X, hubSize.Y)
\t\t\t\tHubShadow.Size = UDim2.fromOffset(hubSize.X, hubSize.Y)
\t\t\tend
\t\tend)
\tend
end

