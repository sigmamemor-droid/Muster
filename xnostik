-- ============================================================

local espConn

local function startESP()
    if espConn then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            createESP(p)
        end
    end
    
    Players.PlayerAdded:Connect(function(p)
        if Features.PlayerESP or Features.MurdererESP or Features.SheriffESP then
            createESP(p)
        end
    end)
    
    Players.PlayerRemoving:Connect(function(p)
        clearESP(p)
    end)
    
    espConn = RunService.RenderStepped:Connect(function()
        local anyESP = Features.PlayerESP or Features.MurdererESP or Features.SheriffESP
        
        for player, data in pairs(ESPObjects) do
            if data and data.billboard then
                local role = data.role or "Unknown"
                local show = false
                
                if Features.PlayerESP then
                    show = true
                elseif Features.MurdererESP and role == "Murderer" then
                    show = true
                elseif Features.SheriffESP and role == "Sheriff" then
                    show = true
                end
                
                data.billboard.Enabled = show and (Features.NameTags or Features.DistanceESP)
                if data.nameLabel then
                    data.nameLabel.Visible = Features.NameTags
                end
                if data.distLabel then
                    data.distLabel.Visible = Features.DistanceESP
                end
                if data.highlight then
                    data.highlight.Enabled = show
                end
            end
        end
        
        updateTracers()
    end)
end

Config.Toggles.PlayerESP = function(state)
    Features.PlayerESP = state
    if state then startESP() end
end

Config.Toggles.MurdererESP = function(state)
    Features.MurdererESP = state
    if state then startESP() end
end

Config.Toggles.SheriffESP = function(state)
    Features.SheriffESP = state
    if state then startESP() end
end

