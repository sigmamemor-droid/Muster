local function LaunchUI()
    -- Fade in title
    TweenService:Create(TitleLabel, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0,
        Position = UDim2.new(0, 0, 0.5, -80)
    }):Play()
    
    TweenService:Create(SubtitleLabel, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0.3,
        Position = UDim2.new(0, 0, 0.5, -20)
    }):Play()
    
    -- Fade in progress bar
    TweenService:Create(ProgressBg, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
    
    -- Loading steps
    local steps = {0.15, 0.35, 0.55, 0.75, 0.90, 1.00}
    local messages = {
        "Initializing core systems...",
        "Loading modules...",
        "Establishing connections...",
        "Configuring interface...",
        "Applying settings...",
        "Ready to launch!"
    }
    
    for i, step in ipairs(steps) do
        SubtitleLabel.Text = messages[i]
        TweenService:Create(ProgressFill, TweenInfo.new(0.2), 
            {Size = UDim2.new(step, 0, 1, 0)}):Play()
        task.wait(0.25)
    end
    
    task.wait(0.3)
    
    -- Fade out everything
    local fadeTween = TweenService:Create(LoadingScreen, TweenInfo.new(0.5), 
        {BackgroundTransparency = 1})
    fadeTween:Play()
    
    TweenService:Create(TitleLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    TweenService:Create(SubtitleLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    TweenService:Create(ProgressBg, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
    
    task.wait(0.5)
    LoadingScreen:Destroy()
end
task.spawn(LaunchUI)

