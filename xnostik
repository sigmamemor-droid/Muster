local function markThemeRoles()
    local roles={bg=C.bg,sidebar=C.sidebar,surface=C.surface,elevated=C.elevated,accent=C.accent,accentLight=C.accentLight,white=C.white,text=C.text,textSec=C.textSec,textDim=C.textDim,red=C.red,redDark=C.redDark,border=C.border,hover=C.hover,selectedSurface=C.selectedSurface,shadow=C.shadow}
    for _,o in ipairs(ScreenGui:GetDescendants()) do
        for role,color in pairs(roles) do
            if o:IsA("GuiObject") and not string.match(o.Name, "^Accent_") and o.BackgroundColor3==color then o:SetAttribute("ThemeBackground",role) end
            if o:IsA("TextLabel") or o:IsA("TextButton") then if o.TextColor3==color then o:SetAttribute("ThemeText",role) end end
            if o:IsA("UIStroke") and o.Color==color then o:SetAttribute("ThemeStroke",role) end
        end
    end
end
local function applyTheme()
    local p=accentPalettes[chosenAccent]
    C.accent,C.accentLight,C.selectedSurface=p.accent,p.accentLight,p.selectedSurface
    if amoledEnabled then C.bg=Color3.fromRGB(0,0,0);C.sidebar=Color3.fromRGB(0,0,0);C.surface=Color3.fromRGB(5,5,5);C.elevated=Color3.fromRGB(12,12,12);C.border=Color3.fromRGB(43,43,43);C.hover=Color3.fromRGB(22,22,22) else C.bg=Color3.fromRGB(13,11,20);C.sidebar=Color3.fromRGB(8,7,13);C.surface=Color3.fromRGB(18,15,28);C.elevated=Color3.fromRGB(25,21,38);C.border=Color3.fromRGB(53,45,72);C.hover=Color3.fromRGB(32,27,47) end
    for _,o in ipairs(ScreenGui:GetDescendants()) do
        local r=o:GetAttribute("ThemeBackground");if r and C[r] and o:IsA("GuiObject") then o.BackgroundColor3=C[r] end
        r=o:GetAttribute("ThemeText");if r and C[r] and (o:IsA("TextLabel") or o:IsA("TextButton")) then o.TextColor3=C[r] end
        r=o:GetAttribute("ThemeStroke");if r and C[r] and o:IsA("UIStroke") then o.Color=C[r] end
    end
    local dotColors={Violet=Color3.fromRGB(140,65,245),Blue=Color3.fromRGB(45,135,255),Red=Color3.fromRGB(238,73,91),Green=Color3.fromRGB(47,202,132)}
    for name,b in pairs(accentButtons) do b.BackgroundColor3=dotColors[name]; b:FindFirstChild("Selection").Transparency=(name==chosenAccent and 0 or 1) end
    amoledFill.BackgroundColor3=amoledEnabled and C.accent or C.elevated
    amoledKnob.BackgroundColor3=amoledEnabled and C.white or C.textSec
    TweenService:Create(amoledKnob,TweenInfo.new(0.16),{Position=UDim2.new(0,amoledEnabled and 27 or 3,0.5,-8)}):Play()
end
local function applyLanguage()
    local t=lang[language]
    for _,def in ipairs(tabDefs) do
        def.title=t[def.name]
        local b=tabButtons[def.name]; b.Text=def.icon.."  "..def.title
    end
    local d
    for _,v in ipairs(tabDefs) do if v.name==currentTab then d=v break end end
    if d then PageTitle.Text=d.icon.." "..d.title end
    for key,label in pairs(settingsLabels) do label.Text=t[key] end
    for key,b in pairs(langButtons) do
        local selected = (key == language)
        b.TextColor3 = selected and C.accentLight or C.textSec
        b.BackgroundColor3 = selected and C.selectedSurface or C.elevated
        local stroke = b:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = selected and C.accentLight or C.border
            stroke.Transparency = selected and 0.15 or 0.55
        end
    end
end
local function applyScale()
    HubScale.Scale=menuScale;ShadowScale.Scale=menuScale
    scaleValue.Text=tostring(math.floor(menuScale*100+0.5)).."%"
end
markThemeRoles()
-- Apply Settings changes immediately, including on mobile taps.
refreshSettings = function()
    -- Защищаем основной интерфейс: ошибка отдельной настройки не ломает кнопку открытия.
    local ok, err = pcall(function()
        applyTheme()
        applyLanguage()
        applyScale()
    end)
    if not ok then warn("[MOBILE HUB / Settings] " .. tostring(err)) end
end

