local ui = {
    dark = true,
    mouseX = 0,
    mouseY = 0,
    activeTab = "Главная",
    notification = "Добро пожаловать!",
    pulse = 0
}

local colors = {
    dark = {
        bg = {0.055, 0.071, 0.11},
        sidebar = {0.075, 0.098, 0.15},
        card = {0.10, 0.13, 0.19},
        cardHover = {0.13, 0.17, 0.25},
        text = {0.92, 0.95, 1.0},
        muted = {0.52, 0.58, 0.69},
        accent = {0.38, 0.45, 1.0},
        success = {0.20, 0.83, 0.57},
        border = {0.18, 0.22, 0.31}
    },

    light = {
        bg = {0.94, 0.96, 0.99},
        sidebar = {1.0, 1.0, 1.0},
        card = {1.0, 1.0, 1.0},
        cardHover = {0.95, 0.97, 1.0},
        text = {0.10, 0.13, 0.20},
        muted = {0.40, 0.45, 0.55},
        accent = {0.30, 0.38, 0.95},
        success = {0.10, 0.67, 0.40},
        border = {0.84, 0.87, 0.92}
    }
}

local function palette()
    return ui.dark and colors.dark or colors.light
end

local function inside(x, y, w, h)
    return ui.mouseX >= x and ui.mouseX <= x + w
       and ui.mouseY >= y and ui.mouseY <= y + h
end

local function roundedRect(mode, x, y, w, h, r)
    love.graphics.rectangle(mode, x, y, w, h, r, r)
end

local function shadow(x, y, w, h, radius)
    love.graphics.setColor(0, 0, 0, 0.18)
    roundedRect("fill", x + 5, y + 7, w, h, radius)
end

local function text(value, x, y, font, color)
    love.graphics.setFont(font)
    love.graphics.setColor(color)
    love.graphics.print(value, x, y)
end

local function card(x, y, w, h, title, value, subtitle, accent)
    local c = palette()
    local hover = inside(x, y, w, h)

    shadow(x, y, w, h, 18)
    love.graphics.setColor(hover and c.cardHover or c.card)
    roundedRect("fill", x, y, w, h, 18)

    love.graphics.setColor(c.border)
    love.graphics.setLineWidth(1)
    roundedRect("line", x, y, w, h, 18)

    love.graphics.setColor(accent)
    roundedRect("fill", x + 20, y + 20, 8, 38, 4)

    text(title, x + 42, y + 19, fonts.small, c.muted)
    text(value, x + 20, y + 70, fonts.big, c.text)
    text(subtitle, x + 20, y + 123, fonts.small, c.muted)
end

local function button(x, y, w, h, label, active)
    local c = palette()
    local hover = inside(x, y, w, h)

    if active then
        love.graphics.setColor(c.accent)
    elseif hover then
        love.graphics.setColor(c.cardHover)
    else
        love.graphics.setColor(0, 0, 0, 0)
    end

    roundedRect("fill", x, y, w, h, 12)

    local labelColor = active and {1, 1, 1} or c.muted
    text(label, x + 18, y + 13, fonts.medium, labelColor)
end

function love.load()
    love.window.setTitle("Luna Dashboard")
    love.window.setMode(1180, 720, {
        resizable = false,
        vsync = 1
    })

    fonts = {
        title = love.graphics.newFont(28),
        big = love.graphics.newFont(30),
        medium = love.graphics.newFont(16),
        small = love.graphics.newFont(13),
        tiny = love.graphics.newFont(11)
    }

    love.graphics.setBackgroundColor(0.05, 0.05, 0.08)
end

function love.update(dt)
    ui.mouseX, ui.mouseY = love.mouse.getPosition()
    ui.pulse = ui.pulse + dt
end

function love.draw()
    local c = palette()
    local width, height = love.graphics.getDimensions()

    love.graphics.clear(c.bg)

    -- Левая навигационная панель
    love.graphics.setColor(c.sidebar)
    love.graphics.rectangle("fill", 0, 0, 250, height)

    love.graphics.setColor(c.border)
    love.graphics.setLineWidth(1)
    love.graphics.line(250, 0, 250, height)

    -- Логотип
    love.graphics.setColor(c.accent)
    roundedRect("fill", 28, 30, 42, 42, 13)

    text("L", 41, 37, fonts.title, {1, 1, 1})
    text("LUNA", 84, 34, fonts.title, c.text)
    text("Dashboard", 86, 66, fonts.small, c.muted)

    -- Меню
    text("МЕНЮ", 28, 130, fonts.tiny, c.muted)

    local tabs = {"Главная", "Аналитика", "Сообщения", "Настройки"}
    for i, tab in ipairs(tabs) do
        local y = 158 + (i - 1) * 54
        button(18, y, 214, 42, tab, ui.activeTab == tab)
    end

    -- Профиль
    love.graphics.setColor(c.border)
    love.graphics.line(28, 610, 222, 610)

    love.graphics.setColor(c.success)
    love.graphics.circle("fill", 49, 650, 20)

    text("Алексей", 82, 630, fonts.medium, c.text)
    text("Онлайн", 82, 653, fonts.small, c.success)

    -- Основной заголовок
    text("Добрый вечер, Алексей", 290, 42, fonts.title, c.text)
    text("Вот что происходит с вашими проектами сегодня.", 290, 80, fonts.medium, c.muted)

    -- Кнопка темы
    local themeX, themeY = 1030, 38
    local themeHover = inside(themeX, themeY, 108, 42)

    love.graphics.setColor(themeHover and c.cardHover or c.card)
    roundedRect("fill", themeX, themeY, 108, 42, 14)
    love.graphics.setColor(c.border)
    roundedRect("line", themeX, themeY, 108, 42, 14)

    text(ui.dark and "Светлая" or "Тёмная", themeX + 14, themeY + 13, fonts.small, c.text)

    -- Карточки статистики
    card(290, 140, 200, 170, "АКТИВНЫЕ ПРОЕКТЫ", "12", "+2 за неделю", c.accent)
    card(510, 140, 200, 170, "ВЫПОЛНЕНО ЗАДАЧ", "86%", "+14% к прошлому месяцу", c.success)
    card(730, 140, 200, 170, "ВХОДЯЩИЕ", "24", "8 непрочитанных", {0.96, 0.60, 0.25})
    card(950, 140, 190, 170, "ВРЕМЯ", "37ч", "На этой неделе", {0.76, 0.42, 0.95})

    -- Большая карточка прогресса
    shadow(290, 340, 540, 300, 18)
    love.graphics.setColor(c.card)
    roundedRect("fill", 290, 340, 540, 300, 18)
    love.graphics.setColor(c.border)
    roundedRect("line", 290, 340, 540, 300, 18)

    text("Прогресс по проектам", 315, 368, fonts.medium, c.text)
    text("Обзор текущих задач", 315, 394, fonts.small, c.muted)

    local projects = {
        {"Luna Mobile", 0.84, c.accent},
        {"Brand System", 0.62, {0.76, 0.42, 0.95}},
        {"Website 2026", 0.38, c.success}
    }

    for i, project in ipairs(projects) do
        local y = 445 + (i - 1) * 58
        local name, progress, color = project[1], project[2], project[3]

        text(name, 315, y, fonts.small, c.text)
        text(math.floor(progress * 100) .. "%", 754, y, fonts.small, c.muted)

        love.graphics.setColor(c.border)
        roundedRect("fill", 315, y + 26, 470, 10, 5)

        love.graphics.setColor(color)
        roundedRect("fill", 315, y + 26, 470 * progress, 10, 5)
    end

    -- Блок активности
    shadow(855, 340, 285, 300, 18)
    love.graphics.setColor(c.card)
    roundedRect("fill", 855, 340, 285, 300, 18)
    love.graphics.setColor(c.border)
    roundedRect("line", 855, 340, 285, 300, 18)

    text("Последняя активность", 880, 368, fonts.medium, c.text)

    local activity = {
        {"Новый комментарий", "в Luna Mobile", c.accent},
        {"Задача завершена", "Подготовить макеты", c.success},
        {"Приглашение", "в Brand System", {0.96, 0.60, 0.25}}
    }

    for i, item in ipairs(activity) do
        local y = 425 + (i - 1) * 67
        local pulse = 0.85 + math.sin(ui.pulse * 2 + i) * 0.15

        love.graphics.setColor(item[3][1], item[3][2], item[3][3], pulse)
        love.graphics.circle("fill", 892, y + 8, 6)

        text(item[1], 910, y - 3, fonts.small, c.text)
        text(item[2], 910, y + 18, fonts.tiny, c.muted)
    end

    -- Статус внизу
    text(ui.notification, 290, 675, fonts.small, c.muted)
end

function love.mousepressed(x, y, button)
    if button ~= 1 then
        return
    end

    local tabs = {"Главная", "Аналитика", "Сообщения", "Настройки"}

    for i, tab in ipairs(tabs) do
        local tabY = 158 + (i - 1) * 54

        if x >= 18 and x <= 232 and y >= tabY and y <= tabY + 42 then
            ui.activeTab = tab
            ui.notification = "Открыт раздел: " .. tab
        end
    end

    if x >= 1030 and x <= 1138 and y >= 38 and y <= 80 then
        ui.dark = not ui.dark
        ui.notification = ui.dark and "Включена тёмная тема" or "Включена светлая тема"
    end
end