local function SelectTab(tabId)
    for id, page in pairs(pages) do
        page.Visible = (id == tabId)
    end
    for id, btn in pairs(tabs) do
        local selected = (id == tabId)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = selected and C.card or C.sidebar,
        }):Play()
        local label = btn:FindFirstChild("TabLabel")
        local icon = btn:FindFirstChild("TabIcon")
        local bar = btn:FindFirstChild("Indicator")
        if label then
            TweenService:Create(label, TweenInfo.new(0.15), {
                TextColor3 = selected and C.text or C.textSec,
            }):Play()
        end
        if icon then
            TweenService:Create(icon, TweenInfo.new(0.15), {
                TextColor3 = selected and C.accent or C.textSec,
            }):Play()
        end
        if bar then bar.Visible = selected end
    end
end

