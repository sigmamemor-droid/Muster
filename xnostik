        -- Helper functions
        local function getPrimaryPart(model)
            if not model then return nil end
            if model.PrimaryPart then return model.PrimaryPart end
            local names = {"Handle","Main","Part","Base","Sparkler","Firework","Blade","Candle","Keyboard","Box","Decoy","Missile","Ladder","Blob","Ball","Crystal","Island","Ufo","Jukebox","Couch","Boombox","Snowflake","Diamond","Tractor","Pallet"}
            for _, n in ipairs(names) do
                local p = model:FindFirstChild(n, true)
                if p and p:IsA("BasePart") then return p end
            end
            for _, c in ipairs(model:GetDescendants()) do
                if c:IsA("BasePart") then return c end
            end
            return nil
        end

        local function findSpecificObjects(id)
            local list, seen = {}, {}
            local function add(model)
                if model and model:IsA("Model") and model.Name == id then
                    if not seen[model] then seen[model] = true; table.insert(list, model) end
                end
            end
            local myFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            if myFolder then
                for _, v in ipairs(myFolder:GetDescendants()) do add(v) end
                for _, v in ipairs(myFolder:GetChildren()) do add(v) end
            end
            for _, folder in ipairs(Workspace:GetChildren()) do
                if folder:IsA("Folder") or folder:IsA("Model") then
                    if string.find(folder.Name, "SpawnedInToys") or string.find(folder.Name, "Toys") then
                        for _, v in ipairs(folder:GetDescendants()) do add(v) end
                    end
                end
            end
            if #list == 0 then
                for _, v in ipairs(Workspace:GetDescendants()) do add(v) end
            end
            return list
        end

        local function attachPhysics(part)
            if not part then return nil, nil end
            local oldBG = part:FindFirstChildOfClass("BodyGyro")
            local oldBP = part:FindFirstChildOfClass("BodyPosition")
            if oldBG then oldBG:Destroy() end
            if oldBP then oldBP:Destroy() end
            local BP = Instance.new("BodyPosition")
            BP.P = 25000; BP.D = 400; BP.MaxForce = Vector3.new(1e10, 1e10, 1e10); BP.Parent = part
            local BG = Instance.new("BodyGyro")
            BG.P = 25000; BG.D = 400; BG.MaxTorque = Vector3.new(1e10, 1e10, 1e10); BG.Parent = part
            return BG, BP
        end

        -- ICBM CINEMATIC WORKFLOW
        -- A missile is remembered as soon as the player takes hold of it; no separate prepare step is needed.
        local Mouse = LocalPlayer:GetMouse()
        local function getAimDirection(origin)
            local camera = Workspace.CurrentCamera
            if not camera then return Vector3.yAxis end
            if selectedDevice == "PC" and Mouse and Mouse.Hit then
                local delta = Mouse.Hit.Position - origin
                if delta.Magnitude > 0.01 then return delta.Unit end
            end
            local viewport = camera.ViewportSize
            return camera:ViewportPointToRay(viewport.X * .5, viewport.Y * .5).Direction.Unit
        end

        local ICBM = {
            Rockets = {}, SelectedIndex = nil, FollowIndex = nil, OriginalCameraSubject = nil,
            OriginalCameraType = nil, Guidance = true, Speed = 40, AscentHeight = 180,
            ThirdPerson = true, MemoryConnection = nil
        }
        local CAMERA_BIND = "TRH_ICBM_ThirdPersonCamera"
        local selectICBM

        local function stopRocketCamera(restore)
            RunService:UnbindFromRenderStep(CAMERA_BIND)
            local camera = Workspace.CurrentCamera
            if restore and camera and ICBM.OriginalCameraSubject then
                camera.CameraType = ICBM.OriginalCameraType or Enum.CameraType.Custom
                camera.CameraSubject = ICBM.OriginalCameraSubject
            end
            ICBM.FollowIndex = nil
        end

        local function restoreRocket(rocket)
            if rocket.SelectionConnection then pcall(function() rocket.SelectionConnection:Disconnect() end) end
            if rocket.FlightConnection then pcall(function() rocket.FlightConnection:Disconnect() end) end
            if rocket.Gyro then pcall(function() rocket.Gyro:Destroy() end) end
            if rocket.Position then pcall(function() rocket.Position:Destroy() end) end
            if rocket.Velocity then pcall(function() rocket.Velocity:Destroy() end) end
            for part, state in pairs(rocket.PartStates or {}) do
                if part and part.Parent then
                    part.CanCollide, part.CanTouch, part.Anchored = state.CanCollide, state.CanTouch, state.Anchored
                    part.CFrame = state.CFrame
                    part.AssemblyLinearVelocity, part.AssemblyAngularVelocity = state.LinearVelocity, state.AngularVelocity
                end
            end
        end

        local function resetICBM()
            stopRocketCamera(true)
            for index, rocket in ipairs(ICBM.Rockets) do
                restoreRocket(rocket)
                rocket.Active, rocket.Selected, rocket.FlightConnection, rocket.Gyro, rocket.Position, rocket.Velocity = false, false, nil, nil, nil, nil
                if rocket.Part and rocket.Part.Parent then
                    rocket.SelectionConnection = rocket.Part.Touched:Connect(function(hit)
                        local character = LocalPlayer.Character
                        if not rocket.Active and character and hit:IsDescendantOf(character) then selectICBM(rocket, index) end
                    end)
                end
            end
            ICBM.SelectedIndex = nil
            ICBM.OriginalCameraSubject, ICBM.OriginalCameraType = nil, nil
            OrionLib:MakeNotification({Name = "ICBM reset", Content = "Rockets and camera restored. Pick up a remembered rocket and launch again.", Time = 4})
        end

        local function followRocket(index)
            local rocket, camera = ICBM.Rockets[index], Workspace.CurrentCamera
            if not rocket or not rocket.Active or not rocket.Part or not rocket.Part.Parent or not camera then
                OrionLib:MakeNotification({Name = "ICBM camera", Content = "Launch this remembered rocket first.", Time = 3})
                return
            end
            if not ICBM.OriginalCameraSubject then
                ICBM.OriginalCameraSubject, ICBM.OriginalCameraType = camera.CameraSubject, camera.CameraType
            end
            ICBM.FollowIndex = index
            if not ICBM.ThirdPerson then
                RunService:UnbindFromRenderStep(CAMERA_BIND)
                camera.CameraSubject, camera.CameraType = rocket.Part, Enum.CameraType.Custom
                return
            end
            camera.CameraType = Enum.CameraType.Scriptable
            RunService:BindToRenderStep(CAMERA_BIND, Enum.RenderPriority.Camera.Value + 1, function()
                if not rocket.Part or not rocket.Part.Parent then stopRocketCamera(true); return end
                local part = rocket.Part
                local velocityDirection = part.AssemblyLinearVelocity.Magnitude > 1 and part.AssemblyLinearVelocity.Unit or part.CFrame.LookVector
                local lookDirection = velocityDirection.Magnitude > .01 and velocityDirection or part.CFrame.LookVector
                local cameraPosition = part.Position - lookDirection * 18 + Vector3.new(0, 7, 0)
                camera.CFrame = CFrame.lookAt(cameraPosition, part.Position + lookDirection * 12)
                camera.Focus = CFrame.new(part.Position)
            end)
            OrionLib:MakeNotification({Name = "ICBM camera", Content = "Third-person tracking enabled for rocket " .. index .. ".", Time = 3})
        end

        selectICBM = function(rocket, index)
            if rocket.Active then return end
            ICBM.SelectedIndex = index
            for i, other in ipairs(ICBM.Rockets) do other.Selected = (i == index) end
            OrionLib:MakeNotification({Name = "ICBM remembered", Content = "Rocket " .. index .. " is saved. Put it down, then press LAUNCH.", Time = 4})
        end

        local function rememberRocket(model)
            if not model or not model.Parent or (model.Name ~= "FireworkMissile" and model.Name ~= "BombMissile") then return end
            for _, rocket in ipairs(ICBM.Rockets) do if rocket.Model == model then return end end
            if #ICBM.Rockets >= 5 then return end
            local part = getPrimaryPart(model)
            if not part then return end
            local rocket = {Model = model, Part = part, Active = false, Selected = false, PartStates = {}}
            table.insert(ICBM.Rockets, rocket)
            local index = #ICBM.Rockets
            rocket.SelectionConnection = part.Touched:Connect(function(hit)
                local character = LocalPlayer.Character
                if rocket.Active or not character or not hit:IsDescendantOf(character) then return end
                selectICBM(rocket, index)
            end)
        end
        local function syncRocketMemory()
            for _, model in ipairs(findSpecificObjects("FireworkMissile")) do rememberRocket(model) end
            for _, model in ipairs(findSpecificObjects("BombMissile")) do rememberRocket(model) end
        end
        -- New missiles are armed for memory automatically, including ones spawned after the panel opens.
        ICBM.MemoryConnection = Workspace.DescendantAdded:Connect(function(item)
            if item:IsA("Model") and (item.Name == "FireworkMissile" or item.Name == "BombMissile") then task.defer(rememberRocket, item) end
        end)
        syncRocketMemory()

        local function launchICBM()
            local index, rocket = ICBM.SelectedIndex, ICBM.SelectedIndex and ICBM.Rockets[ICBM.SelectedIndex]
            if not rocket or rocket.Active or not rocket.Part or not rocket.Part.Parent then
                OrionLib:MakeNotification({Name = "ICBM", Content = "Pick up a rocket first — it will be remembered automatically.", Time = 4})
                return
            end
            local part, model = rocket.Part, rocket.Model
            rocket.Active, rocket.Selected, rocket.StartPosition = true, false, part.Position
            if rocket.SelectionConnection then rocket.SelectionConnection:Disconnect(); rocket.SelectionConnection = nil end
            for _, descendant in ipairs(model:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    rocket.PartStates[descendant] = {CanCollide = descendant.CanCollide, CanTouch = descendant.CanTouch, Anchored = descendant.Anchored, CFrame = descendant.CFrame, LinearVelocity = descendant.AssemblyLinearVelocity, AngularVelocity = descendant.AssemblyAngularVelocity}
                    descendant.Anchored = false; descendant.CanCollide = false
                    pcall(function() descendant:SetNetworkOwner(LocalPlayer) end)
                end
            end
            rocket.Gyro, rocket.Position = attachPhysics(part)
            if not rocket.Gyro or not rocket.Position then
                rocket.Active = false
                OrionLib:MakeNotification({Name = "ICBM", Content = "Could not control this rocket.", Time = 3})
                return
            end
            -- A velocity controller, rather than a moving position target, keeps flight at exactly 40 studs/second.
            rocket.Position:Destroy(); rocket.Position = nil
            rocket.Velocity = Instance.new("BodyVelocity")
            rocket.Velocity.MaxForce = Vector3.new(1e10, 1e10, 1e10)
            rocket.Velocity.P = 25000
            rocket.Velocity.Parent = part
            ICBM.SelectedIndex = nil
            rocket.FlightConnection = RunService.Heartbeat:Connect(function(dt)
                if not part.Parent then if rocket.FlightConnection then rocket.FlightConnection:Disconnect() end; return end
                local climbed = part.Position.Y - rocket.StartPosition.Y >= ICBM.AscentHeight
                local direction = climbed and getAimDirection(part.Position) or Vector3.yAxis
                if climbed and not ICBM.Guidance then direction = part.CFrame.LookVector end
                -- Design rule: this mode always flies at one predictable speed — 40.
                rocket.Velocity.Velocity = direction * 40
                rocket.Gyro.CFrame = CFrame.lookAt(part.Position, part.Position + direction)
            end)
            OrionLib:MakeNotification({Name = "ICBM launched", Content = "Rocket " .. index .. " launched at fixed speed 40. Select it in Camera to watch.", Time = 4})
        end

        -- Hand System
        local HandSystem = { Enabled = false, Assigned = {}, LoopConn = nil, Time = 0, Config = { Height = 4, Radius = 6, Speed = 0.8, FollowPlayer = true } }

        local function stopHand()
            if HandSystem.LoopConn then HandSystem.LoopConn:Disconnect(); HandSystem.LoopConn = nil end
            for _, toy in ipairs(HandSystem.Assigned) do
                if toy.BG then pcall(function() toy.BG:Destroy() end) end
                if toy.BP then pcall(function() toy.BP:Destroy() end) end
                if toy.Model then
                    for _, p in ipairs(toy.Model:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = true; p.CanTouch = true end
                    end
                end
            end
            HandSystem.Assigned = {}
            HandSystem.Enabled = false
        end

        local function startHand()
            stopHand()
            local ladders = findSpecificObjects("LadderLightBrown")
            local pallets = findSpecificObjects("PalletLightBrown")
            if #ladders < 5 then
                OrionLib:MakeNotification({Name = T("notifHandFail"), Content = T("notifHandFailLadder") .. #ladders .. ")", Time = 4})
                return
            end
            if #pallets < 1 then
                OrionLib:MakeNotification({Name = T("notifHandFail"), Content = T("notifHandFailPallet"), Time = 4})
                return
            end
            local palletModel = pallets[1]
            local palletPart = getPrimaryPart(palletModel)
            if palletPart then
                for _, p in ipairs(palletModel:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = false; p.CanTouch = false; p.Anchored = false
                        pcall(function() p:SetNetworkOwner(LocalPlayer) end)
                    end
                end
                local BG, BP = attachPhysics(palletPart)
                if BG and BP then
                    table.insert(HandSystem.Assigned, {BG = BG, BP = BP, Part = palletPart, Model = palletModel, IsPallet = true, FingerIndex = 0})
                end
            end
            for i = 1, 5 do
                local model = ladders[i]
                local part = getPrimaryPart(model)
                if part then
                    for _, p in ipairs(model:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.CanCollide = false; p.CanTouch = false; p.Anchored = false
                            pcall(function() p:SetNetworkOwner(LocalPlayer) end)
                        end
                    end
                    local BG, BP = attachPhysics(part)
                    if BG and BP then
                        table.insert(HandSystem.Assigned, {BG = BG, BP = BP, Part = part, Model = model, IsPallet = false, FingerIndex = i})
                    end
                end
            end
            HandSystem.Enabled = true
            HandSystem.Time = 0
            HandSystem.LoopConn = RunService.RenderStepped:Connect(function(dt)
                if not HandSystem.Enabled or not LocalPlayer.Character then return end
                local torso = LocalPlayer.Character:FindFirstChild("Torso") or LocalPlayer.Character:FindFirstChild("UpperTorso")
                if not torso then return end
                HandSystem.Time = HandSystem.Time + dt
                local center = torso.Position
                local baseHeight = HandSystem.Config.Height
                local radius = HandSystem.Config.Radius
                local t = HandSystem.Time
                for _, toy in ipairs(HandSystem.Assigned) do
                    if toy.BP and toy.BG and toy.Part and toy.Part.Parent then
                        if toy.IsPallet then
                            local target = center + Vector3.new(0, baseHeight + 1.2, -1.5)
                            toy.BP.Position = target
                            toy.BG.CFrame = CFrame.new(target) * CFrame.Angles(math.rad(-15), 0, 0)
                        else
                            local fi = toy.FingerIndex
                            local spread = 1.15
                            local fingerAngle = (fi - 3) * (spread / 4)
                            local progress = 0.35 + (fi % 2) * 0.08
                            local len = radius * (0.9 + progress * 0.4)
                            local curve = math.sin(progress * math.pi) * 1.8
                            local fx = math.sin(fingerAngle) * len * 0.7
                            local fz = -math.cos(fingerAngle) * len * 0.55 - 1.2
                            local fy = baseHeight + 1.8 + progress * 3.8 + curve + math.sin(t * 1.3 + fi) * 0.25
                            local target = center + Vector3.new(fx, fy, fz)
                            local tilt = 0.75 - progress * 0.25
                            local upright = math.clamp(tilt, 0, 1.2) / 1.2
                            local pitch = math.rad(90 * (1 - upright))
                            local cf = CFrame.new(target) * CFrame.Angles(0, fingerAngle + math.pi, 0) * CFrame.Angles(pitch, 0, 0)
                            toy.BP.Position = target
                            toy.BG.CFrame = cf
                        end
                    end
                end
            end)
            OrionLib:MakeNotification({Name = T("notifHandDone"), Content = T("notifHandDoneMsg"), Time = 4})
        end

        -- Rotator System
        local function createRotator(nameKey)
            local self = {
                Name = T(nameKey), CurrentObjectID = "FireworkSparkler",
                Config = {
                    Enabled = false, Mode = "shapeCircle", ObjectCount = 100, Radius = 10,
                    Height = 4, Speed = 1.8, Pulse = 0.6, FollowPlayer = true, AimAtSight = false, FaceCenter = true,
                    LadderH1 = 5.5, LadderH2 = 2.0, LadderH3 = 3.4, LadderH4 = 1.6,
                    HandCount = 5, FingerCount = 5, FingerSpread = 1.1,
                    DualMode = "dualCircleSpoke", DualDistance = 8,
                },
                Assigned = {}, LoopConn = nil, Time = 0,
            }

            local function findObjects()
                local toys, seen = {}, {}
                local function add(model)
                    if model and model:IsA("Model") and model.Name == self.CurrentObjectID then
                        if not seen[model] then seen[model] = true; table.insert(toys, model) end
                    end
                end
                local myFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                if myFolder then
                    for _, v in ipairs(myFolder:GetDescendants()) do add(v) end
                    for _, v in ipairs(myFolder:GetChildren()) do add(v) end
                end
                for _, folder in ipairs(Workspace:GetChildren()) do
                    if folder:IsA("Folder") or folder:IsA("Model") then
                        if string.find(folder.Name, "SpawnedInToys") or string.find(folder.Name, "Toys") then
                            for _, v in ipairs(folder:GetDescendants()) do add(v) end
                        end
                    end
                end
                if #toys == 0 then
                    for _, v in ipairs(Workspace:GetDescendants()) do add(v) end
                end
                return toys
            end

            local function stopLoop()
                if self.LoopConn then self.LoopConn:Disconnect(); self.LoopConn = nil end
                for _, toy in ipairs(self.Assigned) do
                    if toy.BG then pcall(function() toy.BG:Destroy() end) end
                    if toy.BP then pcall(function() toy.BP:Destroy() end) end
                    if toy.Model then
                        for _, p in ipairs(toy.Model:GetDescendants()) do
                            if p:IsA("BasePart") then p.CanCollide = true; p.CanTouch = true end
                        end
                    end
                end
                self.Assigned = {}
            end

            local function startLoop()
                if self.LoopConn then self.LoopConn:Disconnect() end
                self.Time = 0
                self.LoopConn = RunService.RenderStepped:Connect(function(dt)
                    if not self.Config.Enabled or not LocalPlayer.Character then return end
                    local torso = LocalPlayer.Character:FindFirstChild("Torso") or LocalPlayer.Character:FindFirstChild("UpperTorso")
                    if not torso then return end
                    self.Time = self.Time + dt
                    local center = torso.Position
                    if self.Config.AimAtSight then
                        center = getAimPoint(center)
                    elseif not self.Config.FollowPlayer then
                        self.AnchorPosition = self.AnchorPosition or center
                        center = self.AnchorPosition
                    else
                        self.AnchorPosition = nil
                    end
                    local shapeFunc = Shapes[self.Config.Mode]
                    if not shapeFunc then return end
                    local count = #self.Assigned
                    for i, toy in ipairs(self.Assigned) do
                        if toy.BP and toy.BG and toy.Part and toy.Part.Parent then
                            local result = {shapeFunc(i, count, self.Time, self.Config)}
                            local offset = result[1]
                            local target = center + offset
                            toy.BP.Position = target
                            if self.Config.Mode == "shapeLadderArray" or self.Config.Mode == "shapeLadderArrayBoost"
                            or self.Config.Mode == "shapeGiantHand" or self.Config.Mode == "shapeGiantHandDense" then
                                local tilt = result[2] or 1
                                local angle = result[3] or 0
                                local upright = math.clamp(tilt, 0, 1.5) / 1.5
                                local pitch = math.rad(90 * (1 - upright))
                                toy.BG.CFrame = CFrame.new(target) * CFrame.Angles(0, angle + math.pi/2, 0) * CFrame.Angles(pitch, 0, 0)
                            else
                                if self.Config.FaceCenter then
                                    toy.BG.CFrame = CFrame.lookAt(target, center)
                                else
                                    toy.BG.CFrame = CFrame.new(target)
                                end
                            end
                        end
                    end
                end)
            end

            local function applyToys()
                stopLoop()
                local toys = findObjects()
                local max = math.min(#toys, self.Config.ObjectCount)
                self.Assigned = {}
                for i = 1, max do
                    local model = toys[i]
                    local part = getPrimaryPart(model)
                    if part then
                        for _, p in ipairs(model:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.CanCollide = false; p.CanTouch = false; p.Anchored = false
                                pcall(function() p:SetNetworkOwner(LocalPlayer) end)
                            end
                        end
                        local BG, BP = attachPhysics(part)
                        if BG and BP then
                            table.insert(self.Assigned, {BG = BG, BP = BP, Part = part, Model = model})
                        end
                    end
                end
                if self.Config.Enabled and #self.Assigned > 0 then startLoop() end
                return #self.Assigned, #toys
            end

