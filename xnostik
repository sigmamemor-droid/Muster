local tabPages, tabBtns, currentTab = {}, {}, nil
local CX, CY, CW, CH = SIDEBAR_W + 1, 32, HUB_W - SIDEBAR_W - 1, HUB_H - 32

-- Tab definitions without emojis
local tabDefs = {
    {name = "Home", key = "home", order = 1},
    {name = "Combat", key = "combat", order = 2},
    {name = "ESP", key = "esp", order = 3},
    {name = "Fun & Troll", key = "fun", order = 4},
    {name = "Boombox", key = "boombox", order = 5},
    {name = "Nexus", key = "nexus", order = 6},
    {name = "Settings", key = "settings", order = 7},
    {name = "Info", key = "info", order = 8},
}

local function ResizeMenu(newW, newH)
    HUB_W, HUB_H = newW, newH
    Hub.Size = UDim2.new(0, HUB_W, 0, HUB_H)
    TopB.Size = UDim2.new(1, -SIDEBAR_W, 0, 32)
    Watermark.Size = UDim2.new(1, -SIDEBAR_W, 1, 0)
    
    local pageW = HUB_W - SIDEBAR_W - 1
    local pageH = HUB_H - 32
    for _, pageData in pairs(tabPages) do
        pageData.frame.Size = UDim2.new(0, pageW, 0, pageH)
    end
end

for idx, def in ipairs(tabDefs) do
    local Page = Instance.new("ScrollingFrame")
    Page.Name = "Page_" .. def.name
    Page.Size = UDim2.new(0, CW, 0, CH)
    Page.Position = UDim2.new(0, CX, 0, CY)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = C.accent
    Page.Visible = false
    Page.Parent = Hub
    table.insert(themedAccent, Page)
    
    local PL = Instance.new("UIListLayout")
    PL.Parent = Page
    PL.SortOrder = Enum.SortOrder.LayoutOrder
    PL.Padding = UDim.new(0, 4)
    
    local PP = Instance.new("UIPadding")
    PP.PaddingTop = UDim.new(0, 4)
    PP.PaddingBottom = UDim.new(0, 8)
    PP.PaddingLeft = UDim.new(0, 6)
    PP.PaddingRight = UDim.new(0, 6)
    PP.Parent = Page
    
    tabPages[def.name] = {frame = Page, oc = 0}
    
    -- Neumorphic pill button
    local Tb = Instance.new("TextButton")
    Tb.Size = UDim2.new(1, -6, 0, 28)
    Tb.BackgroundTransparency = 1
    Tb.Text = def.name  -- Just name, no emoji
    Tb.TextColor3 = C.textDim
    Tb.TextSize = 10
    Tb.Font = Enum.Font.GothamBold
    Tb.AutoButtonColor = false
    Tb.ZIndex = 15
    Tb.Parent = TabInner
    Instance.new("UICorner", Tb).CornerRadius = UDim.new(0, 10)
    table.insert(globalTextObjects, Tb)
    
    local TbStroke = Instance.new("UIStroke")
    TbStroke.Color = C.accent
    TbStroke.Thickness = 1.5
    TbStroke.Transparency = 1
    TbStroke.Parent = Tb
    
    if def.name == "Nexus" then 
        Tb.TextColor3 = C.gold 
    end
    
    tabBtns[def.name] = {btn = Tb, index = idx, label = def.name, stroke = TbStroke}
    
    -- Hover effects
    Tb.MouseEnter:Connect(function()
        if currentTab == def.name then return end
        TweenService:Create(Tb, TweenInfo.new(0.12), {BackgroundTransparency = 0.7}):Play()
        TweenService:Create(TbStroke, TweenInfo.new(0.12), {Transparency = 0.5}):Play()
        TweenService:Create(Tb, TweenInfo.new(0.12), {
            TextColor3 = (def.name == "Nexus") and C.gold or C.textSec
        }):Play()
    end)
    
    Tb.MouseLeave:Connect(function()
        if currentTab == def.name then return end
        TweenService:Create(Tb, TweenInfo.new(0.12), {BackgroundTransparency = 1}):Play()
        TweenService:Create(TbStroke, TweenInfo.new(0.12), {Transparency = 1}):Play()
        TweenService:Create(Tb, TweenInfo.new(0.12), {
            TextColor3 = (def.name == "Nexus") and C.gold or C.textDim
        }):Play()
    end)
    
    -- Click handler
    Tb.MouseButton1Click:Connect(function()
        if currentTab == def.name then return end
        
        -- Press animation
        local origSize = UDim2.new(1, -6, 0, 28)
        TweenService:Create(Tb, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), 
            {Size = UDim2.new(0.94, -6, 0, 26)}):Play()
        task.delay(0.05, function()
            TweenService:Create(Tb, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), 
                {Size = origSize}):Play()
        end)
        
        -- Deactivate previous tab
        if currentTab and tabPages[currentTab] then
            tabPages[currentTab].frame.Visible = false
            local prevBtn = tabBtns[currentTab].btn
            local prevStroke = tabBtns[currentTab].stroke
            TweenService:Create(prevBtn, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
            TweenService:Create(prevStroke, TweenInfo.new(0.15), {Transparency = 1}):Play()
            prevBtn.TextColor3 = (currentTab == "Nexus") and C.gold or C.textDim
        end
        
        -- Activate new tab
        currentTab = def.name
        Page.Visible = true
        PT.Text = def.name
        updateableLabels[PT] = def.key
        
        Tb.TextColor3 = C.accentLight
        TweenService:Create(Tb, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        TweenService:Create(TbStroke, TweenInfo.new(0.15), {Transparency = 0}):Play()
        TbStroke.Color = C.accent
        
        -- Slide glider
        local targetY = 3 + (idx - 1) * 31
        TweenService:Create(TabGlider, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), 
            {Position = UDim2.new(0, 0, 0, targetY)}):Play()
    end)
end

