refreshSettings = function()
    pcall(function()
        local p = accentPalettes[chosenAccent]
        AppC.accent, AppC.accentLight, AppC.selectedSurface = p.accent, p.accentLight, p.selectedSurface

        if amoledEnabled then
            AppC.bg = Color3.fromRGB(0, 0, 0)
            AppC.sidebar = Color3.fromRGB(0, 0, 0)
            AppC.surface = Color3.fromRGB(8, 8, 8)
            AppC.elevated = Color3.fromRGB(15, 15, 15)
        else
            AppC.bg = Color3.fromRGB(12, 14, 22)
            AppC.sidebar = Color3.fromRGB(8, 10, 16)
            AppC.surface = Color3.fromRGB(20, 24, 38)
            AppC.elevated = Color3.fromRGB(28, 34, 52)
        end

        Hub.BackgroundColor3 = AppC.bg
        Sidebar.BackgroundColor3 = AppC.sidebar
        TabGlider.BackgroundColor3 = AppC.selectedSurface
        GliderLine.BackgroundColor3 = AppC.accent

        for name, b in pairs(accentButtons) do
            local sel = b:FindFirstChild("Selection")
            if sel then sel.Transparency = (name == chosenAccent and 0 or 1) end
        end

        if amoledFill then amoledFill.BackgroundColor3 = amoledEnabled and AppC.accent or AppC.elevated end
        if amoledKnob then
            amoledKnob.BackgroundColor3 = amoledEnabled and AppC.white or AppC.textSec
            TweenService:Create(amoledKnob, TweenInfo.new(0.2), {Position = UDim2.new(0, amoledEnabled and 25 or 3, 0.5, -9)}):Play()
        end

        local t = lang[language]
        for _, def in ipairs(tabDefs) do
            def.title = t[def.name]
            local b = tabButtons[def.name]
            if b then b.Text = "   " .. def.icon .. "  " .. def.title end
        end
        for k, lbl in pairs(settingsLabels) do
            if t[k] then lbl.Text = t[k] end
        end
        langButtons.RU.BackgroundColor3 = language == "RU" and AppC.accent or AppC.elevated
        langButtons.EN.BackgroundColor3 = language == "EN" and AppC.accent or AppC.elevated
        langButtons.RU.TextColor3 = language == "RU" and AppC.white or AppC.textDim
        langButtons.EN.TextColor3 = language == "EN" and AppC.white or AppC.textDim
    end)
end

