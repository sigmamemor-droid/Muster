---------------------------------------------------------
local betaState = {
    wings = false,
    aura = false,
    wingSpeed = 3,
    wingFolder = nil,
    auraHighlight = nil,
    auraParticles = nil,
    auraLight = nil,
    conn = nil
}

local function RemoveWings()
    if betaState.wingFolder then
        betaState.wingFolder:Destroy()
        betaState.wingFolder = nil
    end
end

local function RemoveAura()
    if betaState.auraHighlight then betaState.auraHighlight:Destroy() betaState.auraHighlight = nil end
    if betaState.auraParticles then betaState.auraParticles:Destroy() betaState.auraParticles = nil end
    if betaState.auraLight then betaState.auraLight:Destroy() betaState.auraLight = nil end
end

local function CreateWingPart(parent, size, cframe)
    local p = Instance.new("Part")
    p.Size = size
    p.CFrame = cframe
    p.Color = AppC.accent
    p.Material = Enum.Material.Neon
    p.CanCollide = false
    p.Massless = true
    p.CastShadow = false
    p.Parent = parent
    return p
end

local function ApplyWings()
    RemoveWings()
    if not betaState.wings then return end

    local char = player.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if not torso then return end

    local folder = Instance.new("Folder")
    folder.Name = "MidnightWings"
    folder.Parent = char
    betaState.wingFolder = folder

    local leftRoot = Instance.new("Part")
    leftRoot.Size = Vector3.new(0.1,0.1,0.1)
    leftRoot.Transparency = 1
    leftRoot.CanCollide = false
    leftRoot.Massless = true
    leftRoot.Parent = folder

    local rightRoot = Instance.new("Part")
    rightRoot.Size = Vector3.new(0.1,0.1,0.1)
    rightRoot.Transparency = 1
    rightRoot.CanCollide = false
    rightRoot.Massless = true
    rightRoot.Parent = folder

    local wL = Instance.new("Weld")
    wL.Part0 = torso
    wL.Part1 = leftRoot
    wL.C0 = CFrame.new(-0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(-15), 0)
    wL.Parent = leftRoot

    local wR = Instance.new("Weld")
    wR.Part0 = torso
    wR.Part1 = rightRoot
    wR.C0 = CFrame.new(0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(15), 0)
    wR.Parent = rightRoot

    for i = 1, 4 do
        local scale = 1 - (i * 0.15)
        local lBlade = CreateWingPart(folder, Vector3.new(0.1, 1.8 * scale, 0.4 * scale), CFrame.identity)
        local rBlade = CreateWingPart(folder, Vector3.new(0.1, 1.8 * scale, 0.4 * scale), CFrame.identity)

        local w1 = Instance.new("Weld")
        w1.Part0 = leftRoot
        w1.Part1 = lBlade
        w1.C0 = CFrame.new(-i * 0.35, i * 0.1, -i * 0.1) * CFrame.Angles(0, 0, math.rad(25 + i * 12))
        w1.Parent = lBlade

        local w2 = Instance.new("Weld")
        w2.Part0 = rightRoot
        w2.Part1 = rBlade
        w2.C0 = CFrame.new(i * 0.35, i * 0.1, -i * 0.1) * CFrame.Angles(0, 0, math.rad(-(25 + i * 12)))
        w2.Parent = rBlade
    end

    betaState.leftWeld = wL
    betaState.rightWeld = wR
end

local function ApplyAura()
    RemoveAura()
    if not betaState.aura then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hl = Instance.new("Highlight")
    hl.Name = "MidnightAuraHL"
    hl.FillColor = AppC.accent
    hl.OutlineColor = AppC.white
    hl.FillTransparency = 0.65
    hl.OutlineTransparency = 0.2
    hl.Adornee = char
    hl.Parent = char
    betaState.auraHighlight = hl

    local pe = Instance.new("ParticleEmitter")
    pe.Name = "MidnightAuraParticles"
    pe.Color = ColorSequence.new(AppC.accent, AppC.white)
    pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0)})
    pe.Texture = "rbxassetid://242200285"
    pe.Lifetime = NumberRange.new(0.8, 1.4)
    pe.Rate = 20
    pe.Speed = NumberRange.new(1.5, 3.5)
    pe.VelocitySpread = 180
    pe.Parent = hrp
    betaState.auraParticles = pe

    local pl = Instance.new("PointLight")
    pl.Color = AppC.accent
    pl.Range = 12
    pl.Brightness = 2.5
    pl.Parent = hrp
    betaState.auraLight = pl
end

if not betaState.conn then
    betaState.conn = RunService.RenderStepped:Connect(function()
        if betaState.wings and betaState.leftWeld and betaState.rightWeld and betaState.leftWeld.Parent and betaState.rightWeld.Parent then
            local flap = math.sin(tick() * betaState.wingSpeed) * 0.25
            betaState.leftWeld.C0 = CFrame.new(-0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(-15) - flap, flap * 0.5)
            betaState.rightWeld.C0 = CFrame.new(0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(15) + flap, -flap * 0.5)
        end
    end)
end

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    if betaState.wings then ApplyWings() end
    if betaState.aura then ApplyAura() end
end)

