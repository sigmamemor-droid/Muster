---------------------------------------------------------
local LoadingScreen = Instance.new("Frame")
LoadingScreen.Size = UDim2.new(1, 0, 1, 0)
LoadingScreen.BackgroundColor3 = Color3.fromRGB(9, 10, 15)
LoadingScreen.ZIndex = 100
LoadingScreen.Parent = ScreenGui

for i = 1, 100 do
    local size = math.random(1, 3)
    local Star = Instance.new("Frame")
    Star.Size = UDim2.new(0, size, 0, size)
    Star.Position = UDim2.new(math.random(), 0, math.random(), 0)
    Star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Star.BackgroundTransparency = math.random() * 0.7
    Star.BorderSizePixel = 0
    Star.ZIndex = 101
    Star.Parent = LoadingScreen
    Instance.new("UICorner", Star).CornerRadius = UDim.new(1, 0)
    
    local speed = (0.001 * (50 / size)) / 100
    task.spawn(function()
        while LoadingScreen.Parent do
            local newY = Star.Position.Y.Scale + speed
            if newY > 1 then newY = -0.05 end
            Star.Position = UDim2.new(Star.Position.X.Scale, 0, newY, 0)
            task.wait(0.03)
        end
    end)
end

