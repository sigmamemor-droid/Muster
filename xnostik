-- FRIEND FINDER — Roblox Studio (безопасная версия)
--
-- УСТАНОВКА
-- 1) В ReplicatedStorage создай RemoteFunction: FriendLookup
-- 2) В ReplicatedStorage создай RemoteEvent: JoinFriendServer
-- 3) Блок SERVER помести в ServerScriptService как Script.
-- 4) Блок CLIENT помести в StarterPlayer > StarterPlayerScripts как LocalScript.
--
-- Ограничения Roblox: присутствие и переход доступны только для друзей и
-- только если Roblox возвращает доступный PlaceId + JobId. Приватные серверы
-- и приватность чужого профиля этот код не обходит.

-- ================================================================
-- SERVER: ServerScriptService/FriendFinderServer
-- ================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local lookupFunction = ReplicatedStorage:WaitForChild("FriendLookup")
local joinEvent = ReplicatedStorage:WaitForChild("JoinFriendServer")

local function cleanUsername(value)
	if typeof(value) ~= "string" then return nil end
	value = value:match("^%s*(.-)%s*$")
	if #value < 3 or #value > 20 or not value:match("^[%w_]+$") then
		return nil
	end
	return value
end

local function getFriendPresence(player, targetId)
	local ok, friends = pcall(function()
		return player:GetFriendsOnline(200)
	end)
	if not ok then return nil end
	for _, friend in ipairs(friends) do
		if friend.UserId == targetId then
			return friend
		end
	end
	return nil
end

local function isFriend(player, targetId)
	local ok, result = pcall(function()
		return player:IsFriendsWith(targetId)
	end)
	return ok and result == true
end

lookupFunction.OnServerInvoke = function(player, rawName)
	local username = cleanUsername(rawName)
	if not username then
		return { ok = false, message = "Ник: 3–20 символов, только буквы, цифры и _." }
	end

	local success, targetId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	if not success or not targetId then
		return { ok = false, message = "Такого игрока не существует." }
	end

	local result = {
		ok = true,
		userId = targetId,
		username = username,
		isFriend = isFriend(player, targetId),
		online = false,
		canJoin = false,
		location = "Статус недоступен",
		jobId = nil,
	}

	if not result.isFriend then
		result.message = "Игрок найден. Добавь его в друзья для просмотра статуса."
		return result
	end

	local presence = getFriendPresence(player, targetId)
	if not presence or presence.LocationType == Enum.LocationType.Offline then
		result.location = "Не в сети"
		result.message = "Друг сейчас не в сети."
		return result
	end

	result.online = true
	result.location = presence.LastLocation or "В сети"
	if presence.LocationType == Enum.LocationType.InGame and presence.PlaceId and presence.GameId then
		result.canJoin = true
		result.placeId = presence.PlaceId
		result.jobId = tostring(presence.GameId)
		result.message = "Друг в игре — подключение доступно."
	else
		result.message = "Друг в сети, но не в доступной игре."
	end
	return result
end

joinEvent.OnServerEvent:Connect(function(player, targetId)
	if typeof(targetId) ~= "number" or not isFriend(player, targetId) then return end

	-- Повторно читаем присутствие: клиент не может передать свой PlaceId/JobId.
	local presence = getFriendPresence(player, targetId)
	if not presence
		or presence.LocationType ~= Enum.LocationType.InGame
		or not presence.PlaceId
		or not presence.GameId then
		return
	end

	pcall(function()
		TeleportService:TeleportToPlaceInstance(presence.PlaceId, presence.GameId, player)
	end)
end)


