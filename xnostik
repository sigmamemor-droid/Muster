-- СОЗДАЁМ КНОПКИ ВКЛАДОК (левая панель)
for _, tab in ipairs(tabs) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,44,0,44)
    btn.BackgroundTransparency = 1
    btn.Text = tab.icon
    btn.TextColor3 = C.text2
    btn.TextSize = 18
    btn.Font = Enum.Font.GothamBold
    btn.Parent = Sidebar
    
    -- Индикатор выбора
    local ind = Instance.new("Frame")
    ind.Size = UDim2.new(0,2,0,0)
    ind.Position = UDim2.new(0,0,0.5,0)
    ind.BackgroundColor3 = C.accent
    ind.Visible = false
    ind.Parent = btn
    Instance.new("UICorner", ind).CornerRadius = UDim.new(1,0)
    
    btn.MouseButton1Click:Connect(function()
        -- Скрываем все страницы
        for _, p in pairs(Pages) do p.Visible = false end
        Pages[tab.id].Visible = true
        
        -- Сбрасываем индикаторы
        for _, b in pairs(Sidebar:GetChildren()) do
            if b:IsA("TextButton") then
                local i = b:FindFirstChild("Indicator")
                if i then
                    i.Visible = false
                    i.Size = UDim2.new(0,2,0,0)
                end
                b.TextColor3 = C.text2
            end
        end
        
        -- Активируем текущий
        btn.TextColor3 = C.accent
        ind.Visible = true
        ind.Size = UDim2.new(0,2,0,20)
    end)
end

