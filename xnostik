local fxState = {
    wings = false,
    aura = false,
    trail = false,
    wingSpeed = 3,
    wingFolder = nil,
    leftWeld = nil,
    rightWeld = nil,
    auraHighlight = nil,
    auraParticles = nil,
    auraLight = nil,
    trailAtt = nil,
    trail = nil,
    wingConn = nil,
}

local function RemoveWings()
    if fxState.wingFolder then
        fxState.wingFolder:Destroy()
        fxState.wingFolder = nil
    end
    fxState.leftWeld = nil
    fxState.rightWeld = nil
end

local function RemoveAura()
    if fxState.auraHighlight then fxState.auraHighlight:Destroy() fxState.auraHighlight = nil end
    if fxState.auraParticles then fxState.auraParticles:Destroy() fxState.auraParticles = nil end
    if fxState.auraLight then fxState.auraLight:Destroy() fxState.auraLight = nil end
end

local function RemoveTrail()
    if fxState.trail then fxState.trail:Destroy() fxState.trail = nil end
    if fxState.trailAtt then fxState.trailAtt:Destroy() fxState.trailAtt = nil end
end

local function CreateWingPart(parent, size, color)
    return Create("Part", {
        Size = size,
        Color = color,
        Material = Enum.Material.Neon,
        CanCollide = false,
        Massless = true,
        CastShadow = false,
        Parent = parent,
    })
end

local function ApplyWings()
    RemoveWings()
    if not fxState.wings then return end

    local char = LocalPlayer.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if not torso then return end

    local folder = Create("Folder", { Name = "EclipseWings", Parent = char })
    fxState.wingFolder = folder

    local leftRoot = Create("Part", {
        Size = Vector3.new(0.1, 0.1, 0.1),
        Transparency = 1,
        CanCollide = false,
        Massless = true,
        Parent = folder,
    })

    local rightRoot = Create("Part", {
        Size = Vector3.new(0.1, 0.1, 0.1),
        Transparency = 1,
        CanCollide = false,
        Massless = true,
        Parent = folder,
    })

    local wL = Create("Weld", { Part0 = torso, Part1 = leftRoot,
        C0 = CFrame.new(-0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(-15), 0),
        Parent = leftRoot })

    local wR = Create("Weld", { Part0 = torso, Part1 = rightRoot,
        C0 = CFrame.new(0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(15), 0),
        Parent = rightRoot })

    for i = 1, 4 do
        local scale = 1 - (i * 0.15)
        local lBlade = CreateWingPart(folder, Vector3.new(0.1, 1.8 * scale, 0.4 * scale), C.accent)
        local rBlade = CreateWingPart(folder, Vector3.new(0.1, 1.8 * scale, 0.4 * scale), C.gold)

        Create("Weld", { Part0 = leftRoot, Part1 = lBlade,
            C0 = CFrame.new(-i * 0.35, i * 0.1, -i * 0.1) * CFrame.Angles(0, 0, math.rad(25 + i * 12)),
            Parent = lBlade })

        Create("Weld", { Part0 = rightRoot, Part1 = rBlade,
            C0 = CFrame.new(i * 0.35, i * 0.1, -i * 0.1) * CFrame.Angles(0, 0, math.rad(-(25 + i * 12))),
            Parent = rBlade })
    end

    fxState.leftWeld = wL
    fxState.rightWeld = wR
end

local function ApplyAura()
    RemoveAura()
    if not fxState.aura then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    fxState.auraHighlight = Create("Highlight", {
        Name = "EclipseAuraHL",
        FillColor = C.accent,
        OutlineColor = C.gold,
        FillTransparency = 0.65,
        OutlineTransparency = 0.2,
        Adornee = char,
        Parent = char,
    })

    fxState.auraParticles = Create("ParticleEmitter", {
        Name = "EclipseAuraParticles",
        Color = ColorSequence.new(C.accent, C.gold),
        Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Texture = "rbxassetid://242200285",
        Lifetime = NumberRange.new(0.8, 1.4),
        Rate = 20,
        Speed = NumberRange.new(1.5, 3.5),
        VelocitySpread = 180,
        Parent = hrp,
    })

    fxState.auraLight = Create("PointLight", {
        Color = C.accent,
        Range = 12,
        Brightness = 2.5,
        Parent = hrp,
    })
end

local function ApplyTrail()
    RemoveTrail()
    if not fxState.trail then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    fxState.trailAtt = Create("Attachment", {
        Name = "EclipseTrailAtt",
        Position = Vector3.new(0, -3, 0),
        Parent = hrp,
    })

    fxState.trail = Create("Trail", {
        Name = "EclipseTrail",
        Attachment0 = fxState.trailAtt,
        Attachment1 = fxState.trailAtt,
        Lifetime = 0.5,
        Color = ColorSequence.new(C.accent, C.gold),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Enabled = true,
        Parent = hrp,
    })
end

-- Анимация взмахов крыльев
fxState.wingConn = RunService.RenderStepped:Connect(function()
    if fxState.wings and fxState.leftWeld and fxState.rightWeld
       and fxState.leftWeld.Parent and fxState.rightWeld.Parent then
        local flap = math.sin(tick() * fxState.wingSpeed) * 0.25
        fxState.leftWeld.C0 = CFrame.new(-0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(-15) - flap, flap * 0.5)
        fxState.rightWeld.C0 = CFrame.new(0.4, 0.5, 0.6) * CFrame.Angles(0, math.rad(15) + flap, -flap * 0.5)
    end
end)
maid:Give(fxState.wingConn)

-- Повторное применение при возрождении
maid:Give(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if fxState.wings then ApplyWings() end
    if fxState.aura then ApplyAura() end
    if fxState.trail then ApplyTrail() end
end))

