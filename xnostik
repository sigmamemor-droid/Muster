-- HELPER: is point inside an element's bounds?
---------------------------------------------------------
local function isInside(object, point)
    local p, s = object.AbsolutePosition, object.AbsoluteSize
    return point.X >= p.X and point.X <= p.X + s.X
       and point.Y >= p.Y and point.Y <= p.Y + s.Y
end

-- Check if an InputChanged event belongs to the current drag session
local function IsDragInput(input, activeInput)
    return input == activeInput
        or (
            activeInput ~= nil
            and activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        )
end

