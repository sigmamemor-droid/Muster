    hubOpen = not hubOpen
    SetToggleVisual(hubOpen)

    if hubOpen then
        Hub.Visible = true
        Hub.Size = UDim2.new(0, HUB_W, 0, 0)
        TweenService:Create(Hub, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, HUB_W, 0, HUB_H)}):Play()
    else
        local tw = TweenService:Create(Hub, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.new(0, HUB_W, 0, 0)})
        tw:Play()
        tw.Completed:Connect(function()
            if not hubOpen then
                Hub.Visible = false
                Hub.Size = UDim2.new(0, HUB_W, 0, HUB_H)
            end
        end)
    end
end

ToggleBtn.MouseButton1Click:Connect(ToggleHub)
ClB.MouseButton1Click:Connect(function() if hubOpen then ToggleHub() end end)
ShowTab("Home", 1)