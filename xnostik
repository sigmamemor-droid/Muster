-- Свет проходит по буквам слева направо; крайние буквы немного меньше,
-- как в CSS-примере с девятью отдельными срезами текста.
task.spawn(function()
    while LS.Parent do
        for i, letter in ipairs(letters) do
            local centerDistance = math.abs(i - 4.5) / 3.5
            local baseSize = math.floor(34 - centerDistance * 10)
            local baseTransparency = 0.08 + centerDistance * 0.48
            TweenService:Create(letter, TweenInfo.new(0.20, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                TextColor3 = C.accentLight,
                TextTransparency = 0,
                TextSize = baseSize + 4,
                Position = UDim2.new(0, 0, 0, -4),
            }):Play()
            task.delay(0.18, function()
                if letter.Parent then
                    TweenService:Create(letter, TweenInfo.new(0.42, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                        TextColor3 = C.white,
                        TextTransparency = baseTransparency,
                        TextSize = baseSize,
                        Position = UDim2.new(0, 0, 0, 0),
                    }):Play()
                end
            end)
            task.wait(0.10)
        end
        task.wait(0.22)
    end
end)

task.spawn(function()
    while LineGlow.Parent do
        LineGlow.Position = UDim2.new(0, -36, 0, 0)
        local sweep = TweenService:Create(LineGlow, TweenInfo.new(1.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Position = UDim2.new(1, 0, 0, 0),
        })
        sweep:Play()
        sweep.Completed:Wait()
        task.wait(0.12)
    end
end)

task.spawn(function()
    task.wait(1.9)
    local fadeInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, object in ipairs(LS:GetDescendants()) do
        if object:IsA("TextLabel") then
            TweenService:Create(object, fadeInfo, {TextTransparency = 1}):Play()
        elseif object:IsA("Frame") then
            TweenService:Create(object, fadeInfo, {BackgroundTransparency = 1}):Play()
        end
    end
    task.wait(0.4)
    LS:Destroy()
end)

