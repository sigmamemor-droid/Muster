-- Список вкладок (6-7 штук)
local tabNames = {"Главная", "Профиль", "Настройки", "Магазин", "Достижения", "Друзья"}
local tabButtons = {}
local tabHeight = 34
local tabSpacing = 5

-- Функция создания кнопки вкладки
local function createTabButton(name, index)
\tlocal btn = Instance.new("TextButton")
\tbtn.Name = name
\tbtn.Size = UDim2.new(1, -8, 0, tabHeight)
\tbtn.Position = UDim2.new(0, 4, 0, 8 + (index * (tabHeight + tabSpacing)))
\tbtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
\tbtn.TextColor3 = Color3.fromRGB(200, 200, 220)
\tbtn.Text = name
\tbtn.TextSize = 12
\tbtn.Font = Enum.Font.GothamBold
\tbtn.AutoButtonColor = true
\tbtn.Parent = tabsPanel
\t
\tlocal btnCorner = Instance.new("UICorner")
\tbtnCorner.CornerRadius = UDim.new(0, 6)
\tbtnCorner.Parent = btn
\t
\treturn btn
end

-- Создаём все кнопки
for i, name in ipairs(tabNames) do
\ttabButtons[i] = createTabButton(name, i - 1)
end

-- Функция переключения вкладок
local function switchTab(button)
\tfor _, btn in ipairs(tabButtons) do
\t\tif btn == button then
\t\t\tbtn.BackgroundColor3 = Color3.fromRGB(70, 100, 140)
\t\t\tbtn.TextColor3 = Color3.fromRGB(255, 255, 255)
\t\telse
\t\t\tbtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
\t\t\tbtn.TextColor3 = Color3.fromRGB(200, 200, 220)
\t\tend
\tend
\tcontentLabel.Text = comingSoonText
end

-- Подключаем события
for _, btn in ipairs(tabButtons) do
\tbtn.MouseButton1Click:Connect(function()
\t\tswitchTab(btn)
\tend)
end

-- Выделяем первую вкладку
if #tabButtons > 0 then
\tswitchTab(tabButtons[1])
end

