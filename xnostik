-- ===== ВКЛАДКИ СПРАВА =====
local tabsFrame = Instance.new("Frame")
tabsFrame.Name = "Tabs"
tabsFrame.Size = UDim2.new(0, 120, 1, -80)
tabsFrame.Position = UDim2.new(1, -140, 0, 70)
tabsFrame.BackgroundTransparency = 1
tabsFrame.Parent = mainFrame

local tabsLayout = Instance.new("UIListLayout")
tabsLayout.Padding = UDim.new(0, 10)
tabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
tabsLayout.Parent = tabsFrame

local tabNames = {
    "Главная",
    "Игрок",
    "Мир",
    "Визуал",
    "Аудио",
    "Настройки",
    "О проекте",
}

local accentColor = Color3.fromRGB(120, 100, 255)

for i, name in ipairs(tabNames) do
    local tab = Instance.new("Frame")
    tab.Name = "Tab" .. i
    tab.Size = UDim2.new(1, 0, 0, 42)
    tab.BackgroundColor3 = i == 1 and accentColor or Color3.fromRGB(32, 32, 44)
    tab.BackgroundTransparency = i == 1 and 0.15 or 0
    tab.LayoutOrder = i
    tab.Parent = tabsFrame

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 12)
    tabCorner.Parent = tab

    if i ~= 1 then
        local tabStroke = Instance.new("UIStroke")
        tabStroke.Color = Color3.fromRGB(255, 255, 255)
        tabStroke.Transparency = 0.93
        tabStroke.Parent = tab
    end

    local tabLabel = Instance.new("TextLabel")
    tabLabel.Size = UDim2.new(1, -16, 0, 18)
    tabLabel.Position = UDim2.new(0, 12, 0, 6)
    tabLabel.BackgroundTransparency = 1
    tabLabel.Text = name
    tabLabel.Font = Enum.Font.GothamSemibold
    tabLabel.TextSize = 13
    tabLabel.TextColor3 = i == 1 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(190, 190, 200)
    tabLabel.TextXAlignment = Enum.TextXAlignment.Left
    tabLabel.Parent = tab

    if i ~= 1 then
        local soonLabel = Instance.new("TextLabel")
        soonLabel.Size = UDim2.new(1, -16, 0, 14)
        soonLabel.Position = UDim2.new(0, 12, 0, 22)
        soonLabel.BackgroundTransparency = 1
        soonLabel.Text = "soon"
        soonLabel.Font = Enum.Font.Gotham
        soonLabel.TextSize = 11
        soonLabel.TextColor3 = Color3.fromRGB(255, 190, 90)
        soonLabel.TextXAlignment = Enum.TextXAlignment.Left
        soonLabel.Parent = tab
    end
end