-- === API ФУНКЦИИ (ПРОВЕРЕННЫЕ ИЗ v2.0) ===

local function GetUserId(username)
    local s, r = pcall(function()
        local url = "https://users.roblox.com/v1/usernames/users"
        local body = HttpService:JSONEncode({usernames = {username}, excludeBannedUsers = true})
        local resp = HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
        local data = HttpService:JSONDecode(resp)
        if data.data and #data.data > 0 then
            return data.data[1].id, data.data[1].name, data.data[1].displayName
        end
        return nil
    end)
    if s then return r else return nil end
end

local function GetAvatar(userId)
    local s, r = pcall(function()
        local url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. userId .. "&size=420x420&format=Png&isCircular=false"
        local resp = HttpService:GetAsync(url)
        local data = HttpService:JSONDecode(resp)
        if data.data and #data.data > 0 then
            return data.data[1].imageUrl
        end
        return nil
    end)
    if s then return r else return nil end
end

local function GetPresence(userId)
    local result = {isOnline = false, presenceType = 0, gameId = nil, placeId = nil, jobId = nil, lastLocation = "Неизвестно", lastOnline = nil}
    pcall(function()
        local url = "https://presence.roblox.com/v1/presence/users"
        local body = HttpService:JSONEncode({userIds = {userId}})
        local resp = HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
        local data = HttpService:JSONDecode(resp)
        if data.userPresences and #data.userPresences > 0 then
            local p = data.userPresences[1]
            result.presenceType = p.userPresenceType or 0
            result.isOnline = (p.userPresenceType == 2) or (p.userPresenceType == 1)
            result.gameId = p.gameId
            result.placeId = p.placeId
            result.jobId = p.jobId
            result.lastLocation = p.lastLocation or (p.userPresenceType == 1 and "На сайте" or "Неизвестно")
            result.lastOnline = p.lastOnline
        end
    end)
    return result
end

local function CheckPrivateProfile(userId)
    local isPrivate = false
    pcall(function()
        local url = "https://inventory.roblox.com/v1/users/" .. userId .. "/assets/collectibles?limit=1"
        local resp = HttpService:GetAsync(url)
        local data = HttpService:JSONDecode(resp)
        if data.errors then isPrivate = true end
    end)
    return isPrivate
end

local function GetSocialCounts(userId)
    local friends, followers = 0, 0
    pcall(function()
        local resp = HttpService:GetAsync("https://friends.roblox.com/v1/users/" .. userId .. "/friends/count")
        friends = HttpService:JSONDecode(resp).count or 0
    end)
    pcall(function()
        local resp = HttpService:GetAsync("https://friends.roblox.com/v1/users/" .. userId .. "/followers/count")
        followers = HttpService:JSONDecode(resp).count or 0
    end)
    return friends, followers
end

local function FormatLastOnline(lastOnline)
    if not lastOnline then return "Неизвестно" end
    local s, r = pcall(function()
        local last = DateTime.fromIsoDate(lastOnline)
        local now = DateTime.now()
        local diff = (now.UnixTimestampMillis - last.UnixTimestampMillis) / 1000
        if diff < 60 then return "Только что"
        elseif diff < 3600 then return math.floor(diff/60) .. " мин. назад"
        elseif diff < 86400 then return math.floor(diff/3600) .. " ч. назад"
        else return math.floor(diff/86400) .. " дн. назад" end
    end)
    if s then return r else return "Неизвестно" end
end

-- Обновление UI
local function UpdateUI(data)
    if not data then
        AvatarImage.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
        AvatarName.Text = "Не найдено"
        AvatarStatus.Text = "Игрок не существует"
        StatusDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        for _, v in pairs(InfoValues) do v.Text = "-" end
        for _, v in pairs(BottomValues) do v.Text = "-" end
        JoinGameBtn.Visible = false
        CopyJobBtn.Visible = false
        FavBtn.Visible = false
        StatusBar.Text = "❌ Игрок не найден"
        return
    end
    
    AvatarImage.Image = data.avatarUrl or "rbxasset://textures/ui/GuiImagePlaceholder.png"
    AvatarName.Text = data.username
    AvatarStatus.Text = data.isOnline and "🟢 Онлайн" or "🔴 Оффлайн"
    StatusDot.BackgroundColor3 = data.isOnline and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
    
    InfoValues.UserId.Text = tostring(data.userId)
    InfoValues.DisplayName.Text = data.displayName
    InfoValues.Status.Text = data.isOnline and (data.presenceType == 2 and "🟢 В игре" or "🟢 На сайте") or "🔴 Не в сети"
    InfoValues.Game.Text = data.lastLocation
    InfoValues.PlaceId.Text = data.placeId and tostring(data.placeId) or "-"
    InfoValues.JobId.Text = data.jobId or "-"
    
    BottomValues.Friends.Text = tostring(data.friendsCount)
    BottomValues.Followers.Text = tostring(data.followersCount)
    BottomValues.LastOnline.Text = data.lastOnlineFormatted
    BottomValues.Private.Text = data.isPrivate and "🔒 Приватный" or "🔓 Открытый"
    
    JoinGameBtn.Visible = data.isOnline and data.gameId ~= nil
    CopyJobBtn.Visible = data.isOnline and data.jobId ~= nil
    FavBtn.Visible = true
    
    StatusBar.Text = "✅ " .. data.username .. (data.isOnline and " | 🟢 Онлайн" or " | 🔴 Оффлайн")
end

-- Основной поиск
local function SearchPlayer()
    local username = SearchInput.Text
    if username == "" or username == " " then return end
    
    StatusBar.Text = "🔍 Поиск: " .. username
    LoadingLine:TweenSize(UDim2.new(0.3, 0, 0, 2), "Out", "Linear", 0.2)
    
    local userId, name, displayName = GetUserId(username)
    
    if not userId then
        UpdateUI(nil)
        LoadingLine:TweenSize(UDim2.new(0, 0, 0, 2), "Out", "Linear", 0.2)
        StarterGui:SetCore("SendNotification", {Title = "linbergz Tracker", Text = "❌ Игрок '" .. username .. "' не найден!", Duration = 3})
        return
    end
    
    LoadingLine:TweenSize(UDim2.new(0.6, 0, 0, 2), "Out", "Linear", 0.2)
    
    local avatarUrl = GetAvatar(userId)
    local presence = GetPresence(userId)
    local isPrivate = CheckPrivateProfile(userId)
    local friendsCount, followersCount = GetSocialCounts(userId)
    local lastOnlineFormatted = presence.isOnline and "Сейчас в сети" or FormatLastOnline(presence.lastOnline)
    
    local playerData = {
        userId = userId,
        username = name,
        displayName = displayName,
        avatarUrl = avatarUrl,
        isOnline = presence.isOnline,
        presenceType = presence.presenceType,
        gameId = presence.gameId,
        placeId = presence.placeId,
        jobId = presence.jobId,
        lastLocation = presence.lastLocation,
        lastOnline = presence.lastOnline,
        lastOnlineFormatted = lastOnlineFormatted,
        isPrivate = isPrivate,
        friendsCount = friendsCount,
        followersCount = followersCount
    }
    
    CurrentPlayerInfo = playerData
    UpdateUI(playerData)
    
    -- История
    table.insert(SearchHistory, 1, {username = name, isOnline = presence.isOnline})
    if #SearchHistory > 15 then table.remove(SearchHistory) end
    
    LoadingLine:TweenSize(UDim2.new(1, 0, 0, 2), "Out", "Linear", 0.1)
    wait(0.3)
    LoadingLine:TweenSize(UDim2.new(0, 0, 0, 2), "Out", "Linear", 0.2)
    
    StarterGui:SetCore("SendNotification", {Title = "linbergz Tracker", Text = "✅ Найден: " .. name, Duration = 3})
end

-- Обновление текущего
local function RefreshCurrent()
    if not CurrentPlayerInfo then return end
    local presence = GetPresence(CurrentPlayerInfo.userId)
    local avatarUrl = GetAvatar(CurrentPlayerInfo.userId)
    local isPrivate = CheckPrivateProfile(CurrentPlayerInfo.userId)
    local friendsCount, followersCount = GetSocialCounts(CurrentPlayerInfo.userId)
    
    CurrentPlayerInfo.avatarUrl = avatarUrl or CurrentPlayerInfo.avatarUrl
    CurrentPlayerInfo.isOnline = presence.isOnline
    CurrentPlayerInfo.presenceType = presence.presenceType
    CurrentPlayerInfo.gameId = presence.gameId
    CurrentPlayerInfo.placeId = presence.placeId
    CurrentPlayerInfo.jobId = presence.jobId
    CurrentPlayerInfo.lastLocation = presence.lastLocation
    CurrentPlayerInfo.lastOnline = presence.lastOnline
    CurrentPlayerInfo.lastOnlineFormatted = presence.isOnline and "Сейчас в сети" or FormatLastOnline(presence.lastOnline)
    CurrentPlayerInfo.isPrivate = isPrivate
    CurrentPlayerInfo.friendsCount = friendsCount
    CurrentPlayerInfo.followersCount = followersCount
    
    UpdateUI(CurrentPlayerInfo)
    StatusBar.Text = "🔄 Обновлено: " .. CurrentPlayerInfo.username
end

