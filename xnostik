local function createWingsFor(player)
    if player == LocalPlayer then return end
    if not hasDrawing then return end
    clearWings(player)
    
    local wings = {}
    local featherCount = Features.WingFeathers or 6
    
    for i = 1, featherCount do
        local left = Drawing.new("Line")
        left.Thickness = 2
        left.Transparency = 1
        left.Visible = false
        left.Color = Color3.fromRGB(255, 255, 255)
        table.insert(wings, left)
        
        local right = Drawing.new("Line")
        right.Thickness = 2
        right.Transparency = 1
        right.Visible = false
        right.Color = Color3.fromRGB(255, 255, 255)
        table.insert(wings, right)
    end
    
    local centerDot = Drawing.new("Circle")
    centerDot.Thickness = 1
    centerDot.NumSides = 12
    centerDot.Radius = 3
    centerDot.Filled = true
    centerDot.Visible = false
    centerDot.Color = Color3.fromRGB(255, 255, 255)
    table.insert(wings, centerDot)
    
    WingDrawings[player] = wings
end

local function updateWings()
    if not hasDrawing then return end
    if not Features.WingESP then
        for _, drawings in pairs(WingDrawings) do
            for _, d in pairs(drawings) do d.Visible = false end
        end
        return
    end
    
    for player, drawings in pairs(WingDrawings) do
        if not player or not player.Parent then
            clearWings(player)
            continue
        end
        
        local char = player.Character
        if not char then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp or not head then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        -- Check if visible
        local role = getRole(player)
        local show = Features.PlayerESP or
            (Features.MurdererESP and role == "Murderer") or
            (Features.SheriffESP and role == "Sheriff")
        
        if not show then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        local color = getRoleColor(role)
        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        -- Get player position behind head for wing base
        local backPos = hrp.Position + Vector3.new(0, 1.5, 0)
        local screenBack = Camera:WorldToViewportPoint(backPos)
        
        -- Wing geometry: spread feathers in arc from center
        local wingSize = Features.WingSize or 4
        local featherCount = Features.WingFeathers or 6
        local time = tick()
        local flapOffset = math.sin(time * 3) * (wingSize * 2)
        
        for i = 1, featherCount do
            local leftLine = drawings[i * 2 - 1]
            local rightLine = drawings[i * 2]
            if not leftLine or not rightLine then break end
            
            local angle = (i / featherCount) * math.pi * 0.4
            local length = wingSize * (1 + (i / featherCount) * 0.5) * 15
            local spread = math.cos(angle) * length
            local rise = math.sin(angle) * length
            
            -- Left wing
            local leftEndWorld = backPos + Vector3.new(-spread, rise + flapOffset, 0)
            local leftEndScreen = Camera:WorldToViewportPoint(leftEndWorld)
            
            leftLine.From = Vector2.new(screenBack.X, screenBack.Y)
            leftLine.To = Vector2.new(leftEndScreen.X, leftEndScreen.Y)
            leftLine.Color = color
            leftLine.Visible = true
            leftLine.Thickness = 2
            
            -- Right wing
            local rightEndWorld = backPos + Vector3.new(spread, rise + flapOffset, 0)
            local rightEndScreen = Camera:WorldToViewportPoint(rightEndWorld)
            
            rightLine.From = Vector2.new(screenBack.X, screenBack.Y)
            rightLine.To = Vector2.new(rightEndScreen.X, rightEndScreen.Y)
            rightLine.Color = color
            rightLine.Visible = true
            rightLine.Thickness = 2
        end
        
        -- Center dot
        local dot = drawings[#drawings]
        if dot then
            dot.Position = Vector2.new(screenBack.X, screenBack.Y)
            dot.Color = color
            dot.Visible = Features.NameTags
        end
    end
end

