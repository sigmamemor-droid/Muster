-- ─── Show / Hide Logic ────────────────────────
local uiVisible = false
local isLoaded = false

local function setVisible(show)
	if not isLoaded then return end
	uiVisible = show
	if show then
		main.Visible = true
		backdrop.Visible = true
		tween(main, { 
			Size = UDim2.new(0, CONFIG.WindowSize.X, 0, CONFIG.WindowSize.Y), 
			Position = UDim2.new(0.5, -CONFIG.WindowSize.X/2, 0.5, -CONFIG.WindowSize.Y/2) 
		}, 0.3):Play()
	else
		backdrop.Visible = false
		tween(main, { 
			Size = UDim2.new(0, 0, 0, 0), 
			Position = UDim2.new(0.5, 0, 0.5, 0) 
		}, 0.3):Play()
		task.delay(0.3, function() 
			if not uiVisible then main.Visible = false end 
		end)
	end
end

closeBtn.MouseButton1Click:Connect(function() setVisible(false) end)

-- Переключение на RightControl, RightShift или Insert
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert then 
		setVisible(not uiVisible) 
	end
end)

