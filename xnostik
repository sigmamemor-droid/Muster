local function create<T>(className: string, properties: {[string]: any}): T
\tlocal instance = Instance.new(className) :: any

\tfor property, value in pairs(properties) do
\t\tinstance[property] = value
\tend

\treturn instance
end

local function addCorner(parent: Instance, radius: number)
\treturn create("UICorner", {
\t\tCornerRadius = UDim.new(0, radius),
\t\tParent = parent,
\t})
end

local function addStroke(parent: Instance, color: Color3, thickness: number, transparency: number?)
\treturn create("UIStroke", {
\t\tColor = color,
\t\tThickness = thickness,
\t\tTransparency = transparency or 0,
\t\tApplyStrokeMode = Enum.ApplyStrokeMode.Border,
\t\tParent = parent,
\t})
end

local function tween(object: Instance, info: TweenInfo, goal: {[string]: any})
\tlocal animation = TweenService:Create(object, info, goal)
\tanimation:Play()
\treturn animation
end

local function safeCall(callback: ((...any) -> ())?, ...: any)
\tif not callback then
\t\treturn
\tend

\tlocal success, err = pcall(callback, ...)
\tif not success then
\t\twarn("[Aurora UI] Callback error:", err)
\tend
end

local function clampWindowPosition(frame: Frame)
\tlocal camera = workspace.CurrentCamera
\tif not camera then
\t\treturn
\tend

\tlocal viewport = camera.ViewportSize
\tlocal size = frame.AbsoluteSize
\tlocal position = frame.AbsolutePosition

\tlocal margin = 10
\tlocal minX = margin
\tlocal minY = margin
\tlocal maxX = math.max(margin, viewport.X - size.X - margin)
\tlocal maxY = math.max(margin, viewport.Y - size.Y - margin)

\tlocal x = math.clamp(position.X, minX, maxX)
\tlocal y = math.clamp(position.Y, minY, maxY)

\tframe.Position = UDim2.fromOffset(x + size.X / 2, y + size.Y / 2)
end

