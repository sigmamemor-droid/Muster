local tabs = {}
local pages = {}

local function SelectTab(tabId)
    for id, page in pairs(pages) do
        page.Visible = (id == tabId)
    end
    for id, btn in pairs(tabs) do
        local isSelected = (id == tabId)
        btn.BackgroundColor3 = isSelected and C.card or C.sidebar
        btn.TextColor3 = isSelected and C.text or C.textSec
        local bar = btn:FindFirstChild("Indicator")
        if bar then bar.Visible = isSelected end
    end
end

