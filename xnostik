do
    ToggleClick.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            toggleDrag = {
                input = input,
                start = input.Position,
                position = ToggleBtn.Position,
                moved = false,
            }
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not toggleDrag then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= toggleDrag.input then return end
        local delta = input.Position - toggleDrag.start
        if delta.Magnitude > 6 then toggleDrag.moved = true end
        ToggleBtn.Position = UDim2.fromOffset(
            toggleDrag.position.X.Offset + delta.X,
            toggleDrag.position.Y.Offset + delta.Y
        )
    end)
    UserInputService.InputEnded:Connect(function(input)
        if toggleDrag and input == toggleDrag.input then
            toggleSuppressClick = toggleDrag.moved
            toggleDrag = nil
        end
    end)
end

