local function IsInside(guiObject, point)
\tlocal position = guiObject.AbsolutePosition
\tlocal size = guiObject.AbsoluteSize

\treturn point.X >= position.X
\t\tand point.X <= position.X + size.X
\t\tand point.Y >= position.Y
\t\tand point.Y <= position.Y + size.Y
end

Connect(ToggleButton.InputBegan, function(input)
\tif input.UserInputType ~= Enum.UserInputType.MouseButton1
\t\tand input.UserInputType ~= Enum.UserInputType.Touch then
\t\treturn
\tend

\ttoggleDrag = {
\t\tinput = input,
\t\tstartInput = input.Position,
\t\tstartPosition = ToggleButton.Position,
\t\tmoved = false,
\t}
end)

Connect(Sidebar.InputBegan, function(input)
\tif input.UserInputType ~= Enum.UserInputType.MouseButton1
\t\tand input.UserInputType ~= Enum.UserInputType.Touch then
\t\treturn
\tend

\tif IsInside(CloseButton, input.Position) then
\t\treturn
\tend

\tEnsureHubPosition()

\twindowDrag = {
\t\tinput = input,
\t\tstartInput = input.Position,
\t\tstartPosition = hubPosition,
\t}
end)

Connect(UserInputService.InputChanged, function(input)
\tif toggleDrag then
\t\tlocal validToggleInput = input.UserInputType == Enum.UserInputType.MouseMovement
\t\t\tor input == toggleDrag.input

\t\tif validToggleInput then
\t\t\tlocal delta = input.Position - toggleDrag.startInput

\t\t\tif delta.Magnitude > 7 then
\t\t\t\ttoggleDrag.moved = true
\t\t\tend

\t\t\tlocal viewport = GetViewport()
\t\t\tlocal maxX = math.max(8, viewport.X - ToggleButton.AbsoluteSize.X - 8)
\t\t\tlocal maxY = math.max(8, viewport.Y - ToggleButton.AbsoluteSize.Y - 8)

\t\t\tToggleButton.Position = UDim2.fromOffset(
\t\t\t\tmath.clamp(toggleDrag.startPosition.X.Offset + delta.X, 8, maxX),
\t\t\t\tmath.clamp(toggleDrag.startPosition.Y.Offset + delta.Y, 8, maxY)
\t\t\t)
\t\tend
\tend

\tif windowDrag then
\t\tlocal validWindowInput = input.UserInputType == Enum.UserInputType.MouseMovement
\t\t\tor input == windowDrag.input

\t\tif validWindowInput then
\t\t\tApplyHubPosition(windowDrag.startPosition + (input.Position - windowDrag.startInput))
\t\t\tUpdateLayout()
\t\tend
\tend
end)

Connect(UserInputService.InputEnded, function(input)
\tif toggleDrag then
\t\tlocal toggleEnded = input == toggleDrag.input
\t\t\tor input.UserInputType == Enum.UserInputType.MouseButton1

\t\tif toggleEnded then
\t\t\tlocal moved = toggleDrag.moved
\t\t\ttoggleDrag = nil

\t\t\tif not moved then
\t\t\t\tSetHubOpen(not hubOpen)
\t\t\tend
\t\tend
\tend

\tif windowDrag then
\t\tlocal dragEnded = input == windowDrag.input
\t\t\tor input.UserInputType == Enum.UserInputType.MouseButton1

\t\tif dragEnded then
\t\t\twindowDrag = nil
\t\tend
\tend
end)

Connect(CloseButton.Activated, function()
\tSetHubOpen(false)
end)

Connect(ScreenGui:GetPropertyChangedSignal("AbsoluteSize"), function()
\tif hubPosition then
\t\tUpdateLayout()
\tend
end)

