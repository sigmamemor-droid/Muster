local function make(className, props, parent)
\tlocal object = Instance.new(className)

\tfor property, value in pairs(props or {}) do
\t\tobject[property] = value
\tend

\tobject.Parent = parent
\treturn object
end

local function corner(parent, radius)
\treturn make("UICorner", {
\t\tCornerRadius = UDim.new(0, radius),
\t}, parent)
end

local function stroke(parent, color, thickness, transparency)
\treturn make("UIStroke", {
\t\tColor = color,
\t\tThickness = thickness or 1,
\t\tTransparency = transparency or 0,
\t}, parent)
end

local function tween(object, duration, goals, style, direction)
\tlocal animation = TweenService:Create(
\t\tobject,
\t\tTweenInfo.new(
\t\t\tduration,
\t\t\tstyle or Enum.EasingStyle.Quint,
\t\t\tdirection or Enum.EasingDirection.Out
\t\t),
\t\tgoals
\t)
\tanimation:Play()
\treturn animation
end

