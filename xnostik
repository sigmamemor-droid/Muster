    if state then
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = hrp
        
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBG.P = 9e4
        flyBG.CFrame = hrp.CFrame
        flyBG.Parent = hrp
        
        flyConn = RenderStepped:Connect(function()
            if not hrp or not hrp.Parent then return end
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LevanantLookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            flyBV.Velocity = dir * Features.FlySpeed
            flyBG.CFrame = Camera.CFrame
        end)
    end
end

-- Noclip
local noclipConn
ToggleCallbacks.Noclip = function(state)
    Features.Noclip = state
    if noclipConn then noclipConn:Disconnect() end
    if state then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

-- Auto Coins
local coinConn
ToggleCallbacks.AutoCoins = function(state)
    Features.AutoCoins = state
    if coinConn then coinConn:Disconnect() end
    if state then
        coinConn = Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local nearest, dist = nil, 50
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name:lower():match("coin") or obj.Name:lower():match("cash")) then
                    local d = (obj.Position - root.Position).Magnitude
                    if d < dist then dist = d; nearest = obj end
                end
            end
            if nearest then root.CFrame = nearest.CFrame end
        end)
    end
end

-- Knife Reach
local reachConn
ToggleCallbacks.KnifeReach = function(state)
    Features.KnifeReach = state
    if reachConn then reachConn:Disconnect() end
    if state then
        reachConn = Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
            if not knife then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local reach = Features.KnifeReachValue
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = p.Character.HumanoidRootPart
                    local dist = (targetHrp.Position - hrp.Position).Magnitude
                    if dist <= reach then
                        local humanoid = p.Character:FindFirstChild("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            pcall(function()
                                local remote = knife:FindFirstChild("Hit") or knife:FindFirstChildOfClass("RemoteEvent")
                                if remote then
                                    if remote:IsA("RemoteEvent") then
                                        remote:FireServer(p.Character, targetHrp, knife)
                                    elseif remote:IsA("RemoteFunction") then
                                        remote:InvokeServer(p.Character, targetHrp, knife)
                                    end
                                end
                            end)
                        end
                    end
                end
            end
        end)
    end
end

-- Auto Shoot
local autoShootConn
ToggleCallbacks.AutoShoot = function(state)
    Features.AutoShoot = state
    if autoShootConn then autoShootConn:Disconnect() end
    if state then
        autoShootConn = Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local gun = char:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
            if not gun then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if getRole(p) == "Murderer" then
                        local targetHrp = p.Character.HumanoidRootPart
                        local dist = (targetHrp.Position - hrp.Position).Magnitude
                        if dist <= 500 then
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
                            pcall(function()
                                local remote = gun:FindFirstChild("Shoot") or gun:FindFirstChildOfClass("RemoteEvent")
                                if remote then
                                    if remote:IsA("RemoteEvent") then
                                        remote:FireServer(targetHrp.Position, targetHrp)
                                    elseif remote:IsA("RemoteFunction") then
                                        remote:InvokeServer(targetHrp.Position, targetHrp)
                                    end
                                end
                            end)
                        end
                    end
                end
            end
            task.wait(0.5)
        end)
    end
end

