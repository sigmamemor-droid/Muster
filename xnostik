        if not toggleDrag or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= toggleDrag.input) then return end
        local delta = input.Position - toggleDrag.start
        if delta.Magnitude > 7 then toggleDrag.moved = true end
        local viewport = ScreenGui.AbsoluteSize
        local x = math.clamp(toggleDrag.position.X.Offset + delta.X, 8, math.max(8, viewport.X - ToggleBtn.AbsoluteSize.X - 8))
