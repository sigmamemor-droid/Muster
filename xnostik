local function createToggle(page, title, description, defaultValue, callback)
	local card = createCard(page, title, description)
	local enabled = defaultValue == true

	local toggle = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(42, 24),
		BackgroundColor3 = enabled and COLORS.Accent or Color3.fromRGB(48, 53, 67),
		BorderSizePixel = 0,
		Text = "",
		Parent = card,
	})
	corner(toggle, 12)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = enabled and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = toggle,
	})
	corner(knob, 9)

	local function set(value)
		enabled = value
		tween(toggle, {BackgroundColor3 = enabled and COLORS.Accent or Color3.fromRGB(48, 53, 67)})
		tween(knob, {Position = enabled and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 12, 0.5, 0)})
		if callback then callback(enabled) end
	end

	toggle.MouseButton1Click:Connect(function()
		set(not enabled)
	end)
	return set
end

local function selectTab(name)
	if activeTab == name then return end
	activeTab = name

	for tabName, page in pairs(pages) do
		page.Visible = tabName == name
	end

	for tabName, elements in pairs(tabButtons) do
		local selected = tabName == name
		tween(elements.Button, {
			BackgroundColor3 = selected and COLORS.AccentSoft or COLORS.Sidebar,
			BackgroundTransparency = selected and 0 or 1,
		})
		tween(elements.Icon, {
			ImageColor3 = selected and Color3.new(1, 1, 1) or COLORS.Muted,
		})
		tween(elements.Indicator, {
			BackgroundTransparency = selected and 0 or 1,
			Size = selected and UDim2.fromOffset(3, 22) or UDim2.fromOffset(3, 8),
		})
	end

	for _, data in ipairs(TAB_DATA) do
		if data.Name == name then
			pageTitle.Text = data.Title
			pageSubtitle.Text = data.Subtitle
			break
		end
	end
end

