local function CreateSlider(parent, titleText, minVal, maxVal, defaultVal, prefix, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundTransparency = 1
    frame.ZIndex = 13
    frame.Parent = parent

    prefix = prefix or "x"

