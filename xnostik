local function GetHubSize()
\tlocal viewport = GetViewport()

\treturn Vector2.new(
\t\tmath.clamp(viewport.X - 16, MIN_WIDTH, HUB_WIDTH),
\t\tmath.clamp(viewport.Y - 16, MIN_HEIGHT, HUB_HEIGHT)
\t)
end

local function ApplyHubPosition(position)
\thubSize = GetHubSize()

\tlocal viewport = GetViewport()
\tlocal maxX = math.max(8, viewport.X - hubSize.X - 8)
\tlocal maxY = math.max(8, viewport.Y - hubSize.Y - 8)

\thubPosition = Vector2.new(
\t\tmath.clamp(position.X, 8, maxX),
\t\tmath.clamp(position.Y, 8, maxY)
\t)

\tHub.Position = UDim2.fromOffset(hubPosition.X, hubPosition.Y)
\tHub.Size = UDim2.fromOffset(hubSize.X, hubSize.Y)

\tHubShadow.Position = UDim2.fromOffset(hubPosition.X, hubPosition.Y + 7)
\tHubShadow.Size = UDim2.fromOffset(hubSize.X, hubSize.Y)
end

local function EnsureHubPosition()
\thubSize = GetHubSize()

\tif not hubPosition then
\t\tlocal viewport = GetViewport()

\t\thubPosition = Vector2.new(
\t\t\tmath.max(8, (viewport.X - hubSize.X) / 2),
\t\t\tmath.max(8, (viewport.Y - hubSize.Y) / 2)
\t\t)
\tend

\tApplyHubPosition(hubPosition)
end

