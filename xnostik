            TweenService:Create(toggleBg, TweenInfo.new(0.15), {BackgroundColor3 = theme.accent}):Play()
        else
            TweenService:Create(toggleDot, TweenInfo.new(0.15), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
            TweenService:Create(toggleBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 60, 72)}):Play()
        end
    end)
end

