local function createTabButton(data)
	local tabBtn = create("TextButton", {
		Name = "Tab_" .. data.id,
		Size = UDim2.new(1, 0, 0, CONFIG.TabHeight),
		BackgroundColor3 = CONFIG.Theme.Sidebar,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = tabList,
	})
	addCorner(tabBtn, 9)
	
	-- Active indicator
	local indicator = create("Frame", {
		Size = UDim2.new(0, 3, 0, 0),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = CONFIG.Theme.Accent,
		BorderSizePixel = 0,
		Parent = tabBtn,
	})
	addCorner(indicator, 2)
	
	-- Icon
	create("TextLabel", {
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = data.icon,
		TextColor3 = CONFIG.Theme.TextSecondary,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		Parent = tabBtn,
	})
	
	-- Label
	local label = create("TextLabel", {
		Size = UDim2.new(1, -42, 1, 0),
		Position = UDim2.new(0, 36, 0, 0),
		BackgroundTransparency = 1,
		Text = data.label,
		TextColor3 = CONFIG.Theme.TextSecondary,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = tabBtn,
	})
	
	-- Hover
	tabBtn.MouseEnter:Connect(function()
		if State.ActiveTab ~= data.id then
			tween(tabBtn, { BackgroundColor3 = CONFIG.Theme.CardHover }, 0.1):Play()
		end
	end)
	tabBtn.MouseLeave:Connect(function()
		if State.ActiveTab ~= data.id then
			tween(tabBtn, { BackgroundColor3 = CONFIG.Theme.Sidebar }, 0.1):Play()
		end
	end)
	
	return tabBtn, indicator, label
end

local function switchTab(tabId)
	if State.ActiveTab == tabId then return end
	
	-- Deactivate previous
	if State.ActiveTab then
		local prev = Tabs[State.ActiveTab]
		if prev then
			tween(prev.btn, { BackgroundColor3 = CONFIG.Theme.Sidebar }, 0.15):Play()
			tween(prev.indicator, { Size = UDim2.new(0, 3, 0, 0) }, 0.15):Play()
			prev.label.TextColor3 = CONFIG.Theme.TextSecondary
			
			if prev.container then
				tween(prev.container, { GroupTransparency = 1 }, 0.12):Play()
				task.delay(0.12, function()
					if prev.container then prev.container.Visible = false end
				end)
			end
		end
	end
	
	-- Activate new
	local newTab = Tabs[tabId]
	if not newTab then return end
	
	State.ActiveTab = tabId
	
	tween(newTab.btn, { BackgroundColor3 = CONFIG.Theme.Card }, 0.15):Play()
	tween(newTab.indicator, { Size = UDim2.new(0, 3, 0, 18) }, 0.18):Play()
	newTab.label.TextColor3 = CONFIG.Theme.TextPrimary
	
	if newTab.container then
		newTab.container.Visible = true
		newTab.container.GroupTransparency = 1
		tween(newTab.container, { GroupTransparency = 0 }, 0.18):Play()
	end
end

