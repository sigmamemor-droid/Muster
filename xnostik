    ValueLabel.TextSize = 11
    ValueLabel.TextColor3 = Theme.Accent
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.Parent = Container
    table.insert(accentElements, ValueLabel)
    
    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1, -24, 0, 5)
    Track.Position = UDim2.new(0, 12, 0, 32)
    Track.BackgroundColor3 = Theme.ToggleOff
    Track.BorderSizePixel = 0
    Track.Parent = Container
    local trc = Instance.new("UICorner")
    trc.CornerRadius = UDim.new(0, 3)
    trc.Parent = Track
    
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Theme.Accent
    Fill.BorderSizePixel = 0
    Fill.Parent = Track
    local frc = Instance.new("UICorner")
    frc.CornerRadius = UDim.new(0, 3)
    frc.Parent = Fill
    table.insert(accentElements, Fill)
    
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 14, 0, 14)
    Knob.Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob.Parent = Track
    local knc = Instance.new("UICorner")
    knc.CornerRadius = UDim.new(1, 0)
    knc.Parent = Knob
    
    Features[key] = default
    local dragging = false
    
    local function update(inputPos)
        local pct = math.clamp((inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pct)
        ValueLabel.Text = tostring(val)
        Features[key] = val
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        Knob.Position = UDim2.new(pct, -7, 0.5, -7)
        if callback then callback(val) end
    end
    
    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
    end
    end)
    
    return Container
end

