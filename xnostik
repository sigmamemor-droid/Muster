local ESPSystem = {}
ESPSystem.Players = {}
ESPSystem.Drawings = {}

local function getRole(player)
    local role = "Innocent"
    
    local knife = player.Character and player.Character:FindFirstChild("Knife") or 
                  player.Backpack and player.Backpack:FindFirstChild("Knife")
    local gun = player.Character and player.Character:FindFirstChild("Gun") or 
                player.Backpack and player.Backpack:FindFirstChild("Gun")
    
    local coin = player.PlayerGui and player.PlayerGui:FindFirstChild("CoinFrame")
    
    -- Check for murderer
    if knife then
        role = "Murderer"
    elseif gun then
        role = "Sheriff"
    end
    
    -- Alternative detection method
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= player and v.Character then
            local holder = v.Character:FindFirstChild("Knife") or v.Backpack:FindFirstChild("Knife")
            if holder then
                -- Someone else has the knife, so this player is not murderer
            end
        end
    end
    
    return role
end

local function getRoleColor(role)
    if role == "Murderer" then return Config.ESP.MurdrerColor end
    if role == "Sheriff" then return Config.ESP.SheriffColor end
    return Config.ESP.InnocentColor
end

function ESPSystem.createDrawings(player)
    local drawings = {
        Box = createDrawing("Square", {
            Thickness = Config.ESP.BoxThickness,
            Color = Config.ESP.BoxColor,
            Filled = false,
            Visible = false,
        }),
        BoxOutline = createDrawing("Square", {
            Thickness = Config.ESP.BoxThickness + 2,
            Color = Color3.fromRGB(0, 0, 0),
            Filled = false,
            Visible = false,
        }),
        Name = createDrawing("Text", {
            Size = Config.ESP.TextSize,
            Center = true,
            Outline = true,
            OutlineColor = Color3.fromRGB(0, 0, 0),
            Color = Config.ESP.NameColor,
            Font = 2,
            Visible = false,
        }),
        Distance = createDrawing("Text", {
            Size = Config.ESP.TextSize - 1,
            Center = true,
            Outline = true,
            OutlineColor = Color3.fromRGB(0, 0, 0),
            Color = Config.Theme.TextDark,
            Font = 2,
            Visible = false,
        }),
        Role = createDrawing("Text", {
            Size = Config.ESP.TextSize,
            Center = true,
            Outline = true,
            OutlineColor = Color3.fromRGB(0, 0, 0),
            Color = Config.Theme.Warning,
            Font = 2,
            Visible = false,
        }),
        Tracer = createDrawing("Line", {
            Thickness = Config.ESP.TracerThickness,
            Color = Config.ESP.TracerColor,
            Visible = false,
        }),
        HealthBar = createDrawing("Square", {
            Thickness = 1,
            Color = Config.Theme.Success,
            Filled = true,
            Visible = false,
        }),
