    return drawings
end

function ESPSystem.removeDrawings(player)
    if ESPSystem.Drawings[player] then
        for _, drawing in pairs(ESPSystem.Drawings[player]) do
            drawing:Remove()
        end
        ESPSystem.Drawings[player] = nil
    end
end

function ESPSystem.updatePlayer(player)
    local drawings = ESPSystem.Drawings[player]
    if not drawings then return end

    if not Config.ESP.Enabled or not isAlive(player) or player == LocalPlayer then
        for _, drawing in pairs(drawings) do
            drawing.Visible = false
        end
        return
    end

    local character = player.Character
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    local head = character:FindFirstChild("Head")

    if not rootPart or not humanoid or not head then
        for _, drawing in pairs(drawings) do
            drawing.Visible = false
        end
        return
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
    local headPos = Camera:WorldToViewportPoint(head.Position)
    local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))

    local distance = getDistance(rootPart)
    if distance > Config.ESP.MaxDistance then
        for _, drawing in pairs(drawings) do
            drawing.Visible = false
        end
        return
    end

    if not onScreen then
        for _, drawing in pairs(drawings) do
            drawing.Visible = false
        end
        return
    end

    -- Box ESP
    if Config.ESP.ShowBoxes then
        local boxHeight = math.abs(headPos.Y - legPos.Y)
        local boxWidth = boxHeight * 0.5
        local centerX = screenPos.X
        local centerY = (headPos.Y + legPos.Y) / 2

        drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
        drawings.Box.Position = Vector2.new(centerX - boxWidth / 2, centerY - boxHeight / 2)
        drawings.Box.Visible = true

        drawings.BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
        drawings.BoxOutline.Position = Vector2.new(centerX - boxWidth / 2, centerY - boxHeight / 2)
        drawings.BoxOutline.Visible = true

        local role = getRole(player)
        local roleColor = getRoleColor(role)
        if Config.ESP.ShowRoles then
            drawings.Box.Color = roleColor
            drawings.BoxOutline.Color = roleColor
        else
            drawings.Box.Color = Config.ESP.BoxColor
            drawings.BoxOutline.Color = Config.ESP.BoxColor
        end
    else
        drawings.Box.Visible = false
        drawings.BoxOutline.Visible = false
    end

    -- Name ESP
    if Config.ESP.ShowNames then
        drawings.Name.Text = player.Name
        drawings.Name.Position = Vector2.new(screenPos.X, headPos.Y - 16)
        drawings.Name.Visible = true
        
        if Config.ESP.ShowRoles then
            local role = getRole(player)
            drawings.Name.Color = getRoleColor(role)
        else
            drawings.Name.Color = Config.ESP.NameColor
        end
    else
        drawings.Name.Visible = false
    end

    -- Distance ESP
    if Config.ESP.ShowDistance then
        drawings.Distance.Text = "[" .. round(distance) .. "m]"
        drawings.Distance.Position = Vector2.new(screenPos.X, legPos.Y + 2)
        drawings.Distance.Visible = true
    else
        drawings.Distance.Visible = false
    end

    -- Role ESP
    if Config.ESP.ShowRoles then
        local role = getRole(player)
        drawings.Role.Text = "[" .. role .. "]"
        drawings.Role.Position = Vector2.new(screenPos.X, headPos.Y - 30)
        drawings.Role.Color = getRoleColor(role)
        drawings.Role.Visible = true
    else
        drawings.Role.Visible = false
    end

    -- Tracer ESP
    if Config.ESP.ShowTracers then
        local viewportSize = Camera.ViewportSize
        drawings.Tracer.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
        drawings.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
        drawings.Tracer.Visible = true

        if Config.ESP.ShowRoles then
            local role = getRole(player)
            drawings.Tracer.Color = getRoleColor(role)
        else
            drawings.Tracer.Color = Config.ESP.TracerColor
        end
    else
        drawings.Tracer.Visible = false
    end

    -- Health bar
    if Config.ESP.ShowHealth then
        local boxHeight = math.abs(headPos.Y - legPos.Y)
        local boxWidth = boxHeight * 0.5
        local centerX = screenPos.X
        local centerY = (headPos.Y + legPos.Y) / 2
        local healthPercent = humanoid.Health / humanoid.MaxHealth

        local barX = centerX - boxWidth / 2 - 6
        local barY = centerY - boxHeight / 2

        drawings.HealthBarOutline.Size = Vector2.new(3, boxHeight + 2)
        drawings.HealthBarOutline.Position = Vector2.new(barX - 1, barY - 1)
        drawings.HealthBarOutline.Visible = true

        drawings.HealthBar.Size = Vector2.new(1, boxHeight * healthPercent)
        drawings.HealthBar.Position = Vector2.new(barX, barY + boxHeight * (1 - healthPercent))
        
        if healthPercent > 0.5 then
            drawings.HealthBar.Color = Config.Theme.Success
        elseif healthPercent > 0.25 then
            drawings.HealthBar.Color = Config.Theme.Warning
        else
            drawings.HealthBar.Color = Config.Theme.Danger
        end
        drawings.HealthBar.Visible = true
    else
        drawings.HealthBar.Visible = false
        drawings.HealthBarOutline.Visible = false
    end
end

function ESPSystem.updateAll()
    for player, _ in pairs(ESPSystem.Drawings) do
        ESPSystem.updatePlayer(player)
    end
end

-- Initialize ESP for existing players
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        ESPSystem.createDrawings(player)
