-- Единый источник истины для позиции и размера окна.
-- Все изменения (перетаскивание и изменение размера) проходят через эту функцию.
local function getViewport()
    local size = ScreenGui.AbsoluteSize
    if size.X < 1 or size.Y < 1 then
        local camera = workspace.CurrentCamera
        size = camera and camera.ViewportSize or Vector2.new(1280, 720)
    end
    return size
end

local function applyWindowRect(position, size)
    local viewport = getViewport()
    -- On phones narrower/shorter than MIN_SIZE, fit the available viewport instead of forcing overflow.
    local minWidth = math.max(1, math.min(MIN_SIZE.X, viewport.X - 16))
    local minHeight = math.max(1, math.min(MIN_SIZE.Y, viewport.Y - 16))
    local maxW = math.max(minWidth, viewport.X - 16)
    local maxH = math.max(minHeight, viewport.Y - 16)
    local width = math.clamp(size.X, minWidth, maxW)
    local height = math.clamp(size.Y, minHeight, maxH)
    local maxX = math.max(8, viewport.X - width - 8)
    local maxY = math.max(8, viewport.Y - height - 8)
    windowPos = Vector2.new(math.clamp(position.X, 8, maxX), math.clamp(position.Y, 8, maxY))
    windowSize = Vector2.new(width, height)
    Hub.Position = UDim2.fromOffset(windowPos.X, windowPos.Y)
    Hub.Size = UDim2.fromOffset(width, height)
    HubShadow.Position = UDim2.fromOffset(windowPos.X, windowPos.Y + 8)
    HubShadow.Size = UDim2.fromOffset(width, height)
    if applyResponsiveLayout then applyResponsiveLayout() end
end

local function ensureWindowRect()
    if not windowPos then
        local viewport = getViewport()
        windowPos = Vector2.new(math.max(8, (viewport.X - windowSize.X) / 2), math.max(8, (viewport.Y - windowSize.Y) / 2))
    end
    applyWindowRect(windowPos, windowSize)
end

