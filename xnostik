-- ===== ТЕМА (общее состояние) =====
local theme = {
    accent = Color3.fromRGB(130, 105, 255),
    snow = Color3.fromRGB(255, 255, 255),
    snowEnabled = false,
}

-- список объектов, которые красятся акцентным цветом при смене темы
local accentTargets = {} -- {instance = inst, prop = "BackgroundColor3"}
local function registerAccent(inst, prop)
    table.insert(accentTargets, {inst = inst, prop = prop})
    inst[prop] = theme.accent
end

local function applyAccent(newColor)
    theme.accent = newColor
    for _, t in ipairs(accentTargets) do
        TweenService:Create(t.inst, TweenInfo.new(0.25), {[t.prop] = newColor}):Play()
    end
end

registerAccent(logoDot, "BackgroundColor3")

-- ===== СНЕГ (визуальный эффект) =====
local snowFolder = Instance.new("Frame")
snowFolder.Name = "SnowLayer"
snowFolder.Size = UDim2.new(1, 0, 1, 0)
snowFolder.BackgroundTransparency = 1
snowFolder.ClipsDescendants = true
snowFolder.ZIndex = 50
snowFolder.Parent = mainFrame

local snowflakes = {}
local function spawnSnowflakes()
    for i = 1, 18 do
        local flake = Instance.new("Frame")
        flake.Size = UDim2.new(0, 4, 0, 4)
        flake.Position = UDim2.new(math.random(), 0, math.random(), 0)
        flake.BackgroundColor3 = theme.snow
        flake.BackgroundTransparency = 0.2
        flake.BorderSizePixel = 0
        flake.ZIndex = 50
        flake.Visible = false
        Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)
        flake.Parent = snowFolder
        table.insert(snowflakes, {inst = flake, speed = math.random(10, 25) / 100})
    end
end
spawnSnowflakes()

RunService.Heartbeat:Connect(function(dt)
    if not theme.snowEnabled then return end
    for _, f in ipairs(snowflakes) do
        f.inst.Visible = true
        local pos = f.inst.Position
        local newY = pos.Y.Scale + f.speed * dt
        if newY > 1 then newY = -0.05 end
        f.inst.Position = UDim2.new(pos.X.Scale, 0, newY, 0)
    end
end)

local function setSnowEnabled(state)
    theme.snowEnabled = state
    if not state then
        for _, f in ipairs(snowflakes) do f.inst.Visible = false end
    end
end

local function setSnowColor(color)
    theme.snow = color
    for _, f in ipairs(snowflakes) do
        f.inst.BackgroundColor3 = color
    end
end

-- ===== СОЗДАНИЕ ВКЛАДКИ И СТРАНИЦЫ =====
local pages = {}
local tabButtons = {}

local function selectTab(name)
    for pageName, page in pairs(pages) do
        page.Visible = (pageName == name)
    end
    for tabName, btn in pairs(tabButtons) do
        local active = (tabName == name)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundTransparency = active and 0.1 or 1
        }):Play()
        btn.BackgroundColor3 = theme.accent
        btn.label.TextColor3 = active and Color3.fromRGB(255,255,255) or Color3.fromRGB(160,160,172)
    end
end

local function createTab(name, layoutOrder)
    local tab = Instance.new("TextButton")
    tab.Name = "Tab_" .. name
    tab.Size = UDim2.new(1, 0, 0, 34)
    tab.BackgroundColor3 = theme.accent
    tab.BackgroundTransparency = 1
    tab.AutoButtonColor = false
    tab.Text = ""
    tab.LayoutOrder = layoutOrder
    tab.Parent = tabsFrame
    Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 9)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -14, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(160, 160, 172)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = tab
    tab.label = label

    tab.MouseButton1Click:Connect(function()
        selectTab(name)
    end)

    tabButtons[name] = tab

    local page = Instance.new("ScrollingFrame")
    page.Name = "Page_" .. name
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = theme.accent
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = content

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 18)
    pad.PaddingRight = UDim.new(0, 18)
    pad.PaddingTop = UDim.new(0, 16)
    pad.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    pages[name] = page
    return page
end

local function addHeading(page, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 16
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = page
    return lbl
end

local function addNote(page, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = Color3.fromRGB(140, 140, 155)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.Parent = page
    return lbl
end

-- цветовые бейджи-кружки для выбора
local function addColorRow(page, colors, onPick)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundTransparency = 1
    row.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 8)
    layout.Parent = row

    for _, c in ipairs(colors) do
        local swatch = Instance.new("TextButton")
        swatch.Size = UDim2.new(0, 28, 0, 28)
        swatch.BackgroundColor3 = c
        swatch.Text = ""
        swatch.AutoButtonColor = false
        swatch.Parent = row
        Instance.new("UICorner", swatch).CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 0.7
        stroke.Thickness = 1
        stroke.Parent = swatch

        swatch.MouseButton1Click:Connect(function()
            onPick(c)
        end)
    end
    return row
end

