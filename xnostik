            }):Play()
            task.delay(0.18, function()
                if letter.Parent then
                    TweenService:Create(letter, TweenInfo.new(0.42, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                        TextColor3 = C.white,
                        TextTransparency = baseTransparency,
                        TextSize = baseSize,
                        Position = UDim2.new(0, 0, 0, 0),
                    }):Play()
                end
            end)
            task.wait(0.10)
        end
        task.wait(0.22)
    end
end)

