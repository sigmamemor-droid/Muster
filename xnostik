function Components.createCard(parent, size, pos, options)
	options = options or {}
	local card = create("Frame", {
		Size = size,
		Position = pos,
		BackgroundColor3 = options.bg or CONFIG.Theme.Card,
		BorderSizePixel = 0,
		Parent = parent,
	})
	addCorner(card)
