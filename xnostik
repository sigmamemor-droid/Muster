local function isTrash(name)
	local lower = name:lower()
	for _, word in ipairs(trashNames) do
		if lower:find(word) then
			return true
		end
	end
	return false
end

-- CLEAN FUNCTION
local function deepClean()
	-- Workspace
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Decal") or obj:IsA("Texture") then
			obj:Destroy()
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
			obj:Destroy()
		elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
			obj.Enabled = false
		elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") or obj:IsA("Adornment") then
			obj:Destroy()
		elseif obj:IsA("Sound") then
			if not obj:IsDescendantOf(player.Character) then
				obj:Destroy()
			end
		elseif obj:IsA("BasePart") then
			if isTrash(obj.Name) then
				obj:Destroy()
			else
				obj.Material = Enum.Material.SmoothPlastic
				if obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
					obj.RenderFidelity = Enum.RenderFidelity.Performance
				end
			end
		end
	end

	-- Characters
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			for _, obj in ipairs(plr.Character:GetDescendants()) do
				if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Accessory") then
					obj:Destroy()
				elseif obj:IsA("BasePart") then
					obj.Material = Enum.Material.SmoothPlastic
				end
			end
		end
	end

	-- Lighting
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Brightness = 2
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("PostEffect") or effect:IsA("Atmosphere") or effect:IsA("Sky") or effect:IsA("Clouds") then
			effect:Destroy()
		end
	end

	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end

-- CONTINUOUS CLEAN
local cleanConnection = nil

local function startContinuousClean()
	cleanConnection = workspace.DescendantAdded:Connect(function(obj)
		task.wait()
		if obj:IsA("Decal") or obj:IsA("Texture") then
			obj:Destroy()
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
			obj:Destroy()
		elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") or obj:IsA("Adornment") then
			obj:Destroy()
		elseif obj:IsA("BasePart") and isTrash(obj.Name) then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.Material = Enum.Material.SmoothPlastic
		end
	end)
end

local function stopContinuousClean()
	if cleanConnection then
		cleanConnection:Disconnect()
		cleanConnection = nil
	end
end

-- FPS
local frameCount = 0
local lastTick = tick()
RunService.RenderStepped:Connect(function()
	frameCount += 1
	local now = tick()
	if now - lastTick >= 1 then
		fpsNum.Text = tostring(frameCount)
		frameCount = 0
		lastTick = now
	end
end)

-- PING — robust read
task.spawn(function()
	while true do
		local ok, net = pcall(function()
			return Stats:WaitForChild("Network", 3)
		end)
		if ok and net then
			local pingObj = net:FindFirstChild("Ping")
			if pingObj and pingObj:IsA("NumberValue") then
				local v = math.floor(pingObj.Value)
				pingNum.Text = tostring(v) .. "ms"
				if v < 50 then
					pingNum.TextColor3 = Color3.fromRGB(80, 255, 120)
				elseif v < 120 then
					pingNum.TextColor3 = Color3.fromRGB(255, 200, 60)
				else
					pingNum.TextColor3 = Color3.fromRGB(255, 70, 70)
				end
			else
				pingNum.Text = "N/A"
				pingNum.TextColor3 = Color3.fromRGB(150, 150, 150)
			end
		else
			pingNum.Text = "..."
			pingNum.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
		task.wait(1)
	end
end)

-- TOGGLE
local active = false
local function setToggle(state)
	active = state
	if state then
		tween(switchBg, {BackgroundColor3 = Color3.fromRGB(255, 60, 60)}, 0.2)
		tween(knob, {Position = UDim2.new(0, 23, 0.5, -9)}, 0.2)
		tween(stroke, {Color = Color3.fromRGB(80, 255, 120), Transparency = 0.2}, 0.3)
		title.TextColor3 = Color3.fromRGB(80, 255, 120)
		deepClean()
		startContinuousClean()
	else
		tween(switchBg, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}, 0.2)
		tween(knob, {Position = UDim2.new(0, 3, 0.5, -9)}, 0.2)
		tween(stroke, {Color = Color3.fromRGB(255, 60, 60), Transparency = 0.4}, 0.3)
		title.TextColor3 = Color3.fromRGB(255, 70, 70)
		stopContinuousClean()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level07
	end
end

switchBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		setToggle(not active)
	end
end)