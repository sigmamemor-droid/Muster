local function markThemeRoles()
    local roles={bg=AppC.bg,sidebar=AppC.sidebar,surface=AppC.surface,elevated=AppC.elevated,accent=AppC.accent,accentLight=AppC.accentLight,white=AppC.white,text=AppC.text,textSec=AppC.textSec,textDim=AppC.textDim,red=AppC.red,redDark=AppC.redDark,border=AppC.border,hover=AppC.hover,selectedSurface=AppC.selectedSurface,shadow=AppC.shadow}
    for _,o in ipairs(ScreenGui:GetDescendants()) do
        for role,color in pairs(roles) do
            if o:IsA("GuiObject") and not string.match(o.Name, "^Accent_") and o.BackgroundColor3==color then o:SetAttribute("ThemeBackground",role) end
            if o:IsA("TextLabel") or o:IsA("TextButton") then if o.TextColor3==color then o:SetAttribute("ThemeText",role) end end
            if o:IsA("UIStroke") and o.Color==color then o:SetAttribute("ThemeStroke",role) end
