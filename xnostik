        Position = UDim2.new(0, 0, 0, 0)
    }):Play()
    
    task.delay(dur, function()
        if not Cd.Parent then return end
        local tw = TweenService:Create(Cd, TweenInfo.new(0.25), {
            Position = UDim2.new(1.2, 0, 0, 0)
