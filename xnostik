-- ==================== TAB SYSTEM ====================
local Tabs = {}

local tabDefinitions = {
	{id = "home", label = "Home", icon = "⌂"},
	{id = "players", label = "Players", icon = "👥"},
	{id = "stats", label = "Statistics", icon = "📊"},
	{id = "inventory", label = "Inventory", icon = "⬡"},
	{id = "settings", label = "Settings", icon = "⚙"},
	{id = "about", label = "About", icon = "ℹ"},
}

for _, data in ipairs(tabDefinitions) do
	local btn = create("TextButton", {
		Size = UDim2.new(1,0,0,42),
		BackgroundColor3 = CONFIG.Theme.Sidebar,
		Text = "",
		AutoButtonColor = false,
		Parent = tabList
	})
	addCorner(btn, 10)

	local indicator = create("Frame", {
		Size = UDim2.new(0,4,0,0),
		Position = UDim2.new(0,0,0.5,0),
		AnchorPoint = Vector2.new(0,0.5),
		BackgroundColor3 = CONFIG.Theme.Accent,
		Parent = btn
	})
	addCorner(indicator, 2)

	create("TextLabel", {Size = UDim2.new(0,24,1,0), Position = UDim2.new(0,14,0,0), Text = data.icon, TextColor3 = CONFIG.Theme.TextSecondary, Font = Enum.Font.GothamBold, TextSize = 18, BackgroundTransparency = 1, Parent = btn})
	local label = create("TextLabel", {Size = UDim2.new(1,-60,1,0), Position = UDim2.new(0,46,0,0), Text = data.label, TextColor3 = CONFIG.Theme.TextSecondary, Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Parent = btn})

	local container = create("Frame", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Visible = false, GroupTransparency = 1, Parent = contentArea})

	btn.MouseButton1Click:Connect(function()
		if State.ActiveTab == data.id then return end
		
		-- Deactivate old
		if Tabs[State.ActiveTab] then
			local old = Tabs[State.ActiveTab]
			tween(old.btn, {BackgroundColor3 = CONFIG.Theme.Sidebar}, 0.2)
			tween(old.indicator, {Size = UDim2.new(0,4,0,0)}, 0.2)
			old.label.TextColor3 = CONFIG.Theme.TextSecondary
			tween(old.container, {GroupTransparency = 1}, 0.15)
			task.delay(0.15, function() old.container.Visible = false end)
		end

		State.ActiveTab = data.id
		tween(btn, {BackgroundColor3 = CONFIG.Theme.Card}, 0.25)
		tween(indicator, {Size = UDim2.new(0,4,0,28)}, 0.3)
		label.TextColor3 = CONFIG.Theme.Text

		container.Visible = true
		tween(container, {GroupTransparency = 0}, 0.25)
	end)

	Tabs[data.id] = {btn = btn, indicator = indicator, label = label, container = container, data = data}
end

-- ==================== VISIBILITY ====================
local function toggleUI()
	State.Visible = not State.Visible
	
	if State.Visible then
		main.Visible = true
		backdrop.Visible = true
		main.Size = UDim2.new(0,0,0,0)
		tween(main, {Size = UDim2.fromOffset(CONFIG.WindowSize.X, CONFIG.WindowSize.Y)}, 0.4, Enum.EasingStyle.Back):Play()
		tween(backdrop, {BackgroundTransparency = 0.35}, 0.4):Play()
		
		if not State.ActiveTab then
			Tabs.home.btn:FireEvent("MouseButton1Click")
		end
	else
		tween(main, {Size = UDim2.new(0,0,0,0)}, 0.25, Enum.EasingStyle.Quart):Play()
		tween(backdrop, {BackgroundTransparency = 1}, 0.25):Play()
		task.delay(0.28, function()
			if not State.Visible then
				main.Visible = false
				backdrop.Visible = false
			end
		end)
	end
end

-- Hotkeys
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.F4 then
		toggleUI()
	elseif input.KeyCode == Enum.KeyCode.Escape and State.Visible then
		toggleUI()
	end
end)

