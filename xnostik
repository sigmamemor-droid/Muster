        local function dualSideOffset(i, count, t, cfg, side)
            local mode = cfg.DualMode or "dualCircleSpoke"
            local localCount = math.floor(count / 2)
            local localI = ((i-1) % localCount) + 1
            local sideOffsetX = side * (cfg.DualDistance or 8)
            if mode == "dualCircleSpoke" then
                local a = (localI-1)/localCount * math.pi*2 + t * cfg.Speed
                local r = cfg.Radius * 0.7
                return Vector3.new(sideOffsetX + math.cos(a) * r, cfg.Height + math.sin(a*3 + t) * cfg.Pulse * 0.4, math.sin(a) * r)
            elseif mode == "dualStar" then
                local a = (localI-1)/localCount * math.pi*2 + t * cfg.Speed
                local r = cfg.Radius * (0.45 + 0.35 * math.abs(math.sin(a * 5)))
                return Vector3.new(sideOffsetX + math.cos(a) * r, cfg.Height, math.sin(a) * r)
            elseif mode == "dualTriangle" then
                local a = (localI-1)/localCount * math.pi*2 + t * cfg.Speed
                local tri = math.abs(math.sin(a * 1.5))
                local r = cfg.Radius * (0.5 + tri * 0.4)
                return Vector3.new(sideOffsetX + math.cos(a) * r, cfg.Height + math.sin(a*2) * cfg.Pulse * 0.6, math.sin(a) * r)
            elseif mode == "dualDoubleRing" then
                local ring = (localI % 2 == 0) and 1 or 0.55
                local a = (localI-1)/localCount * math.pi*2 + t * cfg.Speed * (ring > 0.7 and 1 or -0.7)
                local r = cfg.Radius * ring
                return Vector3.new(sideOffsetX + math.cos(a) * r, cfg.Height + (ring > 0.7 and 0.8 or -0.4), math.sin(a) * r)
            else
                local a = (localI-1)/localCount * math.pi*2 + t * cfg.Speed
                local r = cfg.Radius * 0.65
                return Vector3.new(sideOffsetX + math.cos(a) * r, cfg.Height, math.sin(a) * r)
            end
        end
        Shapes["shapeDualSide"] = function(i, count, t, cfg)
