-- WINDOW DRAG LOGIC — robust input tracking
do
    local dragging = false
    local activeInput = nil
    local dragStart = nil
    local startPos = nil

    Sidebar.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1
         or input.UserInputType == Enum.UserInputType.Touch)
         and not windowInteraction then
            if isInside(ClB, input.Position) then return end
            ensureWindowRect()
            windowInteraction = "drag"
            dragging = true
            activeInput = input
            dragStart = input.Position
            startPos = windowPos
        end
    end)

    Track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if not IsDragInput(input, activeInput) then return end
        applyWindowRect(startPos + (input.Position - dragStart))
    end))

    Track(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == activeInput
         or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
             and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging = false
            activeInput = nil
            windowInteraction = nil
        end
    end))
end

