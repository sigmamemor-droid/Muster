\t\t\tTextXAlignment = Enum.TextXAlignment.Left,
\t\t\tZIndex = 14,
\t\t\tParent = card,
\t\t})
\tend

\tlocal track = create("TextButton", {
\t\tSize = UDim2.fromOffset(39, 22),
\t\tAnchorPoint = Vector2.new(1, 0.5),
\t\tPosition = UDim2.new(1, -12, 0.5, 0),
\t\tBackgroundColor3 = defaultValue and Theme.Accent or Theme.Stroke,
\t\tText = "",
\t\tAutoButtonColor = false,
\t\tZIndex = 14,
\t\tParent = card,
\t})
\taddCorner(track, 99)

\tlocal thumb = create("Frame", {
\t\tSize = UDim2.fromOffset(16, 16),
\t\tAnchorPoint = Vector2.new(0, 0.5),
\t\tPosition = defaultValue and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
\t\tBackgroundColor3 = Theme.White,
\t\tBorderSizePixel = 0,
\t\tZIndex = 15,
\t\tParent = track,
\t})
\taddCorner(thumb, 99)

\tlocal state = defaultValue

\tlocal function render()
\t\ttween(track, tweenFast, {
\t\t\tBackgroundColor3 = state and Theme.Accent or Theme.Stroke,
\t\t})

\t\ttween(thumb, tweenFast, {
\t\t\tPosition = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
\t\t})
\tend

\ttrack.MouseButton1Click:Connect(function()
\t\tstate = not state
\t\trender()
\t\tsafeCall(callback, state)
\tend)

\treturn {
\t\tGet = function()
\t\t\treturn state
\t\tend,
\t\tSet = function(value: boolean)
\t\t\tstate = value
\t\t\trender()
\t\t\tsafeCall(callback, state)
\t\tend,
\t}
end

function UI:AddSlider(
\tpage: ScrollingFrame,
\ttitle: string,
\tminimum: number,
\tmaximum: number,
\tdefaultValue: number,
\tsuffix: string,
\tcallback: ((number) -> ())?
)
\tlocal card = create("Frame", {
\t\tSize = UDim2.new(1, 0, 0, 56),
\t\tBackgroundColor3 = Theme.Surface,
\t\tBorderSizePixel = 0,
\t\tZIndex = 13,
\t\tParent = page,
\t})
\taddCorner(card, 12)
\taddStroke(card, Theme.Stroke, 1, 0.5)

\tcreate("TextLabel", {
\t\tSize = UDim2.new(0.7, 0, 0, 20),
\t\tPosition = UDim2.fromOffset(12, 7),
\t\tBackgroundTransparency = 1,
\t\tText = title,
\t\tTextColor3 = Theme.Text,
\t\tTextSize = 11,
\t\tFont = Enum.Font.GothamMedium,
\t\tTextXAlignment = Enum.TextXAlignment.Left,
\t\tZIndex = 14,
\t\tParent = card,
\t})

\tlocal valueLabel = create("TextLabel", {
\t\tSize = UDim2.new(0.3, -12, 0, 20),
\t\tPosition = UDim2.new(0.7, 0, 0, 7),
\t\tBackgroundTransparency = 1,
\t\tTextColor3 = Theme.AccentSoft,
\t\tTextSize = 11,
\t\tFont = Enum.Font.GothamBold,
\t\tTextXAlignment = Enum.TextXAlignment.Right,
\t\tZIndex = 14,
\t\tParent = card,
\t})

\tlocal track = create("TextButton", {
\t\tSize = UDim2.new(1, -24, 0, 5),
\t\tPosition = UDim2.fromOffset(12, 37),
\t\tBackgroundColor3 = Theme.Stroke,
\t\tBorderSizePixel = 0,
\t\tText = "",
\t\tAutoButtonColor = false,
\t\tZIndex = 14,
\t\tParent = card,
\t})
\taddCorner(track, 99)

\tlocal fill = create("Frame", {
\t\tSize = UDim2.new(),
\t\tBackgroundColor3 = Theme.Accent,
\t\tBorderSizePixel = 0,
\t\tZIndex = 15,
\t\tParent = track,
\t})
\taddCorner(fill, 99)

\tlocal thumb = create("Frame", {
\t\tSize = UDim2.fromOffset(13, 13),
\t\tAnchorPoint = Vector2.new(0.5, 0.5),
\t\tBackgroundColor3 = Theme.White,
\t\tBorderSizePixel = 0,
\t\tZIndex = 16,
\t\tParent = track,
\t})
\taddCorner(thumb, 99)

\tlocal value = math.clamp(defaultValue, minimum, maximum)
\tlocal sliderDragging = false

\tlocal function setValue(newValue: number, fireCallback: boolean)
\t\tvalue = math.clamp(math.floor(newValue + 0.5), minimum, maximum)

\t\tlocal alpha = (value - minimum) / (maximum - minimum)
\t\tfill.Size = UDim2.new(alpha, 0, 1, 0)
\t\tthumb.Position = UDim2.new(alpha, 0, 0.5, 0)
\t\tvalueLabel.Text = tostring(value) .. suffix

\t\tif fireCallback then
\t\t\tsafeCall(callback, value)
\t\tend
\tend

\tlocal function setFromInput(input: InputObject)
\t\tif track.AbsoluteSize.X <= 0 then
\t\t\treturn
\t\tend

\t\tlocal alpha = math.clamp(
\t\t\t(input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
\t\t\t0,
\t\t\t1
\t\t)

\t\tsetValue(minimum + ((maximum - minimum) * alpha), true)
\tend

\tsetValue(value, false)

\ttrack.InputBegan:Connect(function(input)
\t\tif input.UserInputType == Enum.UserInputType.MouseButton1
\t\t\tor input.UserInputType == Enum.UserInputType.Touch then
\t\t\tsliderDragging = true
\t\t\tsetFromInput(input)
\t\tend
\tend)

\tUserInputService.InputChanged:Connect(function(input)
\t\tif not sliderDragging then
\t\t\treturn
\t\tend

\t\tif input.UserInputType == Enum.UserInputType.MouseMovement
\t\t\tor input.UserInputType == Enum.UserInputType.Touch then
\t\t\tsetFromInput(input)
\t\tend
\tend)

\tUserInputService.InputEnded:Connect(function(input)
\t\tif input.UserInputType == Enum.UserInputType.MouseButton1
\t\t\tor input.UserInputType == Enum.UserInputType.Touch then
\t\t\tsliderDragging = false
\t\tend
\tend)

\treturn {
\t\tGet = function()
\t\t\treturn value
\t\tend,
\t\tSet = function(newValue: number)
\t\t\tsetValue(newValue, true)
\t\tend,
\t}
end

