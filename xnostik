local function createTooltip(button, text)
\tlocal tooltip = new("TextLabel", {
\t\tName = "Tooltip",
\t\tAnchorPoint = Vector2.new(0, 0.5),
\t\tPosition = UDim2.new(1, 10, 0.5, 0),
\t\tSize = UDim2.fromOffset(0, 30),
\t\tAutomaticSize = Enum.AutomaticSize.X,
\t\tBackgroundColor3 = Color3.fromRGB(31, 36, 49),
\t\tBackgroundTransparency = 0.05,
\t\tBorderSizePixel = 0,
\t\tFont = Enum.Font.GothamMedium,
\t\tText = "  " .. text .. "  ",
\t\tTextColor3 = COLORS.Text,
\t\tTextSize = 11,
\t\tTextTransparency = 1,
\t\tVisible = false,
\t\tZIndex = 30,
\t\tParent = button,
\t})
\taddCorner(tooltip, 8)
\taddStroke(tooltip, COLORS.Stroke, 0.25, 1)

\tbutton.MouseEnter:Connect(function()
\t\ttooltip.Visible = true
\t\ttween(tooltip, {TextTransparency = 0}, 0.12)
\tend)

\tbutton.MouseLeave:Connect(function()
\t\ttween(tooltip, {TextTransparency = 1}, 0.1)
\t\ttask.delay(0.1, function()
\t\t\tif tooltip and tooltip.Parent then
\t\t\t\ttooltip.Visible = false
\t\t\tend
\t\tend)
\tend)
end

