\t\tvalue = math.floor(minValue + (maxValue - minValue) * newPercent + 0.5)
\t\tfill.Size = UDim2.new(newPercent, 0, 1, 0)
\t\tthumb.Position = UDim2.new(newPercent, 0, 0.5, 0)
\t\tvalueLabel.Text = tostring(value) .. (suffix or "")

\t\tif callback then
\t\t\tcallback(value)
\t\tend
\tend

\ttrack.InputBegan:Connect(function(input)
\t\tif input.UserInputType == Enum.UserInputType.MouseButton1
\t\t\tor input.UserInputType == Enum.UserInputType.Touch then
\t\t\tdragging = true
\t\t\tsetValueFromPosition(input.Position.X)
\t\tend
\tend)

\tUserInputService.InputChanged:Connect(function(input)
\t\tif dragging and (
\t\t\tinput.UserInputType == Enum.UserInputType.MouseMovement
\t\t\tor input.UserInputType == Enum.UserInputType.Touch
\t\t) then
\t\t\tsetValueFromPosition(input.Position.X)
\t\tend
\tend)

\tUserInputService.InputEnded:Connect(function(input)
\t\tif input.UserInputType == Enum.UserInputType.MouseButton1
\t\t\tor input.UserInputType == Enum.UserInputType.Touch then
\t\t\tdragging = false
\t\tend
\tend)

\treturn frame
end

