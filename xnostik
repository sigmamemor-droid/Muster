        ensureWindowRect()
        Hub.Size = UDim2.fromOffset(windowSize.X, 0)
        HubShadow.Size = UDim2.fromOffset(windowSize.X, 0)
        TweenService:Create(Hub, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(windowSize.X, windowSize.Y)}):Play()
        TweenService:Create(HubShadow, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(windowSize.X, windowSize.Y)}):Play()
    else
        local tw = TweenService:Create(Hub, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(windowSize.X, 0)})
        tw:Play()
        TweenService:Create(HubShadow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(windowSize.X, 0)}):Play()
        tw.Completed:Connect(function()
            if not hubOpen then
                Hub.Visible = false
                HubShadow.Visible = false
                Hub.Size = UDim2.fromOffset(windowSize.X, windowSize.Y)
                HubShadow.Size = UDim2.fromOffset(windowSize.X, windowSize.Y)
            end
        end)
    end
end

UserInputService.InputEnded:Connect(function(input)
    if toggleDrag and (input == toggleDrag.input or input.UserInputType == Enum.UserInputType.MouseButton1) then
        local moved = toggleDrag.moved
        toggleDrag = nil
        if not moved then ToggleHub() end
    end
end)

ClB.MouseButton1Click:Connect(function() if hubOpen then ToggleHub() end end)
