\tif not floatDragging or input ~= floatStartInput then
\t\treturn
\tend

\tfloatDragging = false
\tfloatStartInput = nil

\tlocal camera = workspace.CurrentCamera
\tif camera then
\t\tlocal viewport = camera.ViewportSize
\t\tlocal x = math.clamp(floatingButton.AbsolutePosition.X, 8, viewport.X - floatingButton.AbsoluteSize.X - 8)
\t\tlocal y = math.clamp(floatingButton.AbsolutePosition.Y, 8, viewport.Y - floatingButton.AbsoluteSize.Y - 8)
