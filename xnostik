                and UDim2.new(1, -16, 0.5, -7)
                or  UDim2.new(0, 2, 0.5, -7)
        }):Play()
        if callback then pcall(callback, state) end
    end

    switchTrack.MouseButton1Click:Connect(toggle)
    return frame, toggle
end

