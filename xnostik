-- Global input changed: move toggle button if dragging
Track(UserInputService.InputChanged:Connect(function(input)
    if not toggleDrag then return end
    if not IsDragInput(input, toggleDrag.input) then return end
    local delta = input.Position - toggleDrag.start
    if delta.Magnitude > 7 then toggleDrag.moved = true end
    local viewport = ScreenGui.AbsoluteSize
    local x = math.clamp(
        toggleDrag.position.X.Offset + delta.X,
        8,
        math.max(8, viewport.X - ToggleBtn.AbsoluteSize.X - 8)
    )
    local y = math.clamp(
        toggleDrag.position.Y.Offset + delta.Y,
        8,
        math.max(8, viewport.Y - ToggleBtn.AbsoluteSize.Y - 8)
    )
    ToggleBtn.Position = UDim2.fromOffset(x, y)
end))

