function UI:SelectPage(id: string)
\tif not pages[id] then
\t\treturn
\tend

\tselectedPage = id

\tfor pageId, page in pairs(pages) do
\t\tpage.Visible = pageId == id
\tend

\tfor pageId, button in pairs(tabButtons) do
\t\tlocal active = pageId == id
\t\tlocal indicator = button:FindFirstChild("Indicator") :: Frame?
\t\tlocal label = button:FindFirstChild("Label") :: TextLabel?
\t\tlocal icon = button:FindFirstChild("Icon") :: TextLabel?

\t\ttween(button, tweenFast, {
\t\t\tBackgroundColor3 = active and Theme.SurfaceHover or Theme.Sidebar,
\t\t})

\t\tif indicator then
\t\t\tindicator.Visible = active
\t\tend

\t\tif label then
\t\t\tlabel.TextColor3 = active and Theme.Text or Theme.TextMuted
\t\tend

\t\tif icon then
\t\t\ticon.TextColor3 = active and Theme.AccentSoft or Theme.TextDim
\t\tend
\tend
end

