local function autoSizeScroll(scrollFrame, colLeft, colRight, listL, listR)
    local function updateCanvas()
        local leftY  = listL.AbsoluteContentSize.Y
        local rightY = listR.AbsoluteContentSize.Y
        colLeft.Size  = UDim2.new(0.48, 0, 0, leftY)
        colRight.Size = UDim2.new(0.48, 0, 0, rightY)
        -- Padding top + bottom = 40
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(leftY, rightY) + 40)
    end
    updateCanvas()
    Track(listL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas))
    Track(listR:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas))
end

