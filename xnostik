function UI.AddSlider(page, titleText, minVal, maxVal, defaultVal, prefix, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 44)
    frame.BackgroundColor3 = C.card
    frame.ZIndex = 13
    frame.Parent = page
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14) -- Гладкий угол

    prefix = prefix or "x"

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0.7, 0, 0, 18)
    title.Position = UDim2.new(0, 12, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = C.text
    title.TextSize = 11
    title.Font = Enum.Font.GothamMedium
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 14
    title.Parent = frame

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.3, 0, 0, 18)
    valLabel.Position = UDim2.new(0.7, -12, 0, 6)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = prefix .. tostring(defaultVal)
    valLabel.TextColor3 = C.text
    valLabel.TextSize = 11
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.ZIndex = 14
    valLabel.Parent = frame

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 30)
    track.BackgroundColor3 = C.switchOff
    track.Text = ""
    track.AutoButtonColor = false
    track.ZIndex = 14
    track.Parent = frame
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local pct = (defaultVal - minVal) / (maxVal - minVal)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = C.accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 15
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 12, 0, 12)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.new(pct, 0, 0.5, 0)
    thumb.BackgroundColor3 = C.white
    thumb.BorderSizePixel = 0
    thumb.ZIndex = 16
    thumb.Parent = track
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local currentVal = defaultVal
    local function update(input)
        local delta = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * delta)
        if val ~= currentVal then
            currentVal = val
            fill.Size = UDim2.new(delta, 0, 1, 0)
            thumb.Position = UDim2.new(delta, 0, 0.5, 0)
            valLabel.Text = prefix .. tostring(val)
            SafeCallback(callback, val)
        end
    end

    Track(track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = {update = update}
            update(input)
        end
    end))
end

function UI.AddButton(page, titleText, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = C.card
