local visualState = {
\tenabled = false,
\thighlight = nil :: Highlight?,
\tlight = nil :: PointLight?,
}

local function clearVisualEffect()
\tif visualState.highlight then
\t\tvisualState.highlight:Destroy()
\t\tvisualState.highlight = nil
\tend

\tif visualState.light then
\t\tvisualState.light:Destroy()
\t\tvisualState.light = nil
\tend
end

local function applyVisualEffect()
\tclearVisualEffect()

\tif not visualState.enabled then
\t\treturn
\tend

\tlocal character = player.Character
\tif not character then
\t\treturn
\tend

\tlocal root = character:FindFirstChild("HumanoidRootPart")
\tif not root then
\t\treturn
\tend

\tlocal highlight = create("Highlight", {
\t\tName = "AuroraLocalHighlight",
\t\tAdornee = character,
\t\tFillColor = Theme.Accent,
\t\tOutlineColor = Theme.AccentSoft,
\t\tFillTransparency = 0.8,
\t\tOutlineTransparency = 0.15,
\t\tDepthMode = Enum.HighlightDepthMode.Occluded,
\t\tParent = character,
\t})

\tlocal light = create("PointLight", {
\t\tName = "AuroraLocalLight",
\t\tColor = Theme.AccentSoft,
\t\tBrightness = 1.5,
\t\tRange = 9,
\t\tShadows = false,
\t\tParent = root,
\t})

\tvisualState.highlight = highlight
\tvisualState.light = light
end

player.CharacterAdded:Connect(function()
\ttask.wait(0.4)
\tapplyVisualEffect()
end)

