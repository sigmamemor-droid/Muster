local tabs = {}
local pages = {}
local pageData = {}

local function SelectTab(tabId)
    for id, page in pairs(pages) do
        page.Visible = (id == tabId)
    end
    for id, btn in pairs(tabs) do
        local isSelected = (id == tabId)
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = isSelected and C.accent or Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = isSelected and 0 or 1
        }):Play()
        
        local label = btn:FindFirstChild("TabLabel")
        local icon = btn:FindFirstChild("TabIcon")
        if label then 
            TweenService:Create(label, TweenInfo.new(0.2), {TextColor3 = isSelected and C.white or C.textSec}):Play() 
        end
        if icon then 
            TweenService:Create(icon, TweenInfo.new(0.2), {TextColor3 = isSelected and C.white or C.textSec}):Play() 
        end
    end
end

