-- Адаптивное масштабирование
local HubScale = Create("UIScale", { Parent = Main })
local cameraConnection

local function UpdateHubScale()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local vp = camera.ViewportSize
    local fit = math.min((vp.X - 20) / HUB_W, (vp.Y - 30) / HUB_H, 1)
    HubScale.Scale = math.clamp(fit, 0.6, 1)
end

local function BindHubViewport()
    if cameraConnection then cameraConnection:Disconnect() end
    local camera = workspace.CurrentCamera
    if camera then
        cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateHubScale)
        maid:Give(cameraConnection)
    end
    UpdateHubScale()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(BindHubViewport)
BindHubViewport()

