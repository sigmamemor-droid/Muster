local function getScale()
\tlocal camera = workspace.CurrentCamera
\tif not camera then
\t\treturn 1
\tend

\tlocal viewport = camera.ViewportSize
\treturn math.clamp(math.min((viewport.X - 24) / 540, (viewport.Y - 30) / 360, 1), 0.62, 1)
end

