    local p=accentPalettes[chosenAccent]
    AppC.accent,AppC.accentLight,AppC.selectedSurface=p.accent,p.accentLight,p.selectedSurface
    if amoledEnabled then AppC.bg=Color3.fromRGB(0,0,0);AppC.sidebar=Color3.fromRGB(0,0,0);AppC.surface=Color3.fromRGB(5,5,5);AppC.elevated=Color3.fromRGB(12,12,12);AppC.border=Color3.fromRGB(43,43,43);AppC.hover=Color3.fromRGB(22,22,22) else AppC.bg=Color3.fromRGB(13,16,28);AppC.sidebar=Color3.fromRGB(10,13,24);AppC.surface=Color3.fromRGB(24,29,46);AppC.elevated=Color3.fromRGB(34,41,63);AppC.border=Color3.fromRGB(72,84,116);AppC.hover=Color3.fromRGB(48,57,85) end
    -- Gradients follow the selected palette, including a restrained true-black AMOLED appearance.
    HubGradient.Color = ColorSequence.new(amoledEnabled and Color3.fromRGB(8,8,10) or AppC.elevated, AppC.bg)
    TopGradient.Color = ColorSequence.new(amoledEnabled and Color3.fromRGB(12,12,14) or AppC.selectedSurface, AppC.surface)
    SideGradient.Color = ColorSequence.new(amoledEnabled and Color3.fromRGB(6,6,7) or AppC.hover, AppC.sidebar)
    InnerGlow.BackgroundColor3 = AppC.accent
    InnerGlow.BackgroundTransparency = amoledEnabled and 0.97 or 0.94
    for _,o in ipairs(ScreenGui:GetDescendants()) do
        local r=o:GetAttribute("ThemeBackground");if r and AppC[r] and o:IsA("GuiObject") then o.BackgroundColor3=AppC[r] end
        r=o:GetAttribute("ThemeText");if r and AppC[r] and (o:IsA("TextLabel") or o:IsA("TextButton")) then o.TextColor3=AppC[r] end
        r=o:GetAttribute("ThemeStroke");if r and AppC[r] and o:IsA("UIStroke") then o.Color=AppC[r] end
    end
    local dotColors={Violet=Color3.fromRGB(112,128,255),Blue=Color3.fromRGB(53,151,255),Red=Color3.fromRGB(255,86,128),Green=Color3.fromRGB(45,211,145)}
    for name,b in pairs(accentButtons) do
        b.BackgroundColor3=dotColors[name]
        local selection = b:FindFirstChild("Selection")
        if selection then selection.Transparency=(name==chosenAccent and 0 or 1) end
    end
    if amoledFill then amoledFill.BackgroundColor3=amoledEnabled and AppC.accent or AppC.elevated end
    if amoledKnob then
        amoledKnob.BackgroundColor3=amoledEnabled and AppC.white or AppC.textSec
        TweenService:Create(amoledKnob,TweenInfo.new(0.16),{Position=UDim2.new(0,amoledEnabled and 29 or 3,0.5,-9)}):Play()
    end
end
local function applyLanguage()
    local t=lang[language]
    for _,def in ipairs(tabDefs) do
        def.title=t[def.name]
        local b=tabButtons[def.name]; b.Text=compactMode and def.icon or ("   "..def.icon.."    "..def.title)
    end
    local d
    for _,v in ipairs(tabDefs) do if v.name==currentTab then d=v break end end
    if d then PageTitle.Text=d.title end
    for key,label in pairs(settingsLabels) do label.Text=t[key] end
    for key,b in pairs(langButtons) do
        local selected = (key == language)
        b.TextColor3 = selected and AppC.accentLight or AppC.textSec
        b.BackgroundColor3 = selected and AppC.selectedSurface or AppC.elevated
        local stroke = b:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = selected and AppC.accentLight or AppC.border
            stroke.Transparency = selected and 0.15 or 0.55
        end
    end
end
