local function LaunchUI()
    TweenService:Create(TitleLabel, TweenInfo.new(1.2), {
        TextTransparency = 0,
        Position = UDim2.new(0, 0, 0.5, -100)
    }):Play()
    
    TweenService:Create(SubtitleLabel, TweenInfo.new(1.2), {
        TextTransparency = 0.3,
        Position = UDim2.new(0, 0, 0.5, -40)
    }):Play()
    
    TweenService:Create(ProgressBg, TweenInfo.new(0.5), {
        BackgroundTransparency = 0
    }):Play()
    
    local steps = {0.15, 0.35, 0.55, 0.75, 0.90, 1.00}
    for _, step in ipairs(steps) do
        TweenService:Create(ProgressFill, TweenInfo.new(0.2), {
            Size = UDim2.new(step, 0, 1, 0)
        }):Play()
        task.wait(0.25)
    end
    
    task.wait(0.3)
    
    TweenService:Create(LoadingScreen, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(TitleLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    TweenService:Create(SubtitleLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    TweenService:Create(ProgressBg, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
    
    task.wait(0.5)
    LoadingScreen:Destroy()
end
task.spawn(LaunchUI)

