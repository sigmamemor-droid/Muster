    ToggleClick.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            toggleDrag = {input = input, start = input.Position, position = ToggleBtn.Position, moved = false}
