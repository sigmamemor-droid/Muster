		Size = UDim2.new(0, 3, 0, 0),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = CONFIG.Theme.Accent,
		BorderSizePixel = 0,
		Parent = tabBtn,
	})
	corner(2, indicator)

	create("TextLabel", {
		Size = UDim2.new(0, 22, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		Text = data.icon,
		TextColor3 = CONFIG.Theme.TextSecondary,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		Parent = tabBtn,
	})

	local label = create("TextLabel", {
		Size = UDim2.new(1, -38, 1, 0),
		Position = UDim2.new(0, 32, 0, 0),
		BackgroundTransparency = 1,
		Text = data.label,
		TextColor3 = CONFIG.Theme.TextSecondary,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = tabBtn,
	})

	local container = create("Frame", {
		Name = "Content_" .. data.id,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = content,
	})
	data.content(container)

	tabBtn.MouseButton1Click:Connect(function()
		if activeTab == data.id then return end
		for _, t in ipairs(tabs) do
			if t.id == activeTab then
				tween(t.btn, { BackgroundColor3 = CONFIG.Theme.Sidebar }, 0.2):Play()
				tween(t.indicator, { Size = UDim2.new(0, 3, 0, 0) }, 0.2):Play()
				t.label.TextColor3 = CONFIG.Theme.TextSecondary
				t.container.Visible = false
			end
		end
		activeTab = data.id
		tween(tabBtn, { BackgroundColor3 = CONFIG.Theme.Card }, 0.2):Play()
		tween(indicator, { Size = UDim2.new(0, 3, 0, 16) }, 0.2):Play()
		label.TextColor3 = CONFIG.Theme.TextPrimary
		container.Visible = true
	end)

	table.insert(tabs, { id = data.id, btn = tabBtn, indicator = indicator, label = label, container = container })
end

