            tween(toggleButton, {BackgroundColor3 = Config.Theme.ToggleOn}, 0.2)
            tween(toggleKnob, {Position = UDim2.new(1, -20, 0.5, -9)}, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
