local menuVisible = true
local isAnimating = false

local function setMenuVisible(value, instant)
\tif isAnimating or menuVisible == value then
\t\treturn
\tend

\tmenuVisible = value
\tisAnimating = true

\tif value then
\t\tmain.Visible = true
\t\tshadow.Visible = true
\t\toverlay.Visible = true

\t\tmain.Position = UDim2.new(0.5, 0, 0.5, 18)
\t\tshadow.Position = main.Position
\t\tscale.Scale = 0.96

\t\ttween(overlay, {
\t\t\tBackgroundTransparency = state.backgroundOverlay == false and 1 or 0.55,
\t\t}, instant and 0 or 0.16)

\t\ttween(main, {
\t\t\tPosition = UDim2.fromScale(0.5, 0.5),
\t\t}, instant and 0 or 0.22)

\t\ttween(shadow, {
\t\t\tPosition = UDim2.fromScale(0.5, 0.5),
\t\t}, instant and 0 or 0.22)

\t\tlocal scaleTween = tween(scale, {
\t\t\tScale = 1,
\t\t}, instant and 0 or 0.22)

\t\tscaleTween.Completed:Once(function()
\t\t\tisAnimating = false
\t\tend)
\telse
\t\ttween(overlay, {
\t\t\tBackgroundTransparency = 1,
\t\t}, 0.14)

\t\ttween(main, {
\t\t\tPosition = UDim2.new(
\t\t\t\tmain.Position.X.Scale,
\t\t\t\tmain.Position.X.Offset,
\t\t\t\tmain.Position.Y.Scale,
\t\t\t\tmain.Position.Y.Offset + 18
\t\t\t),
\t\t}, 0.14)

\t\ttween(shadow, {
\t\t\tPosition = UDim2.new(
\t\t\t\tshadow.Position.X.Scale,
\t\t\t\tshadow.Position.X.Offset,
\t\t\t\tshadow.Position.Y.Scale,
\t\t\t\tshadow.Position.Y.Offset + 18
\t\t\t),
\t\t}, 0.14)

\t\tlocal scaleTween = tween(scale, {
\t\t\tScale = 0.96,
\t\t}, 0.14)

\t\tscaleTween.Completed:Once(function()
\t\t\tmain.Visible = false
\t\t\tshadow.Visible = false
\t\t\toverlay.Visible = false
\t\t\tisAnimating = false
\t\tend)
\tend
end

