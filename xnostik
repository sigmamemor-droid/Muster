function PlayerFeatures.toggleFly(enabled)
    local char = getCharacter(LocalPlayer)
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if enabled then
        PlayerFeatures.FlyVelocity = Instance.new("BodyVelocity")
        PlayerFeatures.FlyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        PlayerFeatures.FlyVelocity.Velocity = Vector3.new(0, 0, 0)
        PlayerFeatures.FlyVelocity.Parent = root

        local flyDirection = Vector3.new(0, 0, 0)

        PlayerFeatures.FlyConnection = RunService.RenderStepped:Connect(function()
            if not root or not root.Parent then
                PlayerFeatures.toggleFly(false)
                return
            end

            local camCFrame = Camera.CFrame
            local moveVector = Vector3.new(0, 0, 0)

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveVector = moveVector + camCFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveVector = moveVector - camCFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveVector = moveVector - camCFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveVector = moveVector + camCFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveVector = moveVector + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveVector = moveVector - Vector3.new(0, 1, 0)
            end

            if moveVector.Magnitude > 0 then
                moveVector = moveVector.Unit
            end

            PlayerFeatures.FlyVelocity.Velocity = moveVector * Config.Player.FlySpeed
        end)
        notify("Fly", "Enabled - Use WASD + Space/Shift", 3)
    else
        if PlayerFeatures.FlyConnection then
            PlayerFeatures.FlyConnection:Disconnect()
            PlayerFeatures.FlyConnection = nil
        end
        if PlayerFeatures.FlyVelocity then
            PlayerFeatures.FlyVelocity:Destroy()
            PlayerFeatures.FlyVelocity = nil
        end
        notify("Fly", "Disabled", 2)
    end
end

