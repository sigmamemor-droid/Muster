        ToggleBtn.Position = UDim2.fromOffset(toggleDrag.position.X.Offset + delta.X, toggleDrag.position.Y.Offset + delta.Y)
    end)
    UserInputService.InputEnded:Connect(function(input)
        if toggleDrag and input == toggleDrag.input then
            toggleSuppressClick = toggleDrag.moved
            toggleDrag = nil
        end
    end)
end

