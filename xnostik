-- ===== Перетаскивание =====

local dragging = false
local dragStart
local startPosition

local function clampPosition(position)
\tlocal viewport = workspace.CurrentCamera.ViewportSize
\tlocal menuSize = main.AbsoluteSize

\tlocal minX = -menuSize.X * 0.35
\tlocal maxX = viewport.X - menuSize.X * 0.65
\tlocal minY = -menuSize.Y * 0.1
\tlocal maxY = viewport.Y - menuSize.Y * 0.65

\treturn UDim2.fromOffset(
\t\tmath.clamp(position.X.Offset, minX, maxX),
\t\tmath.clamp(position.Y.Offset, minY, maxY)
\t)
end

local function updateDrag(input)
\tif not dragStart or not startPosition then
\t\treturn
\tend

\tlocal delta = input.Position - dragStart

\tlocal nextPosition = UDim2.new(
\t\tstartPosition.X.Scale,
\t\tstartPosition.X.Offset + delta.X,
\t\tstartPosition.Y.Scale,
\t\tstartPosition.Y.Offset + delta.Y
\t)

\tmain.Position = clampPosition(nextPosition)
\tshadow.Position = main.Position
end

topbar.InputBegan:Connect(function(input)
\tlocal isPointer = input.UserInputType == Enum.UserInputType.MouseButton1
\t\tor input.UserInputType == Enum.UserInputType.Touch

\tif not isPointer then
\t\treturn
\tend

\tdragging = true
\tdragStart = input.Position
\tstartPosition = main.Position

\tinput.Changed:Connect(function()
\t\tif input.UserInputState == Enum.UserInputState.End then
\t\t\tdragging = false
\t\tend
\tend)
end)

UserInputService.InputChanged:Connect(function(input)
\tlocal isMoving = input.UserInputType == Enum.UserInputType.MouseMovement
\t\tor input.UserInputType == Enum.UserInputType.Touch

\tif dragging and isMoving then
\t\tupdateDrag(input)
\tend
end)

