-- Анимация кубов (через TweenService)
local cubeAnimations = {}
local function animateCube(idx, delay)
    local data = cubes[idx]
    local cube = data.cube
    local x = cubePositions[idx].x
    local y = cubePositions[idx].y
    
    -- Анимация движения и масштаба
    local function runCycle()
        -- Движение к центру
        TweenService:Create(cube, TweenInfo.new(0.5 + delay, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            Position = UDim2.new(0.5, -24, 0.5, -24)
        }):Play()
        TweenService:Create(cube, TweenInfo.new(0.5 + delay, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            BackgroundTransparency = 0.2
        }):Play()
        
        task.wait(0.5 + delay)
        
        -- Задержка и подскок
        task.wait(0.4)
        TweenService:Create(cube, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            Position = UDim2.new(0.5, -24, 0.4, -24)
        }):Play()
        
        task.wait(0.3)
        
        -- Возврат в исходную позицию
        TweenService:Create(cube, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            Position = UDim2.new(0.29 + cubePositions[idx].lx/1000, 0, 0.34 + cubePositions[idx].ly/1000, 0)
        }):Play()
        TweenService:Create(cube, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            BackgroundTransparency = 0.8
        }):Play()
        
        task.wait(0.8)
    end
    
    -- Бесконечный цикл
    task.spawn(function()
        while LS.Parent do
            runCycle()
        end
    end)
end

