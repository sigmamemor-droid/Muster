-- ─── Safe Element Creator ──────────────────────
local function create(class, props)
	local inst = Instance.new(class)
	local parent = nil
	if props then
		parent = props.Parent
		props.Parent = nil
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(radius, parent)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or CONFIG.CornerRadius), Parent = parent })
end

local function stroke(color, thickness, parent)
	return create("UIStroke", {
		Color = color or CONFIG.Theme.Border,
		Thickness = thickness or 1,
		Parent = parent,
	})
end

local function tween(obj, props, duration, style)
	return TweenService:Create(obj, TweenInfo.new(duration or CONFIG.AnimDuration, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
end

