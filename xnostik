end

local function selectPage(id)
\tfor pageId, page in pairs(pages) do
\t\tpage.Visible = pageId == id
\tend

\tfor tabId, data in pairs(tabs) do
\t\tlocal selected = tabId == id
\t\ttween(data.button, 0.14, {
\t\t\tBackgroundColor3 = selected and C.card or C.panel,
\t\t})
\t\ttween(data.indicator, 0.14, {
\t\t\tBackgroundTransparency = selected and 0 or 1,
\t\t})
\t\tdata.icon.TextColor3 = selected and C.accent or C.subtext
\t\tdata.label.TextColor3 = selected and C.text or C.subtext
\tend
end

