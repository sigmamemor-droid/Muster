local AimbotSystem = {}
AimbotSystem.Target = nil
AimbotSystem.FOVCircle = nil

function AimbotSystem.init()
    AimbotSystem.FOVCircle = createDrawing("Circle", {
        Radius = Config.Aimbot.FOV,
        Color = Config.Aimbot.FOVColor,
        Thickness = 1,
        Filled = false,
        Visible = false,
    })
end

function AimbotSystem.getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = Config.Aimbot.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local targetPart = player.Character:FindFirstChild(Config.Aimbot.TargetPart)
            if targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local viewportSize = Camera.ViewportSize
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)).Magnitude
                    
                    if distance < shortestDistance then
                        -- Check if target is the murderer (for sheriff aimbot)
                        if Config.Aimbot.OnlySheriff then
                            local role = getRole(player)
                            if role == "Murderer" then
                                shortestDistance = distance
                                closestPlayer = player
                            end
                        else
                            shortestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

function AimbotSystem.update()
    AimbotSystem.FOVCircle.Radius = Config.Aimbot.FOV
    AimbotSystem.FOVCircle.Color = Config.Aimbot.FOVColor
    AimbotSystem.FOVCircle.Visible = Config.Aimbot.ShowFOV
    
    local viewportSize = Camera.ViewportSize
    AimbotSystem.FOVCircle.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    if not Config.Aimbot.Enabled then
        AimbotSystem.Target = nil
        return
    end

    -- Check if local player has a gun (sheriff)
    local hasGun = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun") or
                   LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun")

    if Config.Aimbot.OnlySheriff and not hasGun then
        return
    end

    AimbotSystem.Target = AimbotSystem.getClosestPlayer()

    if AimbotSystem.Target then
        local targetPart = AimbotSystem.Target.Character:FindFirstChild(Config.Aimbot.TargetPart)
        if targetPart then
            local targetPos = targetPart.Position
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
            local smoothedCFrame = currentCFrame:Lerp(targetCFrame, Config.Aimbot.Smoothing)
            Camera.CFrame = smoothedCFrame
        end
    end
end

AimbotSystem.init()

RunService.RenderStepped:Connect(function()
    AimbotSystem.update()
end)

